---
/**
 * /blog/ — an index for the 48 SEO articles migrated from WordPress.
 *
 * These articles rank on Rwanda-specific queries but had no index page on the
 * live site: they were reachable only from search results and from each other.
 * Giving them a hub adds an internal link path to every one of them and lets
 * each article link back to the commercial pages it supports.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { heroScenes } from '../data/hero-scenes';
import Section from '../components/Section.astro';
import CTA from '../components/CTA.astro';
import { getCollection } from 'astro:content';
import { routes } from '../data/navigation';
import { breadcrumbSchema } from '../data/schema';
import { useTranslations, localizePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const b = t.companyPages.blog;
const site = Astro.site ?? new URL('https://primetrack.rw');
const url = new URL(localizePath(routes.blog, locale), site).href;

/* On the Kinyarwanda index each article is its Kinyarwanda version where one
   exists; one that has not been translated yet is listed in English, linking
   to the English URL and marked lang="en", rather than left out. */
const translations = new Map(
  locale === 'rw' ? (await getCollection('articlesRw')).map((a) => [a.id, a] as const) : [],
);
const articles = (await getCollection('articles'))
  .map((english) => {
    const own = translations.get(english.id);
    return own
      ? { id: own.id, data: own.data, href: localizePath(`/${own.id}/`, locale), lang: undefined }
      : { id: english.id, data: english.data, href: `/${english.id}/`, lang: locale === 'en' ? undefined : 'en' };
  })
  .sort((a, c) => {
    const da = a.data.date?.getTime() ?? 0;
    const dc = c.data.date?.getTime() ?? 0;
    return dc - da;
  });

const dateFormat = new Intl.DateTimeFormat(locale === 'rw' ? 'rw-RW' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  locale={locale}
  path={routes.blog}
  title={t.seo.blog.title}
  description={t.seo.blog.description}
  schemas={[
    breadcrumbSchema([
      { name: t.common.common.home, url: new URL(localizePath(routes.home, locale), site).href },
      { name: b.title, url },
    ]),
  ]}
>
  <PageHero scene={heroScenes.quiet} locale={locale} eyebrow={b.eyebrow} title={b.title} lead={b.lead} crumbs={[{ name: b.title, href: routes.blog }]} />

  <Section tone="light">
    <ul class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        articles.map((article) => (
          <li class="reveal group relative flex flex-col border-t border-ink-200 pt-5" lang={article.lang}>
            {article.data.date && (
              <time datetime={article.data.date.toISOString().slice(0, 10)} class="text-[0.8125rem] font-semibold uppercase tracking-wider text-ink-400">
                {dateFormat.format(article.data.date)}
              </time>
            )}
            <h2 class="mt-2 text-h4 leading-snug">
              <a href={article.href} class="after:absolute after:inset-0 after:content-[''] group-hover:text-prime-700">
                {article.data.title}
              </a>
            </h2>
            <p class="mt-2.5 line-clamp-3 text-[0.9375rem] leading-relaxed text-ink-600">{article.data.description}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <CTA locale={locale} title={t.home.finalCta.title} body={t.home.finalCta.body} />
</BaseLayout>
