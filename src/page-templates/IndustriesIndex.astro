---
/**
 * /industries/ — the eight verticals as a hub.
 *
 * Reuses the homepage's wall so the two stay identical in look and in code.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { heroScenes } from '../data/hero-scenes';
import Section from '../components/Section.astro';
import IndustryIndex from '../components/IndustryIndex.astro';
import CTA from '../components/CTA.astro';
import { routes } from '../data/navigation';
import { breadcrumbSchema } from '../data/schema';
import { useTranslations, localizePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL('https://primetrack.rw');
const url = new URL(localizePath(routes.industries, locale), site).href;
---

<BaseLayout
  locale={locale}
  path={routes.industries}
  title={t.seo.industriesIndex.title}
  description={t.seo.industriesIndex.description}
  schemas={[
    breadcrumbSchema([
      { name: t.common.common.home, url: new URL(localizePath(routes.home, locale), site).href },
      { name: t.industries.index.eyebrow, url },
    ]),
  ]}
>
  <PageHero
    scene={heroScenes.industries}
    locale={locale}
    eyebrow={t.industries.index.eyebrow}
    title={t.industries.index.pageTitle}
    lead={t.industries.index.pageLead}
    crumbs={[{ name: t.industries.index.eyebrow, href: routes.industries }]}
  />

  <Section tone="light">
    <IndustryIndex locale={locale} map={false} />
  </Section>

  <CTA locale={locale} title={t.home.finalCta.title} body={t.home.finalCta.body} />
</BaseLayout>
