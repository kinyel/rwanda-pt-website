---
/**
 * A single migrated SEO article, rendered at its original WordPress URL so no
 * ranking page moves, and its Kinyarwanda version at /rw/<same slug>/.
 *
 * Every article closes with links into the commercial pages, which is the job
 * these articles are meant to do and which the WordPress versions never did.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeroScene from '../components/PageHeroScene.astro';
import { heroScenes } from '../data/hero-scenes';
import Section from '../components/Section.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import CTA from '../components/CTA.astro';
import { routes } from '../data/navigation';
import { articleSchema, breadcrumbSchema } from '../data/schema';
import { useTranslations, localizePath, type Locale } from '../i18n';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  locale: Locale;
  article: CollectionEntry<'articles'> | CollectionEntry<'articlesRw'>;
  related: { href: string; titleKey: string; descriptorKey?: string }[];
  /**
   * Whether this article exists in both languages. If it does, the page
   * advertises both versions with hreflang and the language switcher goes
   * straight to the other one; if not, it stays single-language and the
   * switcher points at the other language's blog index.
   */
  translated?: boolean;
}

const { locale, article, related, translated = false } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL('https://primetrack.rw');
const path = `/${article.id}/`;
const url = new URL(localizePath(path, locale), site).href;

const { Content } = await render(article);

/* Formatted at build time, in Node, whose locale data has Kinyarwanda month
   names ("2025 Werurwe 2"); the browser's would not. */
const dateFormat = new Intl.DateTimeFormat(locale === 'rw' ? 'rw-RW' : 'en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

/* Migrated article headlines are long. The brand suffix is only worth the
   characters when the result still fits a results page; past that it is the
   first thing to lose. */
const SUFFIX = ' | PrimeTrack Rwanda';
const pageTitle =
  article.data.title.length + SUFFIX.length <= 65 ? `${article.data.title}${SUFFIX}` : article.data.title;
---

<BaseLayout
  locale={locale}
  path={path}
  title={pageTitle}
  description={article.data.description}
  singleLocale={!translated}
  switcherFallback={translated ? undefined : routes.blog}
  schemas={[
    articleSchema({
      headline: article.data.title,
      description: article.data.description,
      url,
      datePublished: article.data.date?.toISOString(),
    }),
    breadcrumbSchema([
      { name: t.common.common.home, url: new URL(localizePath(routes.home, locale), site).href },
      { name: t.companyPages.blog.eyebrow, url: new URL(localizePath(routes.blog, locale), site).href },
      { name: article.data.title, url },
    ]),
  ]}
>
  <article>
    <header data-nav="dark" class="on-dark relative overflow-hidden bg-ink-950 bg-contour-prime">
      <div class="absolute inset-0 bg-prime-glow" aria-hidden="true"></div>

      <!-- THE ONE FAMILY THAT CANNOT TAKE A SIDE COLUMN.

           Every other inner page puts its scene in a second grid column
           beside the copy. These headlines run to 137 characters and the
           h1 is deliberately given 76ch to do it in; at 58% of the width
           the longest of them wrap to six lines, and a decorative object
           that costs a reader two extra lines of headline is a worse page,
           not a better one.

           So it sits in the gutter the measure already leaves, absolutely
           positioned and therefore costing no height at all, and it is
           pushed further out and turned down on a phone rather than
           removed. Same landscape, same camera as the other reading
           pages, out of the way of the only thing anyone came here for. -->
      <div class="article-scene" aria-hidden="true">
        <PageHeroScene kind={heroScenes.quiet} />
      </div>
      <div class="container-prime relative py-14 sm:py-16">
        <Breadcrumbs
          locale={locale}
          crumbs={[{ name: t.companyPages.blog.eyebrow, href: routes.blog }, { name: article.data.title, href: path }]}
          tone="dark"
          class="mb-7"
        />
        <h1 class="measure-wide text-display text-white">{article.data.title}</h1>
        <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.875rem] text-ink-400">
          <span>{t.common.common.by} {article.data.author}</span>
          {
            article.data.date && (
              <>
                <span aria-hidden="true">·</span>
                <time datetime={article.data.date.toISOString().slice(0, 10)}>{dateFormat.format(article.data.date)}</time>
              </>
            )
          }
        </p>
      </div>
    </header>

    <Section tone="light">
      <div class="prose-prime">
        <Content />
      </div>
    </Section>
  </article>

  <RelatedLinks locale={locale} items={related} />

  <CTA locale={locale} title={t.home.finalCta.title} body={t.home.finalCta.body} />
</BaseLayout>

<style>
  /* Clear of a 76ch measure at desktop, and tucked into the top-right
     corner behind the copy on a phone, where the measure takes the whole
     column. The header clips, so nothing can escape it either way. */
  /* On a phone the headline takes the whole column, so there is no gutter
     to sit in: the scene goes to the bottom-right corner beside the
     byline, mostly past the edge, and turned down. Behind the dateline
     rather than behind the title, which is the difference between a
     texture and an obstruction. */
  .article-scene {
    position: absolute;
    right: -7rem;
    bottom: -2.5rem;
    width: 16rem;
    opacity: 0.4;
  }

  /* From lg the measure leaves real room on the right, so it comes out of
     the corner, up to full strength, and reads as an object beside the
     headline rather than a watermark under it. */
  @media (width >= 64rem) {
    .article-scene {
      top: 50%;
      right: -2rem;
      bottom: auto;
      width: 24rem;
      transform: translateY(-50%);
      opacity: 0.85;
    }
  }
</style>
