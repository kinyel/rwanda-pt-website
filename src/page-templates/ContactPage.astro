---
/**
 * Contact page.
 *
 * The form is one route to us, not the only one. WhatsApp is given equal
 * weight because it is how a large share of Rwandan business contact actually
 * happens, and the phone number stays a tappable tel: link throughout.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Picture from '../components/Picture.astro';
import ContactForm from '../components/ContactForm';
import { routes } from '../data/navigation';
import { company, formspreeEndpoint } from '../data/company';
import { localBusinessSchema, breadcrumbSchema } from '../data/schema';
import { useTranslations, localizePath, type Locale } from '../i18n';
import { images } from '../data/images';
import { getImage } from 'astro:assets';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL('https://primetrack.rw');
const url = new URL(localizePath(routes.contact, locale), site).href;
const logoUrl = new URL((await getImage({ src: images.logo, format: 'png', width: 512 })).src, site).href;
const c = t.companyPages.contact;
---

<BaseLayout
  locale={locale}
  path={routes.contact}
  title={t.seo.contact.title}
  description={t.seo.contact.description}
  schemas={[
    localBusinessSchema(logoUrl),
    breadcrumbSchema([
      { name: t.common.common.home, url: new URL(localizePath(routes.home, locale), site).href },
      { name: c.title, url },
    ]),
  ]}
>
  <PageHero
    locale={locale}
    eyebrow={c.eyebrow}
    title={c.title}
    lead={c.lead}
    crumbs={[{ name: c.title, href: routes.contact }]}
  />

  <Section tone="light">
    <div class="grid gap-14 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-20">
      <!-- Form -->
      <div>
        <h2 class="text-h2">{c.formTitle}</h2>
        <p class="mt-4 measure text-ink-600">{c.formLead}</p>
        <div class="mt-8">
          <ContactForm
            client:visible
            endpoint={formspreeEndpoint}
            locale={locale}
            email={company.email}
            whatsappUrl={company.whatsappUrl}
            whatsappLabel={t.common.cta.whatsappUs}
            labels={t.common.form}
          />
        </div>
      </div>

      <!-- Direct routes + office -->
      <div class="flex flex-col gap-8">
        <div class="rounded-[--radius-panel] border border-ink-100 bg-ink-50 p-6 sm:p-8">
          <h2 class="text-label uppercase text-ink-400">{c.directTitle}</h2>
          <ul class="mt-5 flex flex-col divide-y divide-ink-200">
            <li class="py-3.5 first:pt-0">
              <a href={`tel:${company.phone.e164}`} class="group flex items-center justify-between gap-4">
                <span>
                  <span class="block text-[0.8125rem] font-semibold uppercase tracking-wider text-ink-500">
                    {t.common.cta.callUs}
                  </span>
                  <span class="mt-0.5 block text-h4 text-ink-950 group-hover:text-prime-700">{company.phone.display}</span>
                </span>
              </a>
            </li>
            <li class="py-3.5">
              <a href={company.whatsappUrl} rel="noopener noreferrer" target="_blank" class="group flex items-center justify-between gap-4">
                <span>
                  <span class="block text-[0.8125rem] font-semibold uppercase tracking-wider text-ink-500">
                    {t.common.cta.whatsapp}
                  </span>
                  <span class="mt-0.5 block text-h4 text-ink-950 group-hover:text-prime-700">{company.phone.display}</span>
                </span>
              </a>
            </li>
            <li class="py-3.5 last:pb-0">
              <a href={`mailto:${company.email}`} class="group flex items-center justify-between gap-4">
                <span>
                  <span class="block text-[0.8125rem] font-semibold uppercase tracking-wider text-ink-500">
                    {t.common.cta.emailUs}
                  </span>
                  <span class="mt-0.5 block break-all text-h4 text-ink-950 group-hover:text-prime-700">{company.email}</span>
                </span>
              </a>
            </li>
          </ul>
          <p class="mt-5 text-[0.9375rem] text-ink-600">{c.hoursNote}</p>
        </div>

        <div>
          <h2 class="text-h3">{c.officeTitle}</h2>
          <address class="mt-3 not-italic leading-relaxed text-ink-700">
            {company.address.line1}<br />
            {company.address.line2}<br />
            {company.address.city}, {company.address.country}
          </address>
          <Picture
            imageKey="companyOffice"
            locale={locale}
            wrapperClass="mt-6 rounded-[--radius-panel] border border-ink-100"
            aspect="16 / 11"
            sizes="(min-width: 1024px) 40vw, 100vw"
          />
        </div>

        <div class="rounded-[--radius-panel] border border-ink-100 p-6">
          <h2 class="text-h4">{c.nigeriaTitle}</h2>
          <p class="mt-2 text-[0.9375rem] text-ink-600">{c.nigeriaBody}</p>
          <a
            href="https://www.primetracknigeria.com"
            rel="noopener"
            class="mt-3 inline-flex items-center gap-1.5 font-semibold text-prime-700 hover:text-prime-800"
          >
            {c.nigeriaCta}
            <svg class="h-3.5 w-3.5" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M5 3h6v6M11 3 3.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
