---
/**
 * One page per industry vertical, generated from src/data/industries.ts.
 * Adding a sector means adding an entry there; no route file changes.
 */
import IndustryPage from '../../page-templates/IndustryPage.astro';
import { industries } from '../../data/industries';

export function getStaticPaths() {
  return industries.map((industry) => ({
    params: { industry: industry.slug },
    props: { industry },
  }));
}

const { industry } = Astro.props;
---
<IndustryPage locale="en" industry={industry} />
