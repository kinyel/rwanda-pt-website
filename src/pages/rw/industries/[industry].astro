---
import IndustryPage from '../../../page-templates/IndustryPage.astro';
import { industries } from '../../../data/industries';

export function getStaticPaths() {
  return industries.map((industry) => ({
    params: { industry: industry.slug },
    props: { industry },
  }));
}

const { industry } = Astro.props;
---
<IndustryPage locale="rw" industry={industry} />
