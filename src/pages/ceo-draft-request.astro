---
/**
 * DRAFT for the CEO's review: the advert for a Personal Driver to the CEO.
 *
 * Not a public page. It is `noindex`, left out of the sitemap, and linked
 * from nowhere; it exists so the advert can be read as it would look on the
 * site before it is approved. English only, by design: once approved, the
 * advert moves into the careers system (src/data/careers.ts and both
 * dictionaries), gets its Kinyarwanda version, and this page is deleted.
 * Its copy therefore lives here rather than in the dictionaries.
 *
 * The five requirements and the equal-opportunity line are the CEO's own
 * words, kept exactly as he wrote them, and the requirements are the first
 * thing under the hero; everything else is the draft for him to approve. Anything still
 * undecided is shown as "to confirm", not filled in with a guess.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { heroScenes } from '../data/hero-scenes';
import { routes } from '../data/routes';
import { company } from '../data/company';

const subject = 'Application – Personal Driver to the CEO';
const mailto = `mailto:${company.careersEmail}?subject=${encodeURIComponent(subject)}`;

const advert = {
  eyebrow: 'Job advert · Draft for review',
  title: 'Personal Driver to the CEO',
  lead: 'Drive our Chief Executive Officer safely and on time, in Kigali, across Rwanda and beyond, often at short notice.',
  chips: ['Kigali, with travel at short notice', 'Full-time', 'Reports to the CEO'],
  role: 'We are looking for a reliable, discreet and experienced driver to drive our Chief Executive Officer to meetings, client visits, the airport and other engagements, in Kigali, across Rwanda and beyond when required, often at short notice.',
  about:
    'PrimeTrack Telematics is licensed by RURA to provide GPS vehicle tracking and telematics services in Rwanda. We help businesses track their vehicles, manage their fleets, monitor fuel and keep their drivers safe, backed by round-the-clock support from our PrimeCARE team.',
};

/* 24-unit line drawings, stroked by the page's CSS. */
const icon = {
  shield: '<path d="M12 3l7 2.8v5.4c0 4.2-2.9 7.6-7 8.8-4.1-1.2-7-4.6-7-8.8V5.8z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
  route: '<circle cx="6" cy="18" r="2.2"/><circle cx="18" cy="6" r="2.2"/><path d="M8.2 18h6.3a3.5 3.5 0 0 0 0-7h-5a3.5 3.5 0 0 1 0-7h5.3"/>',
  wrench: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4z"/>',
  document: '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h6"/>',
  gauge: '<path d="M4 17a8 8 0 1 1 16 0"/><path d="m12 17 4-5"/><circle cx="12" cy="17" r="1.3"/>',
  box: '<path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/>',
  lock: '<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15.5" r="1.3"/>',
  briefcase: '<rect x="3.5" y="7.5" width="17" height="12" rx="2"/><path d="M9 7.5V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1.5M3.5 13h17"/>',
  pin: '<path d="M12 21.5s-6.5-5.6-6.5-10.6a6.5 6.5 0 0 1 13 0c0 5-6.5 10.6-6.5 10.6z"/><circle cx="12" cy="10.8" r="2.3"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  user: '<circle cx="12" cy="8" r="3.6"/><path d="M4.5 20.5c.9-3.9 3.9-6 7.5-6s6.6 2.1 7.5 6"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15.5" rx="2.2"/><path d="M8 3v4M16 3v4M3.5 10h17"/>',
  check: '<path d="m5.5 12.5 4 4 9-9.5"/>',
  mail: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  id: '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2.3"/><path d="M5.8 16.2c.6-1.7 1.8-2.6 3.2-2.6s2.6.9 3.2 2.6M14.5 10h3.5M14.5 13.5h3.5"/>',
  cv: '<path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4"/><circle cx="12.5" cy="11" r="2"/><path d="M9.5 17c.5-1.5 1.6-2.3 3-2.3s2.5.8 3 2.3"/>',
};

const responsibilities = [
  { icon: icon.shield, text: 'Drive the CEO safely and punctually, observing traffic laws at all times' },
  { icon: icon.route, text: 'Plan routes and timings in advance, allowing for traffic, so every appointment is met on time' },
  { icon: icon.wrench, text: 'Keep the vehicle clean, fuelled and roadworthy; report faults promptly and arrange servicing' },
  { icon: icon.document, text: 'Keep the vehicle’s documents, including insurance and technical inspection, up to date' },
  { icon: icon.gauge, text: 'Keep an accurate log of trips, mileage and fuel' },
  { icon: icon.box, text: 'Run errands and deliver documents when required' },
  { icon: icon.lock, text: 'Treat everything seen or heard in the course of duty with strict confidentiality' },
];

/* The CEO's own five, exactly as he wrote them. Not to be reworded. */
const requirements = [
  'English language proficiency',
  'Residence in Kigali',
  'Free to travel at short notice',
  'National Id card and valid driving licence issued by RNP',
  'At least 3 years driving experience',
];

const steps = [
  { icon: icon.cv, title: 'Your CV', text: 'An up-to-date CV.' },
  { icon: icon.id, title: 'Your documents', text: 'Copies of your National ID card and your RNP driving licence.' },
  { icon: icon.mail, title: 'Email them to us', text: `To ${company.careersEmail}, with the subject “${subject}”.` },
];

const glance = [
  { icon: icon.briefcase, label: 'Position', value: 'Personal Driver to the CEO' },
  { icon: icon.pin, label: 'Location', value: 'Kigali, with travel at short notice' },
  { icon: icon.clock, label: 'Employment type', value: 'Full-time', confirm: true },
  { icon: icon.user, label: 'Reports to', value: 'Chief Executive Officer' },
  { icon: icon.calendar, label: 'Application deadline', value: 'To be confirmed', confirm: true },
];

/* What the CEO still has to decide before this goes live. */
const toConfirm = [
  { label: 'Deadline', note: 'Suggested: 5 December 2026, 5:00 PM, the same as the GPS Technician advert.' },
  { label: 'Full-time', note: 'Assumed; not yet confirmed.' },
  { label: 'Working hours', note: 'Early starts, late evenings or weekends? Worth stating in the advert.' },
  { label: 'Salary', note: 'State it, or leave it out. The admin advert gave RWF 200,000.' },
  { label: 'Where to post', note: 'primetrack.rw only, or also on Job in Rwanda like the other two roles.' },
];
---

<BaseLayout
  locale="en"
  path="/ceo-draft-request/"
  title="Draft: Personal Driver to the CEO | PrimeTrack Rwanda"
  description="Draft job advert for a Personal Driver to the CEO at PrimeTrack Rwanda, for internal review before publication."
  noindex
  singleLocale
  switcherFallback={routes.careers}
>
  <!-- A thin dark bar above everything: this is a draft, and says so first. -->
  <div data-nav="dark" class="draft-bar on-dark bg-ink-950">
    <div class="container-prime flex flex-wrap items-center justify-center gap-x-3 gap-y-1 py-2.5 text-center">
      <span class="draft-pill text-label uppercase">
        <i class="draft-dot" aria-hidden="true"></i>
        Draft for the CEO’s review
      </span>
      <span class="text-[0.875rem] text-ink-400">Not published · Hidden from search engines · Not linked from the site</span>
    </div>
  </div>

  <PageHero
    scene={heroScenes.driverAdvert}
    locale="en"
    eyebrow={advert.eyebrow}
    title={advert.title}
    lead={advert.lead}
    chips={advert.chips}
    crumbs={[
      { name: 'Prime careers', href: routes.careers },
      { name: advert.title, href: '/ceo-draft-request/' },
    ]}
  >
    {/* The requirements first: the one thing every applicant must check
        before anything else. The email address is in the summary card and
        the "How to apply" section, one tap from either button. */}
    <div class="arrive mt-8 flex flex-wrap gap-3" style="--d:5">
      <Button href="#requirements" variant="primary" size="lg">See requirements</Button>
      <Button href="#apply" variant="secondaryOnDark" size="lg">How to apply</Button>
    </div>
  </PageHero>

  <!-- ============ Requirements: the CEO's five, first and plain ============
       The first thing under the hero, in his words, on their own ground:
       anyone who does not meet all five knows before reading anything else. -->
  <section id="requirements" data-nav="light" class="musts relative bg-ink-50 text-ink-800" aria-labelledby="needs">
    <div class="container-prime py-16 sm:py-20 lg:py-24">
      <div class="musts-grid">
        <div>
          <p class="eyebrow mb-4 reveal">Requirements</p>
          <h2 id="needs" class="text-h2" data-words>What you must have</h2>
          <p class="mt-5 text-lead text-ink-700 reveal">Applicants must meet all five.</p>
        </div>
        <ol class="needs" role="list">
          {
            requirements.map((item, i) => (
              <li class="need card reveal-left" style={`--n:${i}`}>
                <span class="need-n" aria-hidden="true">{i + 1}</span>
                <p class="need-text text-h3 text-ink-950">{item}</p>
                <span class="need-check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="m5.5 12.5 4 4 9-9.5" pathLength="1" />
                  </svg>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section data-nav="light" class="advert relative bg-white text-ink-800">
    <div class="container-prime py-16 sm:py-20 lg:py-24">
      {/* COMMENTED OUT on request: the "For the CEO to confirm" panel. Kept
          here, not deleted, so it can come back by removing this comment;
          put `mt-16 lg:mt-20` back on the advert grid below when it does.

      <div class="review reveal">
        <p class="review-title text-label uppercase">
          <i class="draft-dot" aria-hidden="true"></i>
          For the CEO to confirm before this goes live
        </p>
        <ol class="review-list mt-6" role="list">
          {
            toConfirm.map((item, i) => (
              <li class="reveal-rise" style={`--n:${i}`}>
                <span class="review-n" aria-hidden="true">{i + 1}</span>
                <div>
                  <p class="font-semibold text-ink-950">{item.label}</p>
                  <p class="mt-1 text-[0.9375rem] leading-relaxed text-ink-700">{item.note}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      */}

      <div class="advert-grid">
        <!-- ============ Side: at a glance, and what is left to decide ============ -->
        <aside class="advert-side" aria-label="Summary">
          <div class="side-stack">
            <div class="glance card card-accent reveal-right">
              <p class="text-label uppercase text-prime-700">At a glance</p>
              <dl class="glance-list mt-5">
                {
                  glance.map((row) => (
                    <div class="glance-row">
                      <span class="glance-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false" set:html={row.icon} />
                      </span>
                      <div>
                        <dt class="text-label uppercase text-ink-500">{row.label}</dt>
                        <dd class="mt-1 text-lead font-semibold text-ink-950">
                          {row.value}
                          {row.confirm && <span class="tbc text-label uppercase">To confirm</span>}
                        </dd>
                      </div>
                    </div>
                  ))
                }
              </dl>
              <Button href={mailto} variant="primary" size="lg" class="mt-7 w-full">Email your application</Button>
            </div>

          </div>
        </aside>

        <!-- ============ The advert ============ -->
        <div class="advert-main">
          <section class="block" aria-labelledby="role">
            <p class="eyebrow mb-4 reveal">The role</p>
            <h2 id="role" class="text-h2" data-words>Who we are looking for</h2>
            <p class="mt-5 measure text-lead text-ink-700 reveal">{advert.role}</p>

            <div class="about card card-muted reveal-scale mt-10">
              <span class="about-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false" set:html={icon.route} />
              </span>
              <div>
                <h3 class="text-lead font-semibold text-ink-950">About PrimeTrack</h3>
                <p class="mt-2 text-lead text-ink-700">{advert.about}</p>
              </div>
            </div>
          </section>

          <section class="block" aria-labelledby="duties">
            <p class="eyebrow mb-4 reveal">Responsibilities</p>
            <h2 id="duties" class="text-h2" data-words>What the job involves</h2>
            <ul class="duties mt-10" role="list">
              {
                responsibilities.map((item, i) => (
                  <li class="duty card reveal-scale" style={`--n:${i % 4}`}>
                    <span class="duty-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" focusable="false" set:html={item.icon} />
                    </span>
                    <p class="text-lead text-ink-800">{item.text}</p>
                  </li>
                ))
              }
            </ul>
          </section>

          <section id="apply" class="block apply-block" aria-labelledby="apply-title">
            <p class="eyebrow mb-4 reveal">How to apply</p>
            <h2 id="apply-title" class="text-h2" data-words>Three things, one email</h2>
            <ol class="steps mt-10" role="list">
              {
                steps.map((step, i) => (
                  <li class="step reveal-rise" style={`--n:${i}`}>
                    <span class="step-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" focusable="false" set:html={step.icon} />
                      <b class="step-n">{i + 1}</b>
                    </span>
                    <h3 class="mt-5 text-lead font-semibold text-ink-950">{step.title}</h3>
                    <p class="mt-1 text-lead text-ink-700">{step.text}</p>
                  </li>
                ))
              }
            </ol>

            <div class="send card-dark card on-dark reveal-soft mt-10">
              <div>
                <p class="text-lead text-ink-200">
                  Send your application by the deadline,
                  <span class="tbc tbc-dark text-label uppercase">To confirm</span>
                  at 5:00 PM (Kigali time).
                </p>
                <p class="mt-2 text-lead text-ink-400">Only shortlisted candidates will be contacted.</p>
              </div>
              <Button href={mailto} variant="primary" size="lg">Email your application</Button>
            </div>

            <p class="eo reveal mt-8 text-lead text-ink-700">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 3l7 2.8v5.4c0 4.2-2.9 7.6-7 8.8-4.1-1.2-7-4.6-7-8.8V5.8z" />
                <path d="m9 12 2.2 2.2L15.5 10" />
              </svg>
              <span><strong class="font-semibold text-ink-950">PrimeTrack is an equal opportunity employer.</strong></span>
            </p>
          </section>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------------------------------------------------------------------
     THE DRAFT BAR
  --------------------------------------------------------------------- */
  .draft-bar {
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .draft-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    border: 1px solid rgb(255 166 61 / 0.45);
    background-color: rgb(255 140 0 / 0.1);
    padding: 0.35rem 0.75rem;
    color: var(--color-amber-300);
  }
  .draft-dot {
    position: relative;
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-amber-500);
  }
  @media (prefers-reduced-motion: no-preference) {
    .draft-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background-color: inherit;
      animation: draft-signal 1.8s var(--ease-out) infinite;
    }
  }
  @keyframes draft-signal {
    from {
      opacity: 0.6;
      transform: scale(1);
    }
    70%,
    to {
      opacity: 0;
      transform: scale(3);
    }
  }

  /* ---------------------------------------------------------------------
     LAYOUT. The advert reads down the main column; the summary card stays
     in view beside it on a wide screen (it is shorter than any laptop's
     screen, so all of it stays reachable), and comes first on a phone,
     where a reader wants the facts before the detail.
  --------------------------------------------------------------------- */
  .advert-grid {
    display: grid;
    gap: 3.5rem;
  }
  @media (width >= 64rem) {
    .advert-grid {
      grid-template-columns: minmax(0, 1fr) 23rem;
      gap: 4.5rem;
      align-items: start;
    }
    .advert-side {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-h, 4.5rem) + 1.5rem);
    }
    .advert-main {
      grid-column: 1;
      grid-row: 1;
    }
  }
  .side-stack {
    display: grid;
    gap: 1.25rem;
  }

  .block + .block {
    margin-top: 5.5rem;
  }
  @media (width >= 64rem) {
    .block + .block {
      margin-top: 7rem;
    }
  }

  /* Every drawing on the page is line-work in its box's own colour. */
  .advert svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------------------------------------------------------------------
     AT A GLANCE
  --------------------------------------------------------------------- */
  .glance {
    padding: 1.75rem;
  }
  .glance-list {
    display: grid;
    gap: 1.125rem;
  }
  .glance-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.875rem;
    align-items: start;
  }
  .glance-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-btn);
    border: 1px solid color-mix(in oklab, var(--color-prime-500) 22%, transparent);
    background-color: #fff;
    color: var(--color-prime-700);
  }
  .glance-icon svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  /* "To confirm": an open question, not a value, so it is drawn as a gap
     in the form rather than as text that could be mistaken for the answer. */
  .tbc {
    display: inline-flex;
    margin-left: 0.5rem;
    vertical-align: 0.2em;
    border-radius: 999px;
    border: 1px dashed var(--color-amber-600);
    background-color: rgb(255 140 0 / 0.08);
    padding: 0.2rem 0.55rem;
    color: var(--color-prime-800);
    white-space: nowrap;
  }
  .tbc-dark {
    margin: 0 0.25rem;
    border-color: rgb(255 166 61 / 0.6);
    background-color: rgb(255 140 0 / 0.12);
    color: var(--color-amber-300);
  }

  /* ---------------------------------------------------------------------
     FOR THE CEO TO CONFIRM
  --------------------------------------------------------------------- */
  .review {
    border-radius: var(--radius-panel);
    border: 1.5px dashed rgb(204 112 0 / 0.45);
    background-image: linear-gradient(180deg, rgb(255 140 0 / 0.06), rgb(255 140 0 / 0.015));
    padding: 1.75rem;
  }
  @media (width >= 64rem) {
    .review {
      padding: 2rem 2.25rem;
    }
  }
  .review-title {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-prime-800);
  }
  .review-list {
    display: grid;
    gap: 1.25rem;
  }
  @media (width >= 40rem) {
    .review-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (width >= 64rem) {
    .review-list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }
  .review-list li {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.75rem;
  }
  .review-n {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: 0.15rem;
    border-radius: 50%;
    background-color: rgb(255 140 0 / 0.14);
    color: var(--color-prime-800);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  /* ---------------------------------------------------------------------
     THE ROLE
  --------------------------------------------------------------------- */
  .about {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.75rem;
  }
  .about-mark {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-btn);
    background-image: linear-gradient(145deg, var(--color-prime-500), var(--color-amber-500));
    box-shadow: 0 10px 20px -10px rgb(243 93 1 / 0.7);
    color: #fff;
  }
  .about-mark svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* ---------------------------------------------------------------------
     RESPONSIBILITIES
  --------------------------------------------------------------------- */
  .duties {
    display: grid;
    gap: 1rem;
  }
  @media (width >= 48rem) {
    .duties {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* Seven duties: the last one runs the full width rather than leaving a
       hole in the grid. */
    .duty:last-child {
      grid-column: 1 / -1;
    }
  }
  .duty {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.125rem;
    align-items: start;
    padding: 1.5rem;
    transition:
      border-color var(--duration-base) var(--ease-prime),
      box-shadow var(--duration-slow) var(--ease-out);
  }
  .duty-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-btn);
    border: 1px solid color-mix(in oklab, var(--color-prime-500) 22%, transparent);
    background-image: linear-gradient(145deg, var(--color-prime-50), #fff 80%);
    color: var(--color-prime-700);
    transition:
      transform var(--duration-slow) var(--ease-out),
      background-color var(--duration-base) var(--ease-prime),
      color var(--duration-base) var(--ease-prime);
  }
  .duty-icon svg {
    width: 1.35rem;
    height: 1.35rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .duty:hover {
      border-color: color-mix(in oklab, var(--color-prime-500) 28%, rgb(8 9 11 / 0.08));
      box-shadow:
        inset 0 1px 0 #fff,
        var(--shadow-lift);
    }
    .duty:hover .duty-icon {
      transform: rotate(-8deg) scale(1.06);
      background-image: linear-gradient(145deg, var(--color-prime-500), var(--color-amber-500));
      color: #fff;
    }
  }

  /* ---------------------------------------------------------------------
     REQUIREMENTS. Five cards, one requirement each, in the CEO's words at
     heading size: a big number, the requirement, and a tick that draws
     itself as the card arrives.
  --------------------------------------------------------------------- */
  .musts-grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (width >= 64rem) {
