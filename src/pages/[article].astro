---
/**
 * Every migrated SEO article, rendered at its original root-level WordPress
 * slug so no indexed URL changes.
 *
 * Each article also has a Kinyarwanda version at /rw/<slug>/ (see
 * src/pages/rw/[article].astro). Where one exists the two are paired with
 * hreflang and the language switcher moves between them; an article with no
 * translation yet stays single-language and the switcher points at the
 * Kinyarwanda blog index instead.
 */
import ArticlePage from '../page-templates/ArticlePage.astro';
import { getCollection } from 'astro:content';
import { relatedForArticle } from '../data/article-related';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const translated = new Set((await getCollection('articlesRw')).map((a) => a.id));
  return articles.map((article) => ({
    params: { article: article.id },
    props: { article, translated: translated.has(article.id) },
  }));
}

const { article, translated } = Astro.props;
---

<ArticlePage locale="en" article={article} related={relatedForArticle(article.id)} translated={translated} />
