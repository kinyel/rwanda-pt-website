---
/**
 * The site header.
 *
 * Sticky, contrast-aware, and the same on every page.
 *
 * THE THREE GLOBAL CONTROLS are arranged as a deliberate set rather than three
 * bolted-on widgets:
 *   - Language (EN / KIN) is the loudest of the three, always visible at every
 *     breakpoint, because it is the one a Rwandan visitor may actually use.
 *   - Region (RWA) is quiet and collapsed, because switching country is rare.
 *     It is styled as the language switcher's twin so the two read as a pair.
 *   - The CTA is the only filled element in the bar, so the eye lands on it and
 *     everything else recedes.
 *
 * ONE BAR. There used to be a utility strip above the bar for the phone number
 * and the region. Both now live in the bar itself, as one bordered group
 * between the menu and the call to action — "where we are and how to reach
 * us" — so the header is a single row on every page. On a laptop the number
 * collapses to its icon (it stays in the page as the link's text, so screen
 * readers and search still read it) and the full number shows from 1280px. On
 * a phone the call button stays in the bar, one tap from anywhere, and the
 * region sits in the drawer beside the number.
 *
 * SMART. It hides as you scroll down the page and comes back the moment you
 * scroll up; it never hides while a menu is open, while focus is inside it,
 * or near the top of the page. Over a hero that asks for it, it is clear at
 * rest and takes its solid ground once you scroll. And it lights the menu item
 * for whatever part of the page you are reading, from `data-nav-section` on
 * the sections themselves.
 *
 * CONTRAST AWARENESS. The bar reads light-on-dark over the dark hero and
 * dark-on-light over the pale sections below it. It works out which by
 * observing the sections themselves, never by sampling pixels, reading
 * computed backgrounds or hardcoding scroll offsets — all three of those break
 * the moment the copy on a page gets longer.
 *
 * Every full-width section declares its intent in the markup instead:
 *
 *     <section data-nav="dark">    dark ground, so the header goes light
 *     <section data-nav="light">   light ground, so the header goes dark
 *
 * `Section.astro` emits this from its own `tone`, so most of the site is
 * covered without any page having to think about it.
 *
 * WHY THE SECTIONS AND NOT SENTINELS. The brief asked for a zero-height
 * sentinel at the top of each section. This observes the sections themselves
 * through a thin band pinned to the header's lower edge, which is the same
 * mechanism, the same single observer and the same zero cost per scroll frame,
 * but it answers one more question: a sentinel only reports as it CROSSES the
 * line, so on a reload part-way down the page, or after the back button
 * restores a scroll position, no sentinel crosses anything and the observer has
 * nothing to say. Observing the sections means whichever one covers the band
 * reports on the observer's very first callback, whatever the scroll position
 * is. Same declared intent, same cost, correct on arrival.
 *
 * NO FLASH. `data-theme` is rendered server-side from `navTheme`, so the first
 * paint is already right and hydration changes nothing. With JavaScript off the
 * header simply stays in that state, which is legible on every page because
 * every page's first section is the one it was rendered for.
 */
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import CountrySwitcher from './CountrySwitcher.astro';
import MainNav, { type NavEntry } from './MainNav';
import { primaryNav, routes, resolveKey } from '../data/navigation';
import { company, countries, ACTIVE_COUNTRY } from '../data/company';
import { useTranslations, localizePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  path: string;
  /** Set on pages that exist in one language only. See BaseLayout. */
  switcherFallback?: string;
  /**
   * The `data-nav` value of this page's FIRST section, so the bar is correct
   * on first paint with no flash of the wrong state before hydration.
   * Defaults to dark: every template except the homepage and the 404 opens on
   * `PageHero`, which is ink-950.
   */
  navTheme?: 'dark' | 'light';
}

const { locale, path, switcherFallback, navTheme = 'dark' } = Astro.props;
const t = useTranslations(locale);

/* Labels are resolved here, server-side, so the React island ships no copy and
   no i18n runtime. */
const regions = countries.map((country) => ({
  code: country.code,
  name: t.common.country.names[country.code],
  url: country.external ? country.url : localizePath(country.url, locale),
  active: country.code === ACTIVE_COUNTRY,
  external: country.external,
}));

const entries: NavEntry[] = primaryNav.map((group) => ({
  label: resolveKey(t, group.titleKey),
  navKey: group.titleKey.split('.').pop(),
  href: group.href ? localizePath(group.href, locale) : undefined,
  active: group.href ? group.href === path : group.items?.some((i) => i.href === path),
  intro: group.introKey ? resolveKey(t, group.introKey) : undefined,
  indexHref: group.indexHref ? localizePath(group.indexHref, locale) : undefined,
  indexLabel: group.indexLabelKey ? resolveKey(t, group.indexLabelKey) : undefined,
  rail: group.railKeys?.map((key) => resolveKey(t, key)),
  items: group.items?.map((item) => ({
    label: resolveKey(t, item.titleKey),
    descriptor: item.descriptorKey ? resolveKey(t, item.descriptorKey) : undefined,
    href: localizePath(item.href, locale),
    active: item.href === path,
  })),
}));
---

<header class="site-header" data-site-header data-theme={navTheme} data-state="top">
  <!-- Background, blur and hairline, on their own layer. See global.css for
       why this is not on the header element itself. -->
  <div class="site-header-surface" aria-hidden="true"></div>

  <!-- Main bar. Fixed height in both themes: nothing here may resize. -->
  <div class="container-prime flex h-[var(--header-bar-h)] items-center justify-between gap-3">
    <a
      href={localizePath(routes.home, locale)}
      class="site-header-logo shrink-0"
      aria-label={`${t.common.brand.legalName}. ${t.common.nav.home}`}
    >
      <Logo locale={locale} height={40} eager />
    </a>

    <!-- Nav, controls and CTA share one baseline: 2.5rem for the nav items,
         2.25rem for the two quiet controls, 2.5rem for the button, all
         vertically centred on the same row with an even gap rhythm. -->
    <div class="flex items-center gap-1.5 lg:gap-2.5">
      <MainNav
        client:idle
        entries={entries}
        ctaLabel={t.common.cta.contactUs}
        ctaHref={localizePath(routes.contact, locale)}
        menuLabel={t.common.nav.menu}
        openLabel={t.common.nav.openMenu}
        closeLabel={t.common.nav.closeMenu}
        navLabel={t.common.nav.primaryLabel}
        railTitle={t.common.nav.trustRailTitle}
        phoneLabel={company.phone.display}
        phoneHref={`tel:${company.phone.e164}`}
        regions={regions}
        regionLabel={t.common.country.label}
        regionCurrentLabel={t.common.country.current}
      />

      <!-- Where we are and how to reach us: region and phone, as one group.
           The number is the link's own text at every width — only its
           visibility changes — so the phone number is in the page exactly as
           it always was. -->
      <div class="site-header-reach">
        <span class="site-header-region">
          <CountrySwitcher locale={locale} tone="auto" />
        </span>
        <a href={`tel:${company.phone.e164}`} class="site-header-phone">
          <svg class="site-header-phone-icon" viewBox="0 0 24 24" width="17" height="17" fill="none"
               stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />
          </svg>
          <span class="site-header-phone-number">{company.phone.display}</span>
        </a>
      </div>

      <!-- Always visible, every breakpoint, never inside the drawer. -->
      <LanguageSwitcher locale={locale} path={path} fallbackPath={switcherFallback} tone="auto" />

      <!--
        The one filled element in the bar, and therefore the only place the eye
        is meant to land.

        Its label is ink-950, not white. The brand orange is a LIGHT colour
        (relative luminance 0.27): white on it is 3.29:1, which is fine for a
        large display button and short of the 4.5:1 that a 15px label needs.
        Ink on the same orange is 6.05:1, and on the prime-400 hover it is
        7.79:1, so the button gets brighter and MORE legible under the pointer.
        Nothing about the fill changes: this stays the brand orange at full
        strength on both grounds.
      -->
      <a
        href={localizePath(routes.contact, locale)}
        class="btn btn-sm btn-primaryInk hidden shrink-0 font-bold lg:inline-flex"
      >
        {t.common.cta.contactUs}
      </a>
    </div>
  </div>

</header>

<!-- READING PROGRESS, along the top edge of the screen, above the bar. It is a
   sibling of the header rather than part of it, so it stays put when the bar
   slides away and the car at its leading edge keeps driving while you read.
   The car turns round when you scroll back, and brakes when you stop.
   Decorative: the scrollbar already says all of this. -->
<div class="site-progress" aria-hidden="true">
  <span class="site-progress-road"></span>
  <span class="site-progress-fill"></span>
  <span class="site-progress-car">
    <svg viewBox="-30 -20 60 34" width="44" height="25" focusable="false">
      <defs>
        <linearGradient id="sp-beam" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#ffe9c8" stop-opacity="0.55" />
          <stop offset="1" stop-color="#ffe9c8" stop-opacity="0" />
        </linearGradient>
        <filter id="sp-soft" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="1.6" />
        </filter>
      </defs>
      <g class="sp-turn">
        <!-- On the road: shadow and headlight beam. -->
        <ellipse class="sp-shadow" cx="1.5" cy="3" rx="19" ry="5.5" filter="url(#sp-soft)" />
        <path class="sp-beam" d="M18 -3 L46 -9 L46 9 L18 3 Z" fill="url(#sp-beam)" />
        <!-- The body, as planes stacked up the screen. -->
        <g class="sp-l sp-chassis" style="--k:0">
          <rect x="-14" y="-9.6" width="6" height="2.4" rx="1" />
          <rect x="8" y="-9.6" width="6" height="2.4" rx="1" />
          <rect x="-14" y="7.2" width="6" height="2.4" rx="1" />
          <rect x="8" y="7.2" width="6" height="2.4" rx="1" />
          <path d="M-19 -8 C-21 -8 -21 8 -19 8 L16 8.6 C21 8.6 21.5 -8.6 16 -8.6 Z" />
        </g>
        <g class="sp-l sp-side" style="--k:2.4">
          <path d="M-19 -8 C-21 -8 -21 8 -19 8 L16 8.6 C21 8.6 21.5 -8.6 16 -8.6 Z" />
        </g>
        <g class="sp-l sp-body" style="--k:4.8">
          <path d="M-19 -8 C-21 -8 -21 8 -19 8 L16 8.6 C21 8.6 21.5 -8.6 16 -8.6 Z" />
          <circle class="sp-head" cx="19.4" cy="-4.6" r="1.6" />
          <circle class="sp-head" cx="19.4" cy="4.6" r="1.6" />
          <rect class="sp-brake" x="-20.6" y="-7" width="1.8" height="4.4" rx="0.7" />
          <rect class="sp-brake" x="-20.6" y="2.6" width="1.8" height="4.4" rx="0.7" />
        </g>
        <g class="sp-l sp-glass" style="--k:7">
          <path d="M-11.6 -7 L9.6 -7.4 C11.2 -3 11.2 3 9.6 7.4 L-11.6 7 C-13.6 2.6 -13.6 -2.6 -11.6 -7 Z" />
        </g>
        <g class="sp-l sp-roof" style="--k:8.8">
          <path d="M-6.2 -5.6 L6.6 -5.8 L6.6 5.8 L-6.2 5.6 Z" />
        </g>
      </g>
    </svg>
  </span>
</div>

<!-- Where the bar went. Once the bar has slid away on the way down, this tab
     drops from the top edge to say it is one scroll up — and it is a button
     too, so a tap brings the bar straight back. Its label is the site's own
     "Menu" string, drawn by the stylesheet from `data-label`, so it adds no
     words to the page. -->
<button
  type="button"
  class="site-nav-hint"
  data-nav-hint
  aria-label={t.common.nav.menu}
  data-label={t.common.nav.menu}
>
  <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"
       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3.5 10 8 5.5 12.5 10" />
  </svg>
</button>

<script>
  /**
   * Keeps `data-theme` and `data-state` on the header in step with the page.
   *
   * Two IntersectionObservers, no scroll listener, nothing per frame.
   *
   *   1. THEME. One observer watches every `[data-nav]` section through a thin
   *      band pinned to the header's lower edge. Whichever section covers that
   *      band is the one currently passing under the bar, and its `data-nav`
   *      value is the theme.
   *
   *      HYSTERESIS is the band's own height. While a section boundary is
   *      inside the band BOTH sections intersect it, and the rule in that case
   *      is to keep whatever the header already shows. So the switch happens
   *      once the boundary has fully cleared the band, and a reader hovering
   *      exactly on a seam gets a stable header instead of a flickering one.
   *      With no dead zone a single pixel of scroll jitter would flip it.
   *
   *   2. SCROLLED. One observer watches a short sentinel pinned to the top of
   *      the DOCUMENT (not to the header, which never moves). While it is in
   *      view the page is at rest and the bar is bare; once it leaves, the bar
   *      takes a background, a hairline and a restrained blur.
   *
   * Both observers are rebuilt on resize, because the band's position is
   * derived from the header's height and that changes at two breakpoints.
   */
  const BAND = 12; // px of dead zone at the boundary — see HYSTERESIS above.

  function initHeader(header: HTMLElement) {
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-nav]'));
    const covering = new Set<HTMLElement>();
    let themeObserver: IntersectionObserver | undefined;

    const applyTheme = () => {
      const current = header.dataset.theme;

      /* Still covering the band: hold. This is the hysteresis, and it is also
         what keeps the header steady in the gap between two sections. */
      for (const section of covering) {
        if (section.dataset.nav === current) return;
      }

      const next = covering.values().next().value?.dataset.nav;
      if (next && next !== current) header.dataset.theme = next;
    };

    const observeSections = () => {
      themeObserver?.disconnect();
      covering.clear();
      if (sections.length === 0) return;

      /* A BAND-tall strip of the viewport sitting immediately below the bar.
         Everything above and below it is cropped out by the margins, so a
         section "intersects" only while it is genuinely under the header. */
      const top = header.getBoundingClientRect().height;
      const bottom = Math.max(0, window.innerHeight - top - BAND);

      themeObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const el = entry.target as HTMLElement;
            if (entry.isIntersecting) covering.add(el);
            else covering.delete(el);
          }
          applyTheme();
        },
        { rootMargin: `-${top}px 0px -${bottom}px 0px`, threshold: 0 },
      );

      for (const section of sections) themeObserver.observe(section);
    };

    /* At-rest vs scrolled. */
    const sentinel = document.querySelector('[data-nav-scroll-sentinel]');
    if (sentinel) {
      new IntersectionObserver(
        ([entry]) => {
          header.dataset.state = entry.isIntersecting ? 'top' : 'scrolled';
        },
        { threshold: 0 },
      ).observe(sentinel);
    }

    /* ---- Smart: away on the way down, back on the way up --------------
       A bar that follows you down a long page is a strip of screen you never
       get back; a bar that is gone when you reach for it is worse. So it
       leaves as you read on and returns the moment you scroll back up, which
       is what a reader who wants the menu does without thinking. It never
       leaves near the top, while a menu or the drawer is open, or while focus
       is inside it — a keyboard user tabbing into a hidden bar would be lost.
       Translate only, so it can never shift the page. */
    const settle = () => header.offsetHeight * 2;
    let lastY = window.scrollY;
    let dirFrame = 0;
    const onDirection = () => {
      dirFrame = 0;
      const y = window.scrollY;
      const dy = y - lastY;
      if (Math.abs(dy) < 6) return;
      const busy = header.hasAttribute('data-solid') || header.matches(':focus-within');
      if (dy > 0 && y > settle() && !busy) header.setAttribute('data-hidden', '');
      else header.removeAttribute('data-hidden');
      lastY = y;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!dirFrame) dirFrame = requestAnimationFrame(onDirection);
      },
      { passive: true },
    );
    header.addEventListener('focusin', () => header.removeAttribute('data-hidden'));

    /* The tab that stands in for the bar while it is away: a tap brings it
       back. The direction tracker is re-zeroed so the very next scroll pixel
       does not send it straight away again. */
    document.querySelector<HTMLButtonElement>('[data-nav-hint]')?.addEventListener('click', () => {
      header.removeAttribute('data-hidden');
      lastY = window.scrollY;
    });

    /* ---- Clear over a hero that asks for it, solid once past it ------- */
    const first = sections[0];
    if (first?.hasAttribute('data-nav-overlay')) header.setAttribute('data-overlay', '');
    if (first) {
      new IntersectionObserver(
        ([entry]) => header.toggleAttribute('data-past', !entry.isIntersecting),
        { rootMargin: `-${header.offsetHeight}px 0px 0px 0px`, threshold: 0 },
      ).observe(first);
    }

    /* ---- The part of the page being read lights its menu item ---------
       Sections say which item they belong to with `data-nav-section`. A thin
       band across the middle of the screen decides which one is being read;
       the header carries the answer as `data-section`, and the stylesheet
       lights the matching `data-nav-key`. The menu island is never touched. */
    const parts = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-section]'));
    if (parts.length) {
      const inBand = new Set<HTMLElement>();
      const reading = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const el = entry.target as HTMLElement;
            if (entry.isIntersecting) inBand.add(el);
            else inBand.delete(el);
          }
          const current = inBand.values().next().value;
          if (current?.dataset.navSection) header.dataset.section = current.dataset.navSection;
          else delete header.dataset.section;
        },
        { rootMargin: '-46% 0px -50% 0px', threshold: 0 },
      );
      for (const part of parts) reading.observe(part);
    }

    observeSections();

    /* Hand over to the crossfade. `data-theme` was rendered from the first
       section on the page, so if this page was loaded part-way down, the
       callbacks above have just corrected it — and that correction has to be
       instant rather than a visible fade from the wrong state. Until this
       attribute is set, --duration-theme is 0ms; see global.css.

       A double rAF puts this after the frame the corrections are painted in,
       with a timeout behind it because rAF never fires in a background tab and
       the bar must not be left without its transition. */
    const ready = () => header.setAttribute('data-nav-ready', '');
    requestAnimationFrame(() => requestAnimationFrame(ready));
    window.setTimeout(ready, 200);

    /* The band is derived from the header's height, which changes at sm and
       lg, so the observer is rebuilt when the viewport is resized. Debounced:
       a resize drag would otherwise tear down and rebuild it per frame. */
    let resizeTimer = 0;
    window.addEventListener(
      'resize',
      () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(observeSections, 150);
      },
      { passive: true },
    );

    /* Restored from the back/forward cache: the page comes back with its old
       scroll position and its old DOM, so re-run the observers rather than
       trusting whatever state the bar was left in. */
    window.addEventListener('pageshow', (event) => {
      if ((event as PageTransitionEvent).persisted) observeSections();
    });
  }

  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) initHeader(header);
</script>
