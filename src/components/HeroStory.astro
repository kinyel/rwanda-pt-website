<script>
  /**
   * Plays the hero.
   *
   * Writes `--p` (the section's progress, 0 to 1) and the camera's tilt and
   * turn on the section, and on each scene `--in` (how present it is) and
   * `--t` (how far through it the reader is). The vehicle's place on its
   * road and the readouts' digits are set in the same frame.
   *
   * Runs only where the stage can pin: not under reduced motion, and not on
   * a phone on its side, where a pinned stage would be taller than the
   * screen. Anywhere else the section is three still blocks and this does
   * nothing at all.
   */
  const clamp = (n: number, lo = 0, hi = 1) => Math.min(hi, Math.max(lo, n));
  const ease = (n: number) => n * n * (3 - 2 * n);

  function initStory(root: HTMLElement) {
    const windows = JSON.parse(root.dataset.story ?? '[]') as [number, number][];
    /* SCENE CHANGES ARE QUICK AND NEVER OVERLAP. A scene, words and object
       alike, has fully gone by the boundary between two scenes, and the next
       only starts to arrive from it, so two scenes are never on screen at
       once. Each fade is 2% of the section (about 60px of scrolling), so the
       empty moment between them is a single beat, not a gap. */
    const FADE = 0.02;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const room = window.matchMedia('(width >= 64rem), (height >= 34rem)');

    const scenes = [...root.querySelectorAll<HTMLElement>('[data-scene]')];
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const trip = root.querySelector<SVGPathElement>('[data-trip]');
    const car = root.querySelector<SVGGElement>('[data-car]');
    const chip = root.querySelector<HTMLElement>('[data-car-chip]');
    const lat = root.querySelector<HTMLElement>('[data-lat]');
    const lon = root.querySelector<HTMLElement>('[data-lon]');
    const tank = root.querySelector<HTMLElement>('[data-tank]');
    const level = root.querySelector<HTMLElement>('[data-level]');
    const tripLength = trip ? trip.getTotalLength() : 0;
    const fence = root.querySelector<SVGCircleElement>('[data-fence]');
    const ripple = root.querySelector<SVGCircleElement>('[data-fence-ripple]');
    let inFence = false;

    let live = false;
    let frame = 0;
    let lastLevel = '';

    /* How present scene `i` is at progress `p`: the first is there from the
       start, the last stays until the stage fades out as a whole. */
    const presence = (i: number, p: number) => {
      const [from, to] = windows[i];
      const fadeIn = i === 0 ? 1 : ease(clamp((p - from) / FADE));
      const fadeOut = i === windows.length - 1 ? 1 : 1 - ease(clamp((p - (to - FADE)) / FADE));
      return fadeIn * fadeOut;
    };

    /* The vehicle, `c` of the way along the Central Corridor. */
    const placeCar = (c: number) => {
      if (!trip || !car || !tripLength) return;
      const at = c * tripLength;
      const a = trip.getPointAtLength(at);
      const b = trip.getPointAtLength(Math.min(tripLength, at + 2));
      const heading = c >= 1 ? 0 : (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI + 90;
      car.setAttribute('transform', `translate(${a.x.toFixed(2)} ${a.y.toFixed(2)}) rotate(${heading.toFixed(1)})`);
      if (chip) {
        chip.style.setProperty('--x', (a.x / 400).toFixed(4));
        chip.style.setProperty('--y', (a.y / 360).toFixed(4));
      }
      /* Back out of the map's projection: the readout is the real
         position of the point drawn. */
      const lonDeg = (a.x - 20) / 174 + 28.85;
      const latDeg = (a.y - 30) / 174 + 1.04;
      if (lat) lat.textContent = `${latDeg.toFixed(4)}° S`;
      if (lon) lon.textContent = `${lonDeg.toFixed(4)}° E`;

      /* The geofence: lit while the vehicle is inside it, and a pulse
         each time it crosses the boundary, in either direction. */
      if (fence) {
        const inside =
          c > 0 && Math.hypot(a.x - fence.cx.baseVal.value, a.y - fence.cy.baseVal.value) < fence.r.baseVal.value;
        if (inside !== inFence) {
          inFence = inside;
          root.toggleAttribute('data-fence-in', inside);
          ripple?.animate(
            [
              { transform: 'scale(1)', opacity: 0.9 },
              { transform: 'scale(1.9)', opacity: 0 },
            ],
            { duration: 900, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
          );
        }
      }
    };

    const update = () => {
      frame = 0;
      if (!live) return;
      const rect = root.getBoundingClientRect();
      const vh = window.innerHeight;
      if (rect.bottom < 0 || rect.top > vh) return;

      const travel = rect.height - vh;
      const p = travel > 0 ? clamp(-rect.top / travel) : 0;
      root.style.setProperty('--p', p.toFixed(4));

      /* The camera: high over the map, then lower once it has gone, and a
         slow turn across the whole hero. */
      const lower = ease(clamp((p - 0.28) / 0.05));
      root.style.setProperty('--tilt', `${(48 + lower * 12).toFixed(2)}deg`);
      root.style.setProperty('--spin', `${(-12 + p * 26).toFixed(2)}deg`);
      root.style.setProperty('--floor', (1 - presence(0, p)).toFixed(3));

      let current = 0;
      let best = -1;
      scenes.forEach((scene, i) => {
        const [from, to] = windows[i];
        const words = presence(i, p);
        const local = clamp((p - from) / (to - from));
        scene.style.setProperty('--in', words.toFixed(3));
        scene.style.setProperty('--cin', words.toFixed(3));
        scene.style.setProperty('--t', local.toFixed(4));
        if (words > best) {
          best = words;
          current = i;
        }
      });
      scenes.forEach((scene, i) => scene.toggleAttribute('data-current', i === current && best > 0.6));
      steps.forEach((step, i) => step.toggleAttribute('data-current', i === current));

      /* Scene one: the vehicle appears the moment the reader scrolls, and
         drives the corridor over the scene. */
      const t0 = clamp(p / windows[0][1]);
      const c = clamp(t0 / 0.8);
      root.style.setProperty('--car', clamp(t0 * 40).toFixed(3));
      root.style.setProperty('--trip', c.toFixed(4));
      placeCar(c);

      /* Scene two: the level holds, then drops sharply, then the drop is
         flagged. */
      const t1 = clamp((p - windows[1][0]) / (windows[1][1] - windows[1][0]));
      const drop = ease(clamp((t1 - 0.36) / 0.16));
      const lvl = 0.78 - drop * 0.34;
      if (tank) {
        tank.style.setProperty('--lvl', lvl.toFixed(4));
        tank.style.setProperty('--alert', clamp((t1 - 0.5) * 8).toFixed(3));
      }
      const shown = `${Math.round(lvl * 100)}%`;
      if (level && shown !== lastLevel) {
        level.textContent = shown;
        lastLevel = shown;
      }
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    /* Focus on something in a scene that is not on screen (tabbing, or a
       screen reader moving through the page) brings that scene up. */
    const onFocus = (event: FocusEvent) => {
      if (!live) return;
      const scene = (event.target as HTMLElement).closest<HTMLElement>('[data-scene]');
      if (!scene || scene.hasAttribute('data-current')) return;
      const i = scenes.indexOf(scene);
      const [from, to] = windows[i];
      const target = i === 0 ? 0 : i === windows.length - 1 ? to - 0.02 : (from + to) / 2;
      const top = root.getBoundingClientRect().top + window.scrollY;
      window.scrollTo({ top: top + target * (root.offsetHeight - window.innerHeight), behavior: 'instant' });
    };

    const apply = () => {
      live = !still.matches && room.matches;
      root.toggleAttribute('data-journey-live', live);
      if (live) {
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        update();
      } else {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
        for (const name of ['--p', '--tilt', '--spin', '--floor', '--car', '--trip']) root.style.removeProperty(name);
        for (const scene of scenes) {
          scene.style.removeProperty('--in');
          scene.style.removeProperty('--cin');
          scene.style.removeProperty('--t');
          scene.removeAttribute('data-current');
        }
        root.removeAttribute('data-fence-in');
        inFence = false;
        tank?.style.removeProperty('--lvl');
        tank?.style.removeProperty('--alert');
        if (level) level.textContent = '44%';
        lastLevel = '';
      }
    };

    root.addEventListener('focusin', onFocus);
    still.addEventListener('change', apply);
    room.addEventListener('change', apply);
    apply();

    /* The infographic, full size: the thumbnail's own picture, asked for at
       the size it will now be shown. */
    const dialog = root.querySelector<HTMLDialogElement>('[data-figure-dialog]');
    const slot = root.querySelector<HTMLElement>('[data-figure-slot]');
    const thumb = root.querySelector<HTMLElement>('.hs-figure-img');
    root.querySelector('[data-figure-open]')?.addEventListener('click', () => {
      if (!dialog || !slot || !thumb) return;
      if (!slot.firstElementChild) {
        const copy = thumb.cloneNode(true) as HTMLElement;
        copy.querySelectorAll('source, img').forEach((el) => el.setAttribute('sizes', 'min(92vw, 1400px)'));
        copy.querySelector('img')?.setAttribute('loading', 'eager');
        slot.append(copy);
      }
      dialog.showModal();
    });
    root.querySelector('[data-figure-close]')?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-story]').forEach((el) => initStory(el));
</script>
