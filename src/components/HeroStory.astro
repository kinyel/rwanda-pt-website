      linear-gradient(160deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.02));
    box-shadow: 0 0 calc(40 * var(--u)) rgb(var(--glow) / calc(0.22 * var(--on)));
  }
  .hs-glyph {
    position: absolute;
    inset: 18%;
