---
/**
 * The four headline figures.
 *
 * Values come from src/data/company.ts, which holds the numbers published on
 * the live site's own counters. They are rendered as static text rather than
 * count-up animations: a number that animates from zero is unreadable for the
 * first second and adds JavaScript for no informational gain.
 */
import { company } from '../data/company';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  tone?: 'light' | 'dark';
}

const { locale, tone = 'dark' } = Astro.props;
const t = useTranslations(locale);

const labels = t.home.stats.labels as Record<string, string>;
const valueTone = tone === 'dark' ? 'text-white' : 'text-ink-950';
const labelTone = tone === 'dark' ? 'text-ink-400' : 'text-ink-500';
const ruleTone = tone === 'dark' ? 'bg-white/10' : 'bg-ink-100';
---

<dl class="grid grid-cols-2 gap-px lg:grid-cols-4">
  {
    company.stats.map((stat) => (
      <div class={`relative p-6 sm:p-8 ${ruleTone}`} style="outline:1px solid transparent">
        <dt class={`text-[0.8125rem] font-semibold leading-snug ${labelTone}`}>{labels[stat.key]}</dt>
        <dd class={`mt-2 text-stat ${valueTone}`}>
          {stat.value.toLocaleString('en-US')}<span class="text-prime-500">{stat.suffix}</span>
        </dd>
      </div>
    ))
  }
</dl>
