---
/**
 * Hero for every page except the homepage.
 *
 * Dark, compact, and carrying the page's single h1 plus breadcrumbs. The
 * contour wash is the same motif as the homepage hero at much lower intensity,
 * so inner pages feel related without competing with it.
 *
 * THE SCENE. Optionally it also carries a purpose-built 3D composition beside
 * the copy — see `PageHeroScene.astro`, which holds all of them and explains
 * the thinking. One hero repeated 108 times is why the site had exactly one
 * piece of real geometry in it; the scene is how each family of pages gets its
 * own camera on the same landscape without a second hero component.
 *
 * It is laid out as a grid only when a scene is asked for, so every page that
 * does not take one renders exactly the markup it rendered before. The scene
 * is `aria-hidden`, carries no text and comes after the copy in the DOM, so
 * the heading, the lead and the reading order are untouched by it.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import PageHeroScene from './PageHeroScene.astro';
import type { SceneKind } from '../data/hero-scenes';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  eyebrow?: string;
  title: string;
  lead?: string;
  /** Short factual chips, e.g. product specs. */
  chips?: readonly string[];
  crumbs?: { name: string; href: string }[];
  /** Which 3D composition stands beside the copy. Omit for a plain hero. */
  scene?: SceneKind;
}

const { locale, eyebrow, title, lead, chips, crumbs, scene } = Astro.props;
---

<section data-nav="dark" class="on-dark relative overflow-hidden bg-ink-950 bg-contour-prime">
  <div class="absolute inset-0 bg-prime-glow" aria-hidden="true"></div>
  <div class="container-prime relative py-14 sm:py-16 lg:py-20">
    {crumbs && <Breadcrumbs locale={locale} crumbs={crumbs} tone="dark" class="mb-7" />}

    <div class:list={['pagehero-body', scene && 'pagehero-body-scene']}>
      <div>
        {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
        <h1 class="text-display text-white">{title}</h1>
        {lead && <p class="mt-5 measure text-lead text-ink-300">{lead}</p>}
        {
          chips && chips.length > 0 && (
            <ul class="mt-8 flex flex-wrap gap-2">
              {chips.map((chip) => (
                <li class="rounded-full border border-white/15 px-3.5 py-1.5 text-[0.8125rem] font-semibold text-ink-200">
                  {chip}
                </li>
              ))}
            </ul>
          )
        }
        <slot />
      </div>

      {scene && <PageHeroScene kind={scene} />}
    </div>
  </div>
</section>

<style>
  /* Without a scene this wrapper does nothing at all: `display: contents`
     dissolves it, so a hero that takes no scene renders the same box tree it
     rendered before this component learned about scenes. */
  .pagehero-body {
    display: contents;
  }

  .pagehero-body-scene {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  /* The copy keeps the page to itself until there is genuinely room for two
     columns. Below this the scene is a band under the heading, which is the
     right reading order on a phone and the only one that leaves the h1 a
     sensible measure. */
  @media (width >= 64rem) {
    .pagehero-body-scene {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.58fr);
      gap: 3.5rem;
    }
  }
</style>
