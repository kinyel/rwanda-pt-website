---
/**
 * The inner pages' hero scene.
 *
 * THE PROBLEM IT SOLVES. Every page except the homepage shared one hero: a
 * dark band, a contour wash, a heading. That is a fine hero and it is the
 * same hero 108 times, so the site had exactly one piece of real geometry in
 * it and the rest was wallpaper.
 *
 * EVERYTHING HERE IS DRAWN, NOT MODELLED, and that is the lesson of the first
 * build of this file. It held five shaded solids — a plinth, stacked slabs, a
 * tile lattice, filled contours — and on a near-black ground a shaded solid
 * is a dark lump with a rim on it. The only one of the five that worked was
 * the one made of lit lines in space. A line holds its colour at any size,
 * never muddies against the ground it is on, and lets what is behind it show
 * through, which is the thing that actually sells depth. So all five are
 * line-work now: luminous drawings standing in a dark room.
 *
 * THE ORGANISING IDEA is still the homepage's. Rwanda is a landscape, not a
 * plane, and the design system already treats contour geometry as the local
 * substrate because gradient drives fuel burn and hills drive route times.
 * Each scene is a different drawing of that same world rather than a repeated
 * object, which is what keeps the families distinct and the site coherent.
 *
 * WHY IT IS GENUINELY 3D. Every part sits at its own `translateZ` inside one
 * `preserve-3d` stage under a shared `perspective`, and the stage is tilted.
 * The browser projects it, so parts occlude each other correctly and edges
 * foreshorten.
 *
 * AND IT MOVES, WHICH IS THE POINT. A static tilted shape is not a 3D object,
 * it is a picture of one; the cue the eye actually uses is MOTION PARALLAX,
 * parts at different depths sweeping past each other at different rates. One
 * number, `--s`, is how far the scene has travelled up the viewport (-1 at
 * the bottom edge, 0 dead centre, +1 at the top). Every camera and every
 * event derives from it in CSS. Each scene has a real event, and the event is
 * about what the page is for: the platform fans into its layers, the eight
 * operations rise off the ground, the unit assembles itself, the routes pulse
 * into the hub; on the reading pages the seal comes down onto the terms, a
 * scan passes over the privacy shield, the warranty's five years light one
 * by one, the team connects, the manual's pages turn, the signal goes out
 * and the radar finds the fleet. Scrolling back runs it backwards.
 *
 * COST. No WebGL, no 3D library, no model file, no images. One rAF-throttled
 * scroll handler for every scene on the page, writing one custom property;
 * every visual consequence is declarative CSS. Transform, opacity and filter
 * only, so nothing here can move layout. Under reduced motion the handler
 * never attaches and the static composition is what ships. The scene is
 * `aria-hidden` and carries no text, so it is invisible to search engines and
 * to assistive technology: nothing here can touch a heading, a link or a word
 * of copy.
 *
 * MOBILE. Not hidden, recomposed. The scene moves under the copy as its own
 * band and loses most of its relief, because at that width it is read at a
 * glance on the way past rather than studied.
 */
import type { SceneKind } from '../data/hero-scenes';

interface Props {
  kind: SceneKind;
  /**
   * The small version, for the compact heroes of the reading pages: beside
   * the heading rather than a column of its own, so the depth and the line
   * weights come down with the size (see the end of the stylesheet).
   */
  compact?: boolean;
}

const { kind, compact = false } = Astro.props as Props;

/* ---------------------------------------------------------------------------
   Geometry is generated, not hand-written.

   Hand-authored repeats drift: a plate 3% off, a column whose spacing breaks
   the pattern, a contour that crosses the one inside it. None of these
   generators can make that mistake, and changing the look is changing a
   number rather than editing forty attributes.
--------------------------------------------------------------------------- */

/** LAYERS: five plates of one platform, and the posts running through them. */
const PLATE = { x: 62, y: 98, w: 276, h: 204, r: 18 };
const LAYERS = [0, 1, 2, 3, 4];
const POSTS = [
  [PLATE.x, PLATE.y],
  [PLATE.x + PLATE.w, PLATE.y],
  [PLATE.x, PLATE.y + PLATE.h],
  [PLATE.x + PLATE.w, PLATE.y + PLATE.h],
].map(([x, y]) => ({ x: +((x / 400) * 100).toFixed(2), y: +((y / 400) * 100).toFixed(2) }));

/** FIELD: eight columns on one measured ground.
    Heights from a fixed sequence rather than random, so the skyline is a
    composition and is identical on every render. */
const COLUMNS = [0.62, 1, 0.42, 0.84, 0.34, 0.72, 0.5, 0.94].map((h, i) => {
  const col = i % 4;
  const row = Math.floor(i / 4);
  return {
    i,
    h,
    /* Two rows of four, the back row inset, so the set reads in perspective
       rather than as a line of eight. */
    x: +(20 + col * 20 + row * 10).toFixed(2),
    y: +(62 - row * 24).toFixed(2),
  };
});

/** BLUEPRINT: three parts of one unit, as outlines. */
const PARTS = [
  { w: 152, h: 106, r: 12 },
  { w: 130, h: 92, r: 11 },
  { w: 108, h: 76, r: 10 },
].map((part, i) => ({ ...part, i, x: 200 - part.w / 2, y: 200 - part.h / 2 }));

/** CONVERGE: eight routes arriving at one point.
    Bowed alternately left and right off their own straight line, so eight
    arrivals read as roads rather than as a starburst. */
const HUB = { x: 200, y: 208 };
const ROUTES = Array.from({ length: 8 }, (_, i) => {
  const a = (i / 8) * Math.PI * 2 + 0.4;
  const ex = HUB.x + Math.cos(a) * 184;
  const ey = HUB.y + Math.sin(a) * 148;
  const nx = -(ey - HUB.y);
  const ny = ex - HUB.x;
  const nl = Math.hypot(nx, ny) || 1;
  const bow = (i % 2 ? 1 : -1) * 36;
  const cx = (HUB.x + ex) / 2 + (nx / nl) * bow;
  const cy = (HUB.y + ey) / 2 + (ny / nl) * bow;
  const f = (n: number) => n.toFixed(1);
  return { d: `M${f(ex)} ${f(ey)}Q${f(cx)} ${f(cy)} ${HUB.x} ${HUB.y}`, x: +f(ex), y: +f(ey), i };
});

/* ---------------------------------------------------------------------------
   THE READING PAGES. Each of these used to share one drawing of the land
   (contour lines and nothing on them). They now each get a drawing of what
   the page is about, in the same lit line-work as every other scene.
--------------------------------------------------------------------------- */

const f1 = (n: number) => n.toFixed(1);

/** Horizontal position on the stage, as a percentage, of a point in the
    400-unit drawing. The stage is 6:5 and the drawing is the centred square
    of its height, so x runs over 83.33% of the width, not all of it. */
const stageX = (x: number) => +(50 + ((x - 200) / 400) * 83.333).toFixed(3);
const stageY = (y: number) => +((y / 400) * 100).toFixed(3);

/** AGREEMENT: the terms, as the document they are. Three sheets of one
    contract, the top one written on, signed, and sealed. */
const SHEET = { x: 94, y: 38, w: 212, h: 318, r: 10 };
const TERMS_LINES = [
  { x1: 122, x2: 228, y: 80, head: true },
  { x1: 122, x2: 278, y: 116 },
  { x1: 122, x2: 264, y: 140 },
  { x1: 122, x2: 278, y: 164 },
  { x1: 122, x2: 246, y: 188 },
  { x1: 122, x2: 272, y: 212 },
  { x1: 122, x2: 216, y: 236 },
].map((line, k) => ({ ...line, k }));
const SIGNATURE = 'M124 302c6-17 13-24 17-15s-3 18 2 16 10-21 15-14-2 14 3 13 9-10 14-9 7 6 14 1';
const SEAL = { x: 262, y: 304 };

/** SHIELD: privacy, as layers of protection around one locked core. */
function shieldPath(k: number) {
  const P = (x: number, y: number) => `${f1(200 + x * k)} ${f1(206 + y * k)}`;
  return (
    `M${P(0, -152)}C${P(44, -127)} ${P(88, -121)} ${P(130, -121)}` +
    `C${P(134, -34)} ${P(120, 54)} ${P(0, 152)}` +
    `C${P(-120, 54)} ${P(-134, -34)} ${P(-130, -121)}` +
    `C${P(-88, -121)} ${P(-44, -127)} ${P(0, -152)}Z`
  );
}
const SHIELDS = [1, 0.78, 0.57, 0.37].map((k, i) => ({ d: shieldPath(k), i, t: +(i / 3).toFixed(3) }));

/** SEAL: the warranty, as a rosette whose ring is five years long. */
function scallop(r: number, amp: number, lobes: number) {
  const steps = lobes * 8;
  let d = '';
  for (let i = 0; i <= steps; i++) {
    const a = (i / steps) * Math.PI * 2;
    const rr = r + amp * Math.cos(a * lobes);
    d += `${i ? 'L' : 'M'}${f1(200 + Math.cos(a) * rr)} ${f1(200 + Math.sin(a) * rr)}`;
  }
  return `${d}Z`;
}
const ROSETTE = scallop(150, 7, 24);
const YEARS = Array.from({ length: 5 }, (_, k) => {
  const r = 116;
  const a0 = ((-90 + k * 72 + 5) * Math.PI) / 180;
  const a1 = ((-90 + k * 72 + 67) * Math.PI) / 180;
  return {
    k,
    d: `M${f1(200 + Math.cos(a0) * r)} ${f1(200 + Math.sin(a0) * r)}A${r} ${r} 0 0 1 ${f1(200 + Math.cos(a1) * r)} ${f1(200 + Math.sin(a1) * r)}`,
  };
});

/** TEAM: careers, as seven people round one table, each connected to it. */
const PEOPLE = Array.from({ length: 7 }, (_, i) => {
  const a = ((-90 + (i * 360) / 7) * Math.PI) / 180;
  const x = 200 + Math.cos(a) * 140;
  const y = 200 + Math.sin(a) * 140;
  return {
    i,
    x: stageX(x),
    y: stageY(y),
    spoke: `M${f1(200 + Math.cos(a) * 58)} ${f1(200 + Math.sin(a) * 58)}L${f1(200 + Math.cos(a) * 124)} ${f1(200 + Math.sin(a) * 124)}`,
  };
});

/** MANUAL: the support documents, as an open book whose pages turn. */
const PAGES = [0, 1, 2, 3, 4];
const PAGE_LINES = [18, 28, 38, 48, 58, 68, 78];

/** SIGNAL: the articles are about tracking, so this is PrimeTrack's own
    mark: a located vehicle, signalling, at the end of its route. */
const SIGNAL_ROUTE = 'M58 338C110 318 96 262 150 252S228 270 214 226 196 208 200 200';
const RIPPLES = [0, 1, 2];

/** RADAR: analysing a fleet, as a sweep that finds the vehicles and flags
    the two that need attention. Angles clockwise from the top, in degrees. */
const BLIPS = [
  { a: 38, r: 96, flag: false },
  { a: 82, r: 132, flag: true },
  { a: 128, r: 64, flag: false },
  { a: 176, r: 118, flag: false },
  { a: 226, r: 140, flag: true },
  { a: 272, r: 84, flag: false },
  { a: 316, r: 124, flag: false },
].map((b, i) => {
  const rad = ((b.a - 90) * Math.PI) / 180;
  const x = 200 + Math.cos(rad) * b.r;
  const y = 200 + Math.sin(rad) * b.r;
  return { ...b, i, x: +f1(x), y: +f1(y), sx: stageX(x), sy: stageY(y) };
});
/** DRIVE: a steering wheel, in layers from the rim to the hub, standing
    over the road it is driving down. The rim's two leather grips sit where
    two hands would (ten to two), and a marker at twelve o'clock shows the
    wheel turning. Angles clockwise from twelve. */
const arcPath = (r: number, from: number, to: number) => {
  const p = (deg: number) => {
    const a = ((deg - 90) * Math.PI) / 180;
    return `${f1(200 + Math.cos(a) * r)} ${f1(200 + Math.sin(a) * r)}`;
  };
  return `M${p(from)}A${r} ${r} 0 ${to - from > 180 ? 1 : 0} 1 ${p(to)}`;
};
const WHEEL_GRIPS = [arcPath(139, 286, 334), arcPath(139, 26, 74)];
const WHEEL_STITCH = Array.from({ length: 36 }, (_, i) => i * 10)
  .filter((deg) => !(deg > 280 && deg < 340) && !(deg > 20 && deg < 80) && Math.abs(deg) > 6 && deg < 354)
  .map((deg) => {
    const a = ((deg - 90) * Math.PI) / 180;
    return `M${f1(200 + Math.cos(a) * 131)} ${f1(200 + Math.sin(a) * 131)}L${f1(200 + Math.cos(a) * 147)} ${f1(200 + Math.sin(a) * 147)}`;
  })
  .join('');
const ROAD_DASHES = 'M200 0V400';

const RADAR_TICKS = Array.from({ length: 24 }, (_, i) => {
  const a = (i / 24) * Math.PI * 2;
  const r0 = i % 2 ? 152 : 146;
  return `M${f1(200 + Math.cos(a) * r0)} ${f1(200 + Math.sin(a) * r0)}L${f1(200 + Math.cos(a) * 160)} ${f1(200 + Math.sin(a) * 160)}`;
}).join('');
---

<div
  class="phs"
  data-scene={kind}
  data-compact={compact ? '' : undefined}
  data-ambient={kind === 'drive' ? '' : undefined}
  aria-hidden="true"
>
  <div class="phs-cam">
    <div class="phs-stage">
      {
        kind === 'layers' && (
          <>
            {/* Posts first, so the plates draw over where they cross. */}
            {POSTS.map((post) => (
              <span class="post" style={`--x:${post.x}%; --y:${post.y}%`} />
            ))}
            {LAYERS.map((i) => (
              <span class="plate" style={`--i:${i}; --t:${(i / 4).toFixed(3)}`}>
                <svg viewBox="0 0 400 400" focusable="false">
                  <rect
                    class="plate-edge"
                    x={PLATE.x}
                    y={PLATE.y}
                    width={PLATE.w}
                    height={PLATE.h}
                    rx={PLATE.r}
                  />
                  <line
                    class="plate-rule"
                    x1={PLATE.x}
                    y1={PLATE.y + PLATE.h / 2}
                    x2={PLATE.x + PLATE.w}
                    y2={PLATE.y + PLATE.h / 2}
                  />
                  <line
                    class="plate-rule"
                    x1={PLATE.x + PLATE.w / 2}
                    y1={PLATE.y}
                    x2={PLATE.x + PLATE.w / 2}
                    y2={PLATE.y + PLATE.h}
                  />
                </svg>
              </span>
            ))}
          </>
        )
      }

      {
        kind === 'field' && (
          <>
            <span class="ground">
              <svg viewBox="0 0 400 400" focusable="false">
                {[0, 1, 2, 3, 4].map((i) => (
                  <line class="ground-rule" x1="34" y1={136 + i * 44} x2="366" y2={136 + i * 44} />
                ))}
                {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => (
                  <line class="ground-rule" x1={34 + i * 41.5} y1="136" x2={34 + i * 41.5} y2="312" />
                ))}
              </svg>
            </span>
            {COLUMNS.map((column) => (
              <span
                class="column"
                style={`--i:${column.i}; --h:${column.h}; --x:${column.x}%; --y:${column.y}%`}
              >
                <i class="column-shaft" />
                <i class="column-cap" />
              </span>
            ))}
          </>
        )
      }

      {
        kind === 'blueprint' && (
          <>
            <span class="datum" />
            {PARTS.map((part) => (
              <span class="part" style={`--i:${part.i}`}>
                <svg viewBox="0 0 400 400" focusable="false">
                  <rect
                    class="part-edge"
                    x={part.x}
                    y={part.y}
                    width={part.w}
                    height={part.h}
                    rx={part.r}
                  />
                  {/* Called-out corners. A drawing's corners are ticked and
                      a render's are not, and that difference is most of
                      what makes this read as a specification rather than
                      as three boxes. */}
                  {[
                    [part.x, part.y, 1, 1],
                    [part.x + part.w, part.y, -1, 1],
                    [part.x, part.y + part.h, 1, -1],
                    [part.x + part.w, part.y + part.h, -1, -1],
                  ].map(([cx, cy, sx, sy]) => (
                    <path
                      class="part-tick"
                      d={`M${cx + sx * 24} ${cy}H${cx + sx * 10}M${cx} ${cy + sy * 24}V${cy + sy * 10}`}
                    />
                  ))}
                  {part.i === 2 && <circle class="part-lens" cx="200" cy="200" r="18" />}
                  {part.i === 2 && <circle class="part-lens-core" cx="200" cy="200" r="6" />}
                </svg>
              </span>
            ))}
          </>
        )
      }

      {
        kind === 'converge' && (
          <svg class="phs-svg" viewBox="0 0 400 400" focusable="false">
            <defs>
              <linearGradient id="phs-route" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="400">
                <stop offset="0%" stop-color="#ff9d5c" stop-opacity="0.95" />
                <stop offset="100%" stop-color="#ff7d29" stop-opacity="0.5" />
              </linearGradient>
              <filter id="phs-hub" x="-120%" y="-120%" width="340%" height="340%">
                <feGaussianBlur stdDeviation="5" result="b" />
                <feMerge>
                  <feMergeNode in="b" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
            </defs>
            {/* The road, then the traffic on it. Two passes rather than one
                because a pulse on its own leaves the scene empty between
                pulses, and a road on its own never arrives. */}
            {ROUTES.map((r) => (
              <path class="route" d={r.d} style={`--i:${r.i}`} />
            ))}
            {ROUTES.map((r) => (
              <path class="pulse" d={r.d} pathLength="1" style={`--i:${r.i}`} />
            ))}
            {ROUTES.map((r) => (
              <circle class="origin" cx={r.x} cy={r.y} r="3.4" />
            ))}
            <circle class="hub-ring" cx={HUB.x} cy={HUB.y} r="17" />
            <circle class="hub-core" cx={HUB.x} cy={HUB.y} r="6" />
          </svg>
        )
      }

      {
        kind === 'agreement' && (
          <>
            {[0, 1].map((i) => (
              <span class="sheet sheet-under" style={`--i:${i}`}>
                <svg viewBox="0 0 400 400" focusable="false">
                  <rect class="sheet-edge" x={SHEET.x} y={SHEET.y} width={SHEET.w} height={SHEET.h} rx={SHEET.r} />
                </svg>
              </span>
            ))}
            <span class="sheet sheet-top" style="--i:2">
              <svg viewBox="0 0 400 400" focusable="false">
                <rect class="sheet-edge" x={SHEET.x} y={SHEET.y} width={SHEET.w} height={SHEET.h} rx={SHEET.r} />
                {TERMS_LINES.map((line) => (
                  <path
                    class:list={['sheet-line', line.head && 'sheet-head']}
                    d={`M${line.x1} ${line.y}H${line.x2}`}
                    pathLength="1"
                    style={`--k:${line.k}`}
                  />
                ))}
                <path class="sheet-sign" d={SIGNATURE} pathLength="1" style="--k:7" />
                <path class="sheet-line" d="M122 318H230" pathLength="1" style="--k:8" />
              </svg>
            </span>
            {/* The seal, above the page, coming down onto it. */}
            <span class="stamp">
              <svg viewBox="0 0 400 400" focusable="false">
                <circle class="stamp-ring" cx={SEAL.x} cy={SEAL.y} r="27" />
                <circle class="stamp-inner" cx={SEAL.x} cy={SEAL.y} r="19" />
                <path class="stamp-tick" d={`M${SEAL.x - 9} ${SEAL.y}l7 7 14-15`} />
              </svg>
            </span>
          </>
        )
      }

      {
        kind === 'shield' && (
          <>
            {SHIELDS.map((shield) => (
              <span class="guard" style={`--i:${shield.i}; --t:${shield.t}`}>
                <svg viewBox="0 0 400 400" focusable="false">
                  <path class="guard-edge" d={shield.d} />
                  {shield.i === 3 && (
                    <>
                      <circle class="guard-lock" cx="200" cy="196" r="11" />
                      <path class="guard-lock" d="M194 205 190 230H210L206 205" />
                    </>
                  )}
                </svg>
              </span>
            ))}
            {/* A scan passing over the whole shield, clipped to its edge. */}
            <span class="guard-scan">
              <svg viewBox="0 0 400 400" focusable="false">
                <defs>
                  <clipPath id="phs-shield-clip">
                    <path d={SHIELDS[0].d} />
                  </clipPath>
                  <linearGradient id="phs-scan-band" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#ff8c3c" stop-opacity="0" />
                    <stop offset="100%" stop-color="#ff8c3c" stop-opacity="0.3" />
                  </linearGradient>
                </defs>
                <g clip-path="url(#phs-shield-clip)">
                  <rect class="scan-band" x="40" y="-44" width="320" height="44" />
                  <line class="scan-line" x1="40" y1="0" x2="360" y2="0" />
                </g>
              </svg>
            </span>
          </>
        )
      }

      {
        kind === 'seal' && (
          <>
            <span class="medal" style="--i:0">
              <svg viewBox="0 0 400 400" focusable="false">
                {/* Two ribbon tails, under the rosette. */}
                <path class="medal-ribbon" d="M170 318 150 384 168 372 182 392 196 330" />
                <path class="medal-ribbon" d="M230 318 250 384 232 372 218 392 204 330" />
                <path class="medal-edge" d={ROSETTE} />
              </svg>
            </span>
            <span class="medal" style="--i:1">
              <svg viewBox="0 0 400 400" focusable="false">
                <circle class="medal-track" cx="200" cy="200" r="116" />
                {YEARS.map((year) => (
                  <path class="medal-year" d={year.d} style={`--k:${year.k}`} />
                ))}
              </svg>
            </span>
            <span class="medal" style="--i:2">
              <svg viewBox="0 0 400 400" focusable="false">
                <circle class="medal-core" cx="200" cy="200" r="78" />
                <circle class="medal-rule" cx="200" cy="200" r="64" />
                <path class="medal-tick" d="M168 202 192 226 236 178" />
              </svg>
            </span>
          </>
        )
      }

      {
        kind === 'team' && (
          <>
            <span class="huddle">
              <svg viewBox="0 0 400 400" focusable="false">
                <circle class="table-ring" cx="200" cy="200" r="58" />
                <circle class="table-ring table-outer" cx="200" cy="200" r="162" />
                {PEOPLE.map((person) => (
                  <path class="table-spoke" d={person.spoke} pathLength="1" style={`--i:${person.i}`} />
                ))}
                <circle class="table-hub" cx="200" cy="200" r="9" />
              </svg>
            </span>
            {PEOPLE.map((person) => (
              <span class="person" style={`--i:${person.i}; --x:${person.x}%; --y:${person.y}%`}>
                <svg class="person-mark" viewBox="0 0 40 48" focusable="false">
                  <circle cx="20" cy="13" r="8.5" />
                  <path d="M5 46c0-12 7-19 15-19s15 7 15 19" />
                </svg>
              </span>
            ))}
          </>
        )
      }

      {
        kind === 'manual' && (
          <>
            <span class="leaf leaf-cover leaf-left">
              <svg viewBox="0 0 68 100" preserveAspectRatio="none" focusable="false">
                <rect class="leaf-edge" x="1" y="1" width="66" height="98" rx="3" />
                {PAGE_LINES.slice(0, 5).map((y) => (
                  <path class="leaf-line" d={`M10 ${y + 6}H${y % 20 ? 56 : 48}`} />
                ))}
              </svg>
            </span>
            <span class="leaf leaf-cover leaf-right">
              <svg viewBox="0 0 68 100" preserveAspectRatio="none" focusable="false">
                <rect class="leaf-edge" x="1" y="1" width="66" height="98" rx="3" />
              </svg>
            </span>
            {PAGES.map((k) => (
              <span class="leaf leaf-page" style={`--k:${k}`}>
                <svg viewBox="0 0 68 100" preserveAspectRatio="none" focusable="false">
                  <rect class="leaf-edge" x="1" y="1" width="66" height="98" rx="2" />
                  <path class="leaf-line leaf-head" d="M10 14H40" />
                  {PAGE_LINES.map((y) => (
                    <path class="leaf-line" d={`M10 ${y + 10}H${y % 20 ? 58 : 50}`} />
                  ))}
                </svg>
              </span>
            ))}
            <span class="spine" />
          </>
        )
      }

      {
        kind === 'signal' && (
          <>
            <span class="map">
              <svg viewBox="0 0 400 400" focusable="false">
                <defs>
                  <linearGradient id="phs-signal-route" gradientUnits="userSpaceOnUse" x1="58" y1="338" x2="200" y2="200">
                    <stop offset="0%" stop-color="#ff7d29" stop-opacity="0.35" />
                    <stop offset="100%" stop-color="#ffb07a" stop-opacity="1" />
                  </linearGradient>
                </defs>
                {[0, 1, 2, 3, 4, 5, 6].map((i) => (
                  <path class="map-rule" d={`M${80 + i * 40} 70V330M70 ${80 + i * 40}H330`} />
                ))}
                <path class="map-route" d={SIGNAL_ROUTE} pathLength="1" />
                <circle class="map-start" cx="58" cy="338" r="5" />
                <circle class="map-spot" cx="200" cy="200" r="7" />
              </svg>
            </span>
            {RIPPLES.map((k) => (
              <span class="ripple" style={`--k:${k}`}>
                <svg viewBox="0 0 400 400" focusable="false">
                  <circle cx="200" cy="200" r="100" />
                </svg>
              </span>
            ))}
            <span class="pin" style={`--x:${stageX(200)}%; --y:${stageY(200)}%`}>
              <svg class="pin-mark" viewBox="0 0 40 56" focusable="false">
                <path d="M20 54S4 34.5 4 20.5a16 16 0 0 1 32 0C36 34.5 20 54 20 54Z" />
                <circle class="pin-eye" cx="20" cy="20.5" r="6" />
              </svg>
            </span>
          </>
        )
      }

      {
        kind === 'radar' && (
          <>
            <span class="scope">
              <svg viewBox="0 0 400 400" focusable="false">
                {[40, 80, 120, 160].map((r) => (
                  <circle class:list={['scope-ring', r === 160 && 'scope-rim']} cx="200" cy="200" r={r} />
                ))}
                <path class="scope-cross" d="M40 200H360M200 40V360" />
                <path class="scope-tick" d={RADAR_TICKS} />
              </svg>
            </span>
            <span class="sweep">
              <span class="sweep-arm" />
            </span>
            <span class="finds">
              <svg viewBox="0 0 400 400" focusable="false">
                {BLIPS.map((blip) => (
                  <g class:list={['blip', blip.flag && 'blip-flag']} style={`--a:${blip.a}`}>
                    {blip.flag && <circle class="blip-ring" cx={blip.x} cy={blip.y} r="12" />}
                    <circle class="blip-dot" cx={blip.x} cy={blip.y} r={blip.flag ? 5.5 : 4.5} />
                  </g>
                ))}
              </svg>
            </span>
            {/* The two flagged vehicles stand up off the scope. */}
            {BLIPS.filter((blip) => blip.flag).map((blip) => (
              <span class="beacon" style={`--a:${blip.a}; --x:${blip.sx}%; --y:${blip.sy}%`} />
            ))}
          </>
        )
      }

      {
        kind === 'drive' && (
          <>
            {/* The road, laid out ahead and below the wheel, its lane
                markings running towards the reader. */}
            <span class="road">
              <svg viewBox="0 0 400 400" focusable="false">
                <defs>
                  <linearGradient id="phs-road-fade" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#ff9d5c" stop-opacity="0" />
                    <stop offset="40%" stop-color="#ff9d5c" stop-opacity="0.8" />
                    <stop offset="85%" stop-color="#ff9d5c" stop-opacity="0.9" />
                    <stop offset="100%" stop-color="#ff9d5c" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <path class="road-edge" d="M122 0V400M278 0V400" />
                <path class="road-shoulder" d="M92 0V400M308 0V400" />
                <path class="road-lane" d={ROAD_DASHES} />
              </svg>
            </span>

            {/* The wheel: rim at the back, then the spokes, then the hub
                nearest the reader, as a real wheel is dished. */}
            <span class="wheel">
              <span class="wheel-layer" style="--i:0">
                <svg viewBox="0 0 400 400" focusable="false">
                  <circle class="wheel-rim" cx="200" cy="200" r="152" />
                  <circle class="wheel-rim" cx="200" cy="200" r="126" />
                </svg>
              </span>
              <span class="wheel-layer" style="--i:1">
                <svg viewBox="0 0 400 400" focusable="false">
                  <circle class="wheel-rim wheel-rim-front" cx="200" cy="200" r="152" />
                  <circle class="wheel-rim wheel-rim-front" cx="200" cy="200" r="126" />
                  <path class="wheel-stitch" d={WHEEL_STITCH} />
                  {WHEEL_GRIPS.map((grip) => (
                    <path class="wheel-grip" d={grip} />
                  ))}
                  <path class="wheel-mark" d="M200 50V74" />
                </svg>
              </span>
              <span class="wheel-layer" style="--i:2">
                <svg viewBox="0 0 400 400" focusable="false">
                  <rect class="wheel-spoke" x="76" y="187" width="88" height="26" rx="10" />
                  <rect class="wheel-spoke" x="236" y="187" width="88" height="26" rx="10" />
                  <rect class="wheel-spoke" x="187" y="236" width="26" height="90" rx="10" />
                </svg>
              </span>
              <span class="wheel-layer" style="--i:3">
                <svg viewBox="0 0 400 400" focusable="false">
                  <circle class="wheel-hub" cx="200" cy="200" r="42" />
                  <circle class="wheel-hub-ring" cx="200" cy="200" r="27" />
                  <circle class="wheel-hub-core" cx="200" cy="200" r="7" />
                </svg>
              </span>
            </span>
          </>
        )
      }
    </div>
  </div>

  <span class="phs-floor"></span>
</div>

<style>
  @property --phs-in {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  /* ---------------------------------------------------------------------
     THE FRAME. Shared by every scene: one box, one camera, one pool of
     light on the floor. Only `--tilt`, `--spin` and the contents differ,
     so a new scene is a block of markup and two numbers rather than a new
     component.
  --------------------------------------------------------------------- */
  .phs {
    position: relative;
    width: 100%;
    max-width: 32rem;
    aspect-ratio: 6 / 5;
    margin-inline: auto;
    pointer-events: none;
    /* The camera, as two numbers, so an upright element can counter-rotate
       by the exact negative of them and face the viewer. Written out twice
       they would drift the moment one changed. */
    --tilt: 60deg;
    --spin: -22deg;
    /* Every `translateZ` in here is multiplied by this. Depth is the one
       dimension CSS cannot express as a percentage of the box, so a scene
       authored at 32rem would keep its full relief at 18rem and burst out
       of its own frame. One number, set once per breakpoint. */
    --depth: 1;
    /* Line weight, as a multiple, for the reading pages' scenes, so their
       small versions can thin their strokes with their size. */
    --lw: 1;
    /* Arrives rather than appears. One animation on the whole scene, not
       forty on its parts: the parts are a composition, and a composition
       that assembles itself in front of you is a loading screen. */
    animation:
      phs-arrive 760ms var(--ease-out) both,
      phs-in 1900ms cubic-bezier(0.3, 0.75, 0.25, 1) 80ms both;
  }

  /* EACH SCENE HAS ITS OWN ENTRANCE. One registered number, `--phs-in`,
     runs 0 to 1 once on load, and every scene spends it differently on its
     camera (below, per scene): the platform swings down from edge-on, the
     operations rise out of the dark, the unit spins in blown apart, the
     network tips back from flat, the land tilts up off the page. Registered
     with an initial value of 1, so without the animation (reduced motion)
     the scene is simply where it ends. */
  @keyframes phs-in {
    from {
      --phs-in: 0;
    }
    to {
      --phs-in: 1;
    }
  }
  @keyframes phs-arrive {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .phs-cam {
    position: absolute;
    inset: 0;
    perspective: 1200px;
    perspective-origin: 50% 46%;
  }

  .phs-stage {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    --phs-out: calc(1 - var(--phs-in));
    transform: translateZ(calc(var(--phs-out) * var(--in-z, 0px)))
      rotateX(calc(var(--tilt) + var(--phs-out) * var(--in-tilt, 0deg)))
      rotateZ(calc(var(--spin) + var(--phs-out) * var(--in-spin, 0deg)))
      scale(calc(1 - var(--phs-out) * var(--in-shrink, 0)));
  }

  /* The scene floats, so it needs something to float above or it reads as
     pasted on. Flat on the floor, blurred, warm. */
  .phs-floor {
    position: absolute;
    left: 50%;
    bottom: 4%;
    width: 72%;
    height: 22%;
    transform: translateX(-50%);
    border-radius: 999px;
    background-image: radial-gradient(closest-side, rgb(243 93 1 / 0.3), transparent 72%);
    filter: blur(16px);
  }

  /* Every scene's drawing surface. `overflow: visible` so a stroke at the
     edge of the viewBox is not clipped in half by its own box. */
  .phs-svg,
  .plate svg,
  .part svg,
  .ground svg,
  .sheet svg,
  .stamp svg,
  .guard svg,
  .guard-scan svg,
  .medal svg,
  .huddle svg,
  .map svg,
  .ripple svg,
  .scope svg,
  .finds svg,
  .road svg,
  .wheel-layer svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* A NOTE ON LINE WEIGHT AT A TILT, because it has caught this file twice.
     A 1px edge lying on a plane tilted 62deg is 0.47px of screen once
     projected, and a half-pixel line on a near-black field is a rumour.
     Every stroke here is specified for its FINAL size, and
     `vector-effect: non-scaling-stroke` keeps it honest when a 400-unit
     viewBox is scaled into a box of some other size.

     WHICH CUTS BOTH WAYS. `non-scaling-stroke` means the weight stays put
     when the drawing grows, so enlarging the scene by a third made every
     line a third finer relative to what it was drawing and the whole set
     went pale at once. Line weight is proportional to the composition, not
     to the pixel: these numbers belong with the 32rem box above them and
     want revisiting if that changes again. */

  /* ---------------------------------------------------------------------
     ONE PLATFORM, IN LAYERS — solutions, security, why PrimeTrack.

     The page's own argument is that this is one platform doing five
     things, so the hero is that platform drawn as the five plates it is
     made of, with posts running through all of them. Nothing is filled:
     you see every layer through every other layer, which is the argument.
  --------------------------------------------------------------------- */
  [data-scene='layers'] {
    --tilt: 60deg;
    --spin: -28deg;
    /* Swings down from nearly edge-on, turning a quarter as it settles. */
    --in-tilt: 24deg;
    --in-spin: -80deg;
    --in-shrink: 0.12;
  }
  .plate {
    position: absolute;
    inset: 0;
    transform: translateZ(calc(var(--i) * 26px * var(--depth)));
  }
  .plate-edge {
    fill: none;
    stroke: color-mix(in oklab, var(--color-prime-400) calc(60% + var(--t) * 40%), transparent);
    stroke-width: calc(2.4px + var(--t) * 2px);
    vector-effect: non-scaling-stroke;
  }
  .plate-rule {
    stroke: color-mix(in oklab, var(--color-prime-300) calc(16% + var(--t) * 32%), transparent);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }
  /* The posts. Upright in a scene where everything else is lying down,
     which is what tells you the plates are stacked rather than nested. */
  .post {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 1.5px;
    height: 0;
    translate: -50% 0;
    transform: rotateZ(calc(-1 * var(--spin))) rotateX(calc(-1 * var(--tilt)));
    transform-origin: 50% 100%;
  }
  .post::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 2px;
    height: calc(var(--post-h, 7.4rem) * var(--depth));
    background-image: linear-gradient(to top, rgb(255 125 41 / 0.14), rgb(255 189 140 / 0.9));
  }

  /* ---------------------------------------------------------------------
     EIGHT OPERATIONS, ONE GROUND — industries.

     Eight columns of different height standing on one measured floor:
     different operations, the same system measuring all of them, which is
     exactly what the page is for.
  --------------------------------------------------------------------- */
  [data-scene='field'] {
    /* Rises out of the dark from far below, growing as it comes. */
    --in-z: -320px;
    --in-tilt: 10deg;
    --in-shrink: 0.3;
    --tilt: 66deg;
    --spin: -20deg;
  }
  .ground {
    position: absolute;
    inset: 0;
  }
  .ground-rule {
    stroke: rgb(255 196 148 / 0.3);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .column {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 2px;
    height: 0;
    translate: -50% 0;
    transform: rotateZ(calc(-1 * var(--spin))) rotateX(calc(-1 * var(--tilt)));
    transform-origin: 50% 100%;
  }
  .column-shaft {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 2.5px;
    height: calc(var(--h) * var(--col-h, 9rem) * var(--depth));
    background-image: linear-gradient(to top, rgb(255 125 41 / 0.16), rgb(255 198 152 / 1));
  }
  .column-cap {
    position: absolute;
    bottom: calc(var(--h) * var(--col-h, 9rem) * var(--depth));
    left: 50%;
    width: 0.5rem;
    height: 0.5rem;
    margin-left: -0.25rem;
    border-radius: 999px;
    background-color: var(--color-amber-500);
    box-shadow: 0 0 14px 3px rgb(243 93 1 / 0.55);
  }

  /* ---------------------------------------------------------------------
     THE UNIT, AS A DRAWING — products and services.

     Three parts of one object, exploded along a datum, as outlines with
     called-out corners. A product page is about one object, so the hero
     is that object; a service page is about what the object reports, and
     the object is a fair picture of where that starts.
  --------------------------------------------------------------------- */
  [data-scene='blueprint'] {
    /* Spins in, blown apart, and pulls itself together as it lands. */
    --in-spin: 150deg;
    --in-shrink: 0.35;
    --tilt: 56deg;
    --spin: -30deg;
  }
  .part {
    position: absolute;
    inset: 0;
    transform: translateZ(calc((26px + var(--i) * 54px) * var(--depth)));
  }
  .part-edge {
    fill: none;
    stroke: color-mix(in oklab, var(--color-prime-300) calc(68% + var(--i) * 32%), transparent);
    stroke-width: calc(2.4px + var(--i) * 0.8px);
    vector-effect: non-scaling-stroke;
  }
  .part-tick {
    fill: none;
    stroke: rgb(255 228 208 / 0.95);
    stroke-width: 2.2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .part-lens {
    fill: none;
    stroke: var(--color-amber-500);
    stroke-width: 2.8;
    vector-effect: non-scaling-stroke;
  }
  .part-lens-core {
    fill: var(--color-amber-500);
  }
  /* The datum the parts are exploded along. */
  .datum {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.5px;
    height: 0;
    translate: -50% 0;
    transform: rotateZ(calc(-1 * var(--spin))) rotateX(calc(-1 * var(--tilt)));
    transform-origin: 50% 100%;
  }
  .datum::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 2px;
    height: calc(var(--datum-h, 9.4rem) * var(--depth));
    background-image: linear-gradient(
      to top,
      transparent,
      rgb(255 189 140 / 0.8) 14%,
      rgb(255 189 140 / 0.8) 90%,
      transparent
    );
  }

  /* ---------------------------------------------------------------------
     CONVERGENCE — contact.

     Eight routes, one for each industry the site serves, arriving at one
     point. Bowed alternately off their own straight line, because eight
     straight spokes is a compass rose and eight curves is traffic.
  --------------------------------------------------------------------- */
  [data-scene='converge'] {
    /* Starts flat to the reader, a map on the page, and tips back into
       perspective. */
    --in-tilt: -58deg;
    --in-spin: 18deg;
    --tilt: 64deg;
    --spin: -12deg;
  }
  .route {
    fill: none;
    stroke: url(#phs-route);
    stroke-width: calc(3.4px - mod(var(--i), 3) * 0.5px);
    stroke-linecap: round;
    stroke-opacity: calc(0.74 + mod(var(--i), 4) * 0.08);
    vector-effect: non-scaling-stroke;
  }
  /* At rest the pulse is the road: fully drawn, so the static scene is the
     finished composition rather than a road with a gap in it. */
  .pulse {
    fill: none;
    stroke: #ffe4d2;
    stroke-width: 4.2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 0.14 1;
    stroke-dashoffset: 0;
    opacity: 0;
  }
  [data-live] .pulse {
    opacity: 1;
  }
  .origin {
    fill: var(--color-prime-200);
    fill-opacity: 0.8;
  }
  .hub-ring {
    fill: rgb(243 93 1 / 0.22);
    stroke: var(--color-prime-200);
    stroke-width: 2.4;
    vector-effect: non-scaling-stroke;
  }
  .hub-core {
    fill: #fff;
    filter: url(#phs-hub);
  }

  /* =====================================================================
     THE READING PAGES. Each used to share one drawing of the land; each now
     gets a drawing of what it is about. Same rules as above: lit lines in
     a dark room, every part at its own depth, nothing a dark lump.

     Line weights carry `--lw`, so the small versions of these that sit
     beside a heading on a phone can thin their strokes with their size.
  --------------------------------------------------------------------- */
  .sheet,
  .stamp,
  .guard,
  .guard-scan,
  .medal,
  .huddle,
  .map,
  .ripple,
  .scope,
  .finds {
    position: absolute;
    inset: 0;
  }

  /* --- THE AGREEMENT — terms of service ---------------------------------
     Three sheets of one contract, the top one written, signed and sealed.
     It arrives upright, facing the reader like a page held up to be read,
     and lies down onto the desk; the text writes itself in as it does. */
  [data-scene='agreement'] {
    --tilt: 54deg;
    --spin: -16deg;
    --in-tilt: -46deg;
    --in-spin: 24deg;
    --in-shrink: 0.1;
  }
  .sheet {
    transform: translateZ(calc(var(--i) * 12px * var(--depth))) rotateZ(calc((var(--i) - 2) * 4.5deg));
  }
  .sheet-edge {
    fill: none;
    stroke: color-mix(in oklab, var(--color-prime-300) calc(40% + var(--i) * 30%), transparent);
    stroke-width: calc(2.2px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .sheet-top .sheet-edge {
    fill: rgb(255 255 255 / 0.025);
    stroke-width: calc(2.8px * var(--lw));
  }
  .sheet-line,
  .sheet-sign {
    fill: none;
    stroke: rgb(255 214 186 / 0.62);
    stroke-width: calc(2px * var(--lw));
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    /* Written in, line by line, as the page arrives. */
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - clamp(0, var(--phs-in) * 1.9 - var(--k) * 0.1, 1));
  }
  .sheet-head {
    stroke: var(--color-prime-300);
    stroke-width: calc(4.2px * var(--lw));
  }
  .sheet-sign {
    stroke: var(--color-prime-200);
    stroke-width: calc(2.4px * var(--lw));
  }
  .stamp {
    transform: translateZ(calc(34px * var(--depth)));
  }
  .stamp-ring {
    fill: rgb(243 93 1 / 0.16);
    stroke: var(--color-prime-300);
    stroke-width: calc(2.6px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .stamp-inner {
    fill: none;
    stroke: rgb(255 196 148 / 0.55);
    stroke-width: calc(1.3px * var(--lw));
    stroke-dasharray: 2 3;
    vector-effect: non-scaling-stroke;
  }
  .stamp-tick {
    fill: none;
    stroke: #fff;
    stroke-width: calc(2.8px * var(--lw));
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* --- THE SHIELD — privacy policy ---------------------------------------
     Four shields, one inside the next, each at its own height, around a
     locked core: protection as layers, which is what the policy describes.
     Rises out of the dark. */
  [data-scene='shield'] {
    --tilt: 56deg;
    --spin: -14deg;
    --in-z: -260px;
    --in-tilt: 18deg;
    --in-shrink: 0.25;
  }
  .guard {
    transform: translateZ(calc(var(--i) * 18px * var(--depth)));
  }
  .guard-edge {
    fill: none;
    stroke: color-mix(in oklab, var(--color-prime-300) calc(42% + var(--t) * 58%), transparent);
    stroke-width: calc((2.2px + var(--t) * 1.6px) * var(--lw));
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .guard-lock {
    fill: none;
    stroke: var(--color-amber-500);
    stroke-width: calc(2.6px * var(--lw));
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  /* The scan only runs while the page is being scrolled (below). */
  .guard-scan {
    transform: translateZ(calc(2px * var(--depth)));
    opacity: 0;
  }
  .scan-line {
    stroke: #ffe4d2;
    stroke-width: calc(2.2px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .scan-band {
    fill: url(#phs-scan-band);
  }

  /* --- THE SEAL — warranty ------------------------------------------------
     A rosette whose ring is five years long, one segment a year, over a
     ticked core. Spins in flat, like a medal tossed onto the table. */
  [data-scene='seal'] {
    --tilt: 52deg;
    --spin: -10deg;
    --in-spin: -140deg;
    --in-shrink: 0.3;
  }
  .medal {
    transform: translateZ(calc(var(--i) * 22px * var(--depth)));
  }
  .medal-edge {
    fill: none;
    stroke: color-mix(in oklab, var(--color-prime-300) 70%, transparent);
    stroke-width: calc(2.2px * var(--lw));
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .medal-ribbon {
    fill: none;
    stroke: rgb(255 170 110 / 0.5);
    stroke-width: calc(2px * var(--lw));
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .medal-track {
    fill: none;
    stroke: rgb(255 196 148 / 0.14);
    stroke-width: calc(6px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .medal-year {
    --lit: 1;
    fill: none;
    stroke: var(--color-prime-300);
    stroke-width: calc(6px * var(--lw));
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    opacity: calc(0.2 + 0.8 * var(--lit));
  }
  .medal-core {
    fill: rgb(243 93 1 / 0.1);
    stroke: var(--color-prime-200);
    stroke-width: calc(2.6px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .medal-rule {
    fill: none;
    stroke: rgb(255 196 148 / 0.32);
    stroke-width: calc(1.2px * var(--lw));
    stroke-dasharray: 2 4;
    vector-effect: non-scaling-stroke;
  }
  .medal-tick {
    fill: none;
    stroke: #fff;
    stroke-width: calc(5px * var(--lw));
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* --- THE TEAM — careers -------------------------------------------------
     Seven people standing round one table, each connected to it. They are
     upright in a scene that lies flat, so they turn to face the reader the
     same way the posts above do, and they stand up one after another as
     the scene arrives. */
  [data-scene='team'] {
    --tilt: 60deg;
    --spin: -20deg;
    --in-z: -200px;
    --in-tilt: 14deg;
    --in-shrink: 0.2;
  }
  .table-ring {
    fill: none;
    stroke: rgb(255 196 148 / 0.5);
    stroke-width: calc(2px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .table-outer {
    stroke: rgb(255 196 148 / 0.2);
    stroke-dasharray: 3 6;
  }
  .table-spoke {
    --conn: 1;
    fill: none;
    stroke: var(--color-prime-300);
    stroke-width: calc(2.2px * var(--lw));
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--conn));
  }
  .table-hub {
    fill: var(--color-amber-500);
  }
  .person {
    --conn: 1;
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 0;
    height: 0;
    transform: rotateZ(calc(-1 * var(--spin))) rotateX(calc(-1 * var(--tilt)));
    transform-origin: 50% 100%;
    opacity: calc(0.4 + 0.6 * var(--conn));
  }
  .person-mark {
    position: absolute;
    bottom: 0;
    left: 0;
    width: calc(2.3rem * var(--depth));
    height: calc(2.76rem * var(--depth));
    translate: -50% 0;
    overflow: visible;
    fill: none;
    stroke: var(--color-prime-200);
    stroke-width: calc(2.4px * var(--lw));
    stroke-linecap: round;
    transform-origin: 50% 100%;
    scale: clamp(0, var(--phs-in) * 1.9 - var(--i) * 0.13, 1);
  }
  .person-mark * {
    vector-effect: non-scaling-stroke;
  }

  /* --- THE MANUAL — support manuals and documents ------------------------
     An open book on the desk, its pages fanned across the spine. Each page
     is hinged at the spine, so turning one is a single rotation. */
  [data-scene='manual'] {
    --tilt: 50deg;
    --spin: -14deg;
    --in-tilt: -40deg;
    --in-spin: 30deg;
    --in-shrink: 0.15;
  }
  .leaf {
    position: absolute;
    top: 25%;
    width: 28.3%;
    height: 50%;
  }
  .leaf svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .leaf-left {
    left: 21.7%;
    transform-origin: 100% 50%;
    transform: rotateY(14deg);
  }
  .leaf-right {
    left: 50%;
    transform-origin: 0 50%;
    transform: rotateY(-14deg);
  }
  /* At rest the five pages are fanned from right to left. */
  .leaf-page {
    --flip: calc(var(--k) * 0.25);
    left: 50%;
    transform-origin: 0 50%;
    transform: translateZ(1px) rotateY(calc(-17deg - var(--flip) * 146deg));
  }
  .leaf-edge {
    fill: none;
    stroke: color-mix(in oklab, var(--color-prime-300) 68%, transparent);
    stroke-width: calc(2.2px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .leaf-page .leaf-edge {
    fill: rgb(16 17 22 / 0.62);
    stroke: color-mix(in oklab, var(--color-prime-200) 72%, transparent);
  }
  .leaf-line {
    fill: none;
    stroke: rgb(255 214 186 / 0.5);
    stroke-width: calc(1.6px * var(--lw));
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .leaf-head {
    stroke: var(--color-prime-300);
    stroke-width: calc(3px * var(--lw));
  }
  .spine {
    position: absolute;
    left: 50%;
    top: 24%;
    width: 2px;
    height: 52%;
    translate: -50% 0;
    background-image: linear-gradient(transparent, rgb(255 189 140 / 0.9) 12%, rgb(255 189 140 / 0.9) 88%, transparent);
  }

  /* --- THE SIGNAL — blog index and articles -------------------------------
     What every article is about: a vehicle located, at the end of its
     route, signalling. PrimeTrack's own mark, standing on a map. */
  [data-scene='signal'] {
    --tilt: 58deg;
    --spin: -24deg;
    --in-z: 120px;
    --in-tilt: -30deg;
    --in-shrink: 0.1;
  }
  .map-rule {
    fill: none;
    stroke: rgb(255 196 148 / 0.13);
    stroke-width: calc(1.2px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .map-route {
    fill: none;
    stroke: url(#phs-signal-route);
    stroke-width: calc(3.4px * var(--lw));
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    /* The route drives itself in as the scene arrives. */
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--phs-in));
  }
  .map-start {
    fill: var(--color-prime-200);
    fill-opacity: 0.8;
  }
  .map-spot {
    fill: var(--color-amber-500);
  }
  .ripple {
    transform: translateZ(calc(2px * var(--depth))) scale(calc(0.3 + var(--k) * 0.45));
    opacity: calc(0.8 - var(--k) * 0.25);
  }
  .ripple circle {
    fill: none;
    stroke: var(--color-prime-300);
    stroke-width: calc(2px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .pin {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 0;
    height: 0;
    transform: rotateZ(calc(-1 * var(--spin))) rotateX(calc(-1 * var(--tilt)));
    transform-origin: 50% 100%;
  }
  .pin-mark {
    position: absolute;
    bottom: 0;
    left: 0;
    width: calc(3.2rem * var(--depth));
    height: calc(4.48rem * var(--depth));
    translate: -50% 0;
    overflow: visible;
    fill: rgb(243 93 1 / 0.2);
    stroke: var(--color-prime-200);
    stroke-width: calc(2.6px * var(--lw));
    stroke-linejoin: round;
  }
  .pin-mark * {
    vector-effect: non-scaling-stroke;
  }
  .pin-eye {
    fill: #fff;
    stroke: none;
  }

  /* --- THE RADAR — analyse your fleet --------------------------------------
     A scope, a sweep, and the vehicles it finds; the two that need
     attention are flagged in amber and stand up off the scope. Spins in. */
  [data-scene='radar'] {
    --tilt: 58deg;
    --spin: -18deg;
    --in-spin: -120deg;
    --in-tilt: 12deg;
    --in-shrink: 0.2;
    /* Where the sweep is, in degrees clockwise from the top. */
    --sw: 330;
  }
  .scope-ring {
    fill: none;
    stroke: rgb(255 196 148 / 0.26);
    stroke-width: calc(1.6px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .scope-rim {
    stroke: color-mix(in oklab, var(--color-prime-300) 80%, transparent);
    stroke-width: calc(2.6px * var(--lw));
  }
  .scope-cross {
    stroke: rgb(255 196 148 / 0.18);
    stroke-width: calc(1.2px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .scope-tick {
    stroke: rgb(255 196 148 / 0.45);
    stroke-width: calc(1.4px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .sweep {
    position: absolute;
    left: 50%;
    top: 50%;
    height: 80%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    transform: translateZ(calc(3px * var(--depth))) rotate(calc(var(--sw) * 1deg));
    background-image: conic-gradient(
      from 0deg,
      transparent 0deg 250deg,
      rgb(255 125 41 / 0.05) 290deg,
      rgb(255 140 60 / 0.42) 360deg
    );
  }
  .sweep-arm {
    position: absolute;
    left: 50%;
    top: 0;
    width: 2px;
    height: 50%;
    translate: -50% 0;
    background-image: linear-gradient(to top, rgb(255 228 210 / 0.15), #ffe4d2);
  }
  .finds {
    transform: translateZ(calc(5px * var(--depth)));
  }
  .blip {
    --seen: 1;
    opacity: calc(0.16 + 0.84 * var(--seen));
  }
  .blip-dot {
    fill: var(--color-prime-200);
  }
  .blip-flag .blip-dot {
    fill: var(--color-amber-500);
  }
  .blip-ring {
    fill: none;
    stroke: var(--color-amber-500);
    stroke-width: calc(2px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .beacon {
    --seen: 1;
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 2px;
    height: 0;
    translate: -50% 0;
    transform: rotateZ(calc(-1 * var(--spin))) rotateX(calc(-1 * var(--tilt)));
    transform-origin: 50% 100%;
  }
  .beacon::before,
  .beacon::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .beacon::before {
    bottom: 0;
    width: 2px;
    height: calc(var(--seen) * 4.2rem * var(--depth));
    background-image: linear-gradient(to top, rgb(255 125 41 / 0.15), rgb(255 200 150 / 1));
  }
  .beacon::after {
    bottom: calc(var(--seen) * 4.2rem * var(--depth));
    width: 0.5rem;
    height: 0.5rem;
    margin: 0 0 -0.25rem -0.2rem;
    border-radius: 999px;
    background-color: var(--color-amber-500);
    box-shadow: 0 0 12px 3px rgb(243 93 1 / 0.55);
    opacity: var(--seen);
  }

  /* --- THE WHEEL — the personal driver advert --------------------------
     A steering wheel standing nearly upright, the way a driver sees it,
     with the road laid out flat beneath it. The scene's camera barely
     tilts; the road is tipped down on its own so it reads as ground. The
     wheel sways a little on its own, as hands on a wheel do on an open
     road, and the lane markings run towards the reader: the only two
     things in any of these scenes that move without the scroll, so the
     scene is marked `data-ambient` and stops when it is off screen.
     It arrives from far off, spinning, and settles. */
  [data-scene='drive'] {
    --tilt: 16deg;
    --spin: 0deg;
    --in-z: -360px;
    --in-tilt: -10deg;
    --in-shrink: 0.3;
    --steer: 0deg;
  }
  .road,
  .wheel,
  .wheel-layer {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  /* Hinged at its near end, which sits just under the wheel's rim, and
     tipped away so it runs off behind the wheel into the distance. */
  .road {
    transform-origin: 50% 100%;
    transform: translateY(6%) translateZ(calc(-40px * var(--depth))) rotateX(66deg);
  }
  .road-edge {
    fill: none;
    stroke: url(#phs-road-fade);
    stroke-width: calc(2.6px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .road-shoulder {
    fill: none;
    stroke: rgb(255 196 148 / 0.16);
    stroke-width: calc(1.4px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .road-lane {
    fill: none;
    stroke: #ffd7bd;
    stroke-width: calc(3.2px * var(--lw));
    stroke-linecap: round;
    stroke-dasharray: 26 30;
    vector-effect: non-scaling-stroke;
  }

  /* The wheel turns about its own centre: by the arrival's spin, by the
     scroll (`--steer`, below), and by the sway, which rides on the
     separate `rotate` property so the three add up. */
  .wheel {
    transform: rotateZ(calc(var(--steer) + (1 - var(--phs-in)) * -220deg));
  }
  .wheel-layer {
    transform: translateZ(calc(var(--i) * 14px * var(--depth)));
  }
  .wheel-rim {
    fill: none;
    stroke: color-mix(in oklab, var(--color-prime-300) 52%, transparent);
    stroke-width: calc(2.2px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .wheel-rim-front {
    stroke: color-mix(in oklab, var(--color-prime-200) 88%, transparent);
    stroke-width: calc(3px * var(--lw));
  }
  .wheel-stitch {
    fill: none;
    stroke: rgb(255 196 148 / 0.22);
    stroke-width: calc(1.2px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .wheel-grip {
    fill: none;
    stroke: var(--color-prime-400);
    stroke-width: calc(9px * var(--lw));
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .wheel-mark {
    fill: none;
    stroke: #fff;
    stroke-width: calc(5px * var(--lw));
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .wheel-spoke {
    fill: rgb(14 15 19 / 0.55);
    stroke: color-mix(in oklab, var(--color-prime-300) 80%, transparent);
    stroke-width: calc(2.4px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .wheel-hub {
    fill: rgb(243 93 1 / 0.14);
    stroke: var(--color-prime-200);
    stroke-width: calc(2.8px * var(--lw));
    vector-effect: non-scaling-stroke;
  }
  .wheel-hub-ring {
    fill: none;
    stroke: rgb(255 196 148 / 0.55);
    stroke-width: calc(1.4px * var(--lw));
    stroke-dasharray: 3 4;
    vector-effect: non-scaling-stroke;
  }
  .wheel-hub-core {
    fill: var(--color-amber-500);
  }

  @media (prefers-reduced-motion: no-preference) {
    .road-lane {
      animation: drive-lane 1.1s linear infinite;
    }
    .wheel {
      animation: drive-sway 7s ease-in-out infinite;
    }
  }
  @keyframes drive-lane {
    from {
      stroke-dashoffset: 0;
    }
    to {
      stroke-dashoffset: -56;
    }
  }
  @keyframes drive-sway {
    0%,
    100% {
      rotate: -5deg;
    }
    50% {
      rotate: 6deg;
    }
  }

  /* ---------------------------------------------------------------------
     RECOMPOSED, NOT HIDDEN. Under the copy as its own band, smaller, and
     with most of the relief taken out: at this width the scene is read at
     a glance on the way past rather than studied.
  --------------------------------------------------------------------- */
  @media (width < 64rem) {
    .phs {
      max-width: 18rem;
      --depth: 0.58;
      --post-h: 4.4rem;
      --col-h: 4.2rem;
      --datum-h: 5.6rem;
    }
  }

  /* COMPACT: the reading pages' version, beside the heading. It fills the
     box the hero gives it, and its depth and line weight come down in step
     with that box (23rem on a wide screen, 17rem on a tablet, 11.5rem on a
     phone, against the 32rem the full scene is drawn for). */
  .phs[data-compact] {
    max-width: none;
    --depth: 0.72;
    --lw: 1;
  }
  @media (width < 64rem) {
    .phs[data-compact] {
      --depth: 0.53;
      --lw: 0.95;
    }
  }
  @media (width < 40rem) {
    .phs[data-compact] {
      --depth: 0.36;
      --lw: 0.82;
    }
  }

  /* =====================================================================
     DRIVEN. Everything above is the finished, static composition; nothing
     below applies until the handler has attached, so reduced motion, a
     failed script and a blocked module all leave a complete scene.

     Every camera here swings on `--s`, which is what buys the parallax: at
     a given sweep the near parts of a scene travel several times as far
     across the screen as the far ones, and that difference is the only
     depth cue in a browser the eye really trusts.
  --------------------------------------------------------------------- */

  /* `--t` IS NOT JUST `--s` RESCALED. A hero sits at the top of its page,
     so it is already on screen when the page loads and can never play an
     "entering" half: at load `--s` is about 0.2 and only ever climbs.
     Mapping events to (s+1)/2 spent half of every event on scroll
     positions that do not exist, so each one arrived half-finished. This
     is the band actually available — load to gone — mapped onto 0..1. */
  .phs[data-live] {
    --t: clamp(0, (var(--s, 0) - 0.12) * 1.15, 1);
    /* The reading pages' event clock. Their heroes are short and sit high,
       so the scroll alone would leave each one barely started on arrival
       (an empty radar, an unlit seal). A third of the event plays as the
       scene arrives and the scroll does the rest. */
    --e: min(1, var(--t) * 0.72 + var(--phs-in) * 0.3);
  }

  /* The platform fans into its layers. */
  [data-live][data-scene='layers'] {
    --tilt: calc(64deg - var(--s, 0) * 24deg);
    --spin: calc(-36deg + var(--s, 0) * 48deg);
  }
  [data-live][data-scene='layers'] .plate {
    transform: translateZ(calc(var(--i) * (10px + var(--t) * 34px) * var(--depth) * (0.2 + 0.8 * var(--phs-in))));
  }
  [data-live][data-scene='layers'] .post::before {
    height: calc((2.2rem + 6.6rem * var(--t)) * var(--depth));
  }

  /* The operations rise off the ground, each at its own rate, so the
     skyline builds rather than switching on. */
  [data-live][data-scene='field'] {
    --tilt: calc(70deg - var(--s, 0) * 24deg);
    --spin: calc(-30deg + var(--s, 0) * 48deg);
    /* Floored at half height. The event is the skyline BUILDING, and a
       skyline that starts at nothing is an empty scene for whoever lands
       on the page and does not scroll. */
    --rise: calc((0.5 + var(--t) * 0.5) * (0.08 + 0.92 * var(--phs-in)));
  }
  [data-live][data-scene='field'] .column-shaft {
    height: calc(var(--h) * var(--col-h, 7rem) * var(--depth) * var(--rise));
  }
  [data-live][data-scene='field'] .column-cap {
    bottom: calc(var(--h) * var(--col-h, 7rem) * var(--depth) * var(--rise));
  }

  /* The unit puts itself together: blown open at the bottom of the
     viewport, assembled by the time the scene reaches the top. The one
     event here that is a mechanism rather than a light, and it is on the
     product pages because that is what a product page is about. */
  [data-live][data-scene='blueprint'] {
    --tilt: calc(60deg - var(--s, 0) * 24deg);
    --spin: calc(-38deg + var(--s, 0) * 46deg);
    --sep: calc(1.15 - var(--t) * 1 + (1 - var(--phs-in)) * 1.6);
  }
  [data-live][data-scene='blueprint'] .part {
    transform: translateZ(calc((26px + var(--i) * 54px * var(--sep)) * var(--depth)));
  }
  [data-live][data-scene='blueprint'] .datum::before {
    height: calc((2.4rem + 7rem * var(--sep)) * var(--depth));
  }

  /* Eight arrivals, in sequence. A 14% dash on a `pathLength="1"` road,
     offset by `--t` and staggered by index so the eight do not pulse in
     unison. */
  [data-live][data-scene='converge'] {
    --tilt: calc(68deg - var(--s, 0) * 22deg);
    --spin: calc(-20deg + var(--s, 0) * 40deg);
  }
  [data-live][data-scene='converge'] .pulse {
    stroke-dashoffset: calc(0.07 - var(--t) * 1.5 + var(--i) * 0.055);
  }
  [data-live][data-scene='converge'] .hub-ring {
    r: calc(17px + var(--t) * 7px);
    stroke-opacity: calc(0.55 + var(--t) * 0.45);
  }

  /* The contract fans a little as it is read, and the seal comes down onto
     the top sheet: hovering when the page arrives, pressed home by the time
     the reader is into the terms. */
  [data-live][data-scene='agreement'] {
    --tilt: calc(58deg - var(--s, 0) * 20deg);
    --spin: calc(-24deg + var(--s, 0) * 34deg);
  }
  [data-live][data-scene='agreement'] .sheet {
    transform: translateZ(calc(var(--i) * (6px + var(--e) * 16px) * var(--depth)))
      rotateZ(calc((var(--i) - 2) * (3deg + var(--e) * 4deg)));
  }
  [data-live][data-scene='agreement'] .stamp {
    transform: translateZ(calc((2 * (6px + var(--e) * 16px) + 4px + (1 - var(--e)) * 96px) * var(--depth)));
    opacity: calc(0.35 + 0.65 * var(--e));
  }

  /* The shields lift apart around the lock, and a scan passes over them. */
  [data-live][data-scene='shield'] {
    --tilt: calc(60deg - var(--s, 0) * 20deg);
    --spin: calc(-22deg + var(--s, 0) * 36deg);
  }
  [data-live][data-scene='shield'] .guard {
    transform: translateZ(calc(var(--i) * (8px + var(--e) * 26px) * var(--depth) * (0.25 + 0.75 * var(--phs-in))));
  }
  [data-live][data-scene='shield'] .guard-scan {
    opacity: calc(min(1, var(--e) * 6) * (1 - max(0, var(--e) - 0.88) * 8));
  }
  [data-live][data-scene='shield'] .guard-scan g > * {
    transform: translateY(calc(58px + var(--e) * 300px));
  }

  /* The five years light one after another as the page is read. */
  [data-live][data-scene='seal'] {
    --tilt: calc(58deg - var(--s, 0) * 22deg);
    --spin: calc(-18deg + var(--s, 0) * 40deg);
  }
  [data-live][data-scene='seal'] .medal {
    transform: translateZ(calc(var(--i) * (10px + var(--e) * 22px) * var(--depth)));
  }
  [data-live][data-scene='seal'] .medal-year {
    --lit: clamp(0, var(--e) * 6 - var(--k) * 1.1, 1);
  }

  /* Each person is connected to the table in turn. */
  [data-live][data-scene='team'] {
    --tilt: calc(64deg - var(--s, 0) * 20deg);
    --spin: calc(-30deg + var(--s, 0) * 44deg);
  }
  [data-live][data-scene='team'] :is(.table-spoke, .person) {
    --conn: clamp(0, var(--e) * 2.2 + 0.3 - var(--i) * 0.16, 1);
  }

  /* The pages turn, one after another, from right to left. */
  [data-live][data-scene='manual'] {
    --tilt: calc(54deg - var(--s, 0) * 18deg);
    --spin: calc(-22deg + var(--s, 0) * 30deg);
  }
  [data-live][data-scene='manual'] .leaf-page {
    --flip-t: clamp(0, var(--e) * 5.2 - var(--k) * 0.95, 1);
    --flip: calc(var(--flip-t) * var(--flip-t) * (3 - 2 * var(--flip-t)));
  }

  /* The signal goes out in rings, and the pin lifts as it does. */
  [data-live][data-scene='signal'] {
    --tilt: calc(62deg - var(--s, 0) * 20deg);
    --spin: calc(-32deg + var(--s, 0) * 40deg);
  }
  [data-live][data-scene='signal'] .ripple {
    --wave: mod(calc(var(--e) * 1.6 + var(--k) / 3), 1);
    transform: translateZ(calc(2px * var(--depth))) scale(calc(0.15 + var(--wave) * 1.45));
    opacity: calc((1 - var(--wave)) * 0.9);
  }
  [data-live][data-scene='signal'] .pin-mark {
    translate: -50% calc(var(--e) * -14px * var(--depth));
  }

  /* The sweep goes round, and finds the fleet as it passes. */
  [data-live][data-scene='radar'] {
    --tilt: calc(62deg - var(--s, 0) * 18deg);
    --spin: calc(-24deg + var(--s, 0) * 20deg);
    --sw: calc(10 + var(--e) * 330);
  }
  [data-live][data-scene='radar'] :is(.blip, .beacon) {
    --seen: clamp(0, (var(--sw) - var(--a)) / 22, 1);
  }

  /* The wheel is turned into a bend as the page is read, and the camera
     drops a little towards the road. */
  [data-live][data-scene='drive'] {
    --tilt: calc(20deg - var(--s, 0) * 12deg);
    --steer: calc(var(--t) * -100deg);
  }

  /* The composition is finished at rest, so this only ever removes the
     arrival, never the scene. The handler declines to attach at all. */
  @media (prefers-reduced-motion: reduce) {
    .phs {
      animation: none;
    }
  }
</style>

<script>
  /**
   * Drives every hero scene on the page.
   *
   * Writes ONE custom property per scene, `--s`: how far that scene has
   * travelled up the viewport, -1 at the bottom edge, 0 dead centre, +1 at
   * the top. Where the camera points and what each scene is doing are both
   * derived from it in CSS; nothing here knows about plates, columns or
   * parts.
   *
   * One handler for every scene rather than one per scene, and an
   * IntersectionObserver keeps the per-frame loop to the scenes actually on
   * screen — which, on these pages, is at most one. Reads are batched into a
   * requestAnimationFrame, so a scroll burst costs one layout read per frame
   * however fast the wheel is turning.
   *
   * `data-live` is only set once this runs, and every rule that moves
   * anything is scoped to it. If the script never executes, if the module is
   * blocked, or if the visitor has asked for reduced motion, the scene
   * renders as the finished static composition rather than as a broken one.
   */
  const scenes = Array.from(document.querySelectorAll<HTMLElement>('.phs'));

  if (scenes.length && 'IntersectionObserver' in window) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const live = new Set<HTMLElement>();
    let frame = 0;

    const update = () => {
      frame = 0;
      const vh = window.innerHeight || 1;
      for (const el of live) {
        const rect = el.getBoundingClientRect();
        const mid = rect.top + rect.height / 2;
        const s = Math.max(-1, Math.min(1, 1 - (2 * mid) / vh));
        el.style.setProperty('--s', s.toFixed(4));
      }
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    /* A generous margin so a scene is already being driven by the time its
       first pixel is visible, and never arrives mid-pose. */
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) live.add(entry.target as HTMLElement);
          else live.delete(entry.target as HTMLElement);
        }
        schedule();
      },
      { rootMargin: '30% 0px' },
    );

    const apply = () => {
      if (still.matches) {
        window.removeEventListener('scroll', schedule);
        window.removeEventListener('resize', schedule);
        live.clear();
        for (const el of scenes) {
          seen.unobserve(el);
          el.removeAttribute('data-live');
          el.style.removeProperty('--s');
        }
        return;
      }
      for (const el of scenes) {
        el.setAttribute('data-live', '');
        seen.observe(el);
      }
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule, { passive: true });
      schedule();
    };

    still.addEventListener('change', apply);
    apply();
  }
</script>
