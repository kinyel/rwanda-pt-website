---
/**
 * The standard conversion block, used at the foot of most pages.
 * Two actions only: the form, and WhatsApp. Anything more dilutes both.
 */
import Button from './Button.astro';
import { company } from '../data/company';
import { routes } from '../data/navigation';
import { useTranslations, localizePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  eyebrow?: string;
  title: string;
  body?: string;
}

const { locale, eyebrow, title, body } = Astro.props;
const t = useTranslations(locale);
---

<section data-nav="dark" class="on-dark relative overflow-hidden bg-ink-950 bg-contour-prime">
  <div class="absolute inset-0 bg-prime-glow" aria-hidden="true"></div>
  <div class="container-prime relative py-16 sm:py-20 lg:py-24">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:items-end">
      <div>
        {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
        <h2 class="text-h2 text-white">{title}</h2>
        {body && <p class="mt-5 measure text-lead text-ink-300">{body}</p>}
      </div>

      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:items-stretch">
        <Button href={localizePath(routes.contact, locale)} variant="primary" size="lg">
          {t.home.finalCta.primary}
        </Button>
        <Button href={company.whatsappUrl} variant="onDark" size="lg" external>
          {t.home.finalCta.secondary}
        </Button>
      </div>
    </div>
  </div>
</section>
