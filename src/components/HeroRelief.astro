---
/**
 * A thousand hills, as an object you could pick up.
 *
 * THE IDEA. Rwanda is the land of a thousand hills, and the design system
 * already treats contour geometry as the local substrate for an honest
 * reason: gradient drives fuel burn and hills drive route times. The previous
 * attempt drew those contours as flat silhouettes behind the copy, which is a
 * backdrop, not a centrepiece.
 *
 * This is the same idea built as a THING: a laminated topographic relief
 * model, the kind that gets laser-cut from stacked plates, floating in space
 * and turning as you scroll. Every contour is a real plate at its own
 * elevation with a visible cut edge, so the hills have thickness you can read
 * rather than a shape you have to infer. The route is cut across the surface,
 * the vehicle runs it, and each stop sends a signal up off the model.
 *
 * Nigeria's hero is a radar sweeping a flat plane. Rwanda's is a landscape
 * with altitude. That is the whole difference between the siblings.
 *
 * WHY IT IS GENUINELY 3D AND NOT A DRAWING OF 3D. Every plate sits at its own
 * `translateZ` inside one `preserve-3d` model under a shared `perspective`,
 * and the model is tilted on `rotateX`. The browser projects the stack, so the
 * plates occlude each other correctly, the cut edges foreshorten as the model
 * turns, and the whole thing parallaxes for free. Nothing here is a painted
 * highlight pretending to be depth.
 *
 * COST. No WebGL, no 3D library, no model file, no images, and no JavaScript
 * of its own. It reads the `--p` the hero already publishes. Transform and
 * opacity only.
 */
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';

interface Props {
  locale: Locale;
  /** Waypoints, so the model's stops stay in step with the report strip. */
  waypoints: readonly { key: string; at: number; x: number; y: number }[];
}

const { locale, waypoints } = Astro.props as Props;
const t = useTranslations(locale);
const j = t.home.journey;
const stops = j.waypoints as Record<string, { label: string; refrain: string }>;

/* ---------------------------------------------------------------------------
   The contours.

   Generated rather than hand-drawn, because ten nested organic outlines
   authored by hand drift out of nesting and the error only shows up as a
   plate poking through the one above it. A deterministic generator cannot
   make that mistake: every level shrinks, so every level sits inside its
   neighbour by construction.

   Two sine terms at different frequencies give ridges and spurs instead of a
   smooth cone, and the phase shifts with elevation so the peaks lean, the way
   a real ridgeline does rather than a wedding cake.
--------------------------------------------------------------------------- */
const LEVELS = 9;
/* Elevation gained per contour, and how many copies build the wall between
   one contour and the next. */
const LIFT = 16;
const SKIN = 5;

function contour(level: number): string {
  const steps = 44;
  const t = level / (LEVELS - 1);
  /* Shrinks fast at first and then slows, so the base is broad and the summit
     plates stack tightly: the profile of a hill, not a pyramid. */
  const radius = 168 * (1 - t) ** 0.78 + 18;
  const pts: [number, number][] = [];

  for (let i = 0; i < steps; i++) {
    const a = (i / steps) * Math.PI * 2;
    const ridge =
      1 +
      0.17 * Math.sin(a * 3 + level * 0.55) +
      0.10 * Math.sin(a * 5 - level * 0.38) +
      0.06 * Math.sin(a * 8 + level * 0.9);
    const r = radius * ridge;
    /* Squashed on y because the plate is seen through a steep rotateX; this
       keeps the footprint roughly circular once projected. */
    pts.push([200 + Math.cos(a) * r, 200 + Math.sin(a) * r * 0.82]);
  }

  /* Closed quadratic spline through the midpoints. Straight segments between
     44 points still read as faceted at this size; routing each curve through
     a midpoint smooths the outline without needing control points. */
  const mid = (p: [number, number], q: [number, number]) =>
    [(p[0] + q[0]) / 2, (p[1] + q[1]) / 2] as [number, number];
  const f = (n: number) => n.toFixed(1);

  let d = `M${f(mid(pts[steps - 1], pts[0])[0])} ${f(mid(pts[steps - 1], pts[0])[1])}`;
  for (let i = 0; i < steps; i++) {
    const m = mid(pts[i], pts[(i + 1) % steps]);
    d += `Q${f(pts[i][0])} ${f(pts[i][1])} ${f(m[0])} ${f(m[1])}`;
  }
  return d + 'Z';
}

/* EXTRUSION.

   One outline per contour reads as a floating ring, not as rock: you see the
   top faces and straight through the gap to the plate below, which is what
   made the first version look unfinished. CSS has no solid geometry, so the
   wall between two contours is built the only way it can be, by repeating the
   same outline at small z increments until the copies close the gap. Five
   copies over a 16px rise leaves 3.2px between them, which at this tilt is
   below the point where a seam is visible.

   Only the last copy of each contour is a top face; the rest are wall, and
   darker, so the model has treads and risers rather than one flat mass. */
const plates: { d: string; z: number; t: number; face: boolean }[] = [];
for (let i = 0; i < LEVELS; i++) {
  const d = contour(i);
  const t = i / (LEVELS - 1);
  for (let k = 0; k < SKIN; k++) {
    plates.push({ d, t, z: i * LIFT + (k * LIFT) / SKIN, face: k === SKIN - 1 });
  }
}

/* The route, cut across the surface. Lives on the top plate's plane. */
const ROUTE = 'M 52 300 C 118 286, 146 246, 196 232 S 286 206, 306 150 S 288 86, 236 66';
---

<div class="relief" aria-hidden="true">
  <div class="relief-model">
    <!-- The hills. Far plate first so the DOM order matches the stack. -->
    {
      plates.map((plate, k) => (
        <div class="plate" data-face={plate.face ? '' : undefined} style={`--z:${plate.z}; --t:${plate.t}`}>
          <svg viewBox="0 0 400 400" focusable="false">
            <path d={plate.d} />
          </svg>
        </div>
      ))
    }

    <!-- The route, and everything that rides it, on one plane above the
         summit so nothing z-fights with the top plate. -->
    <div class="relief-surface">
      <svg viewBox="0 0 400 400" focusable="false">
        <defs>
          <linearGradient id="relief-route" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0%" stop-color="#ff8c00" />
            <stop offset="100%" stop-color="#f35d01" />
          </linearGradient>
          <filter id="relief-glow" x="-80%" y="-80%" width="260%" height="260%">
            <feGaussianBlur stdDeviation="4" result="b" />
            <feMerge>
              <feMergeNode in="b" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        <path class="route-bed" d={ROUTE} />
        <path class="route-lit" d={ROUTE} pathLength="1" />

        {
          waypoints.map((point) => (
            <g class="node" style={`--at:${point.at / 100}`}>
              <circle class="node-ring" cx={point.x} cy={point.y} r="13" />
              <circle class="node-core" cx={point.x} cy={point.y} r="4" />
            </g>
          ))
        }

        <g class="rover">
          <circle r="11" class="rover-halo" />
          <circle r="4.5" class="rover-core" />
        </g>
      </svg>
    </div>

    <!-- Signal. A beam standing off each stop, which only reads as a beam
         because the model is tilted: on a flat drawing it would be a stick. -->
    {
      waypoints.map((point, i) => (
        <div
          class="beam"
          style={`--at:${point.at / 100}; --bx:${(point.x / 400) * 100}%; --by:${(point.y / 400) * 100}%; --mast:${[6.4, 7.2, 6.4, 7.2][i]}`}
        >
          <span class="beam-shaft"></span>
          <span class="beam-cap"></span>
          <span class="beam-label">
            <span class="beam-label-name">{stops[point.key].label}</span>
            <span class="beam-label-line">{stops[point.key].refrain}</span>
          </span>
        </div>
      ))
    }
  </div>

  <!-- Ground shadow, flat on the floor the model floats above. -->
  <span class="relief-shadow"></span>
</div>

<style>
  .relief {
    /* Plate count, so the surface and the beams can sit on top of the stack
       without the elevation being written out three times. */
    --levels: 11;
    /* Which contour the road is cut into. Low enough that the upper plates
       cross in front of it, which is what makes it read as lying ON the
       terrain rather than hovering over it. */
    --road-level: 3;
    /* THE CAMERA, as two numbers.

       The model turns on these and every upright element counter-rotates by
       the negative of them to face the viewer. Written out twice they would
       drift apart the moment the scroll animation changed one of them, and
       labels that are a few degrees off-camera look like a bug rather than a
       style. */
    --tilt: 58deg;
    --spin: -26deg;
    /* Must track LIFT in the frontmatter: the road and the beams sit on a
       contour, so they move when the contour spacing does. */
    --lift: 16px;
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    perspective: 1500px;
    perspective-origin: 50% 44%;
    pointer-events: none;
  }

  /* The model. One 3D context: every plate, the surface and every beam are
     projected together, so they occlude each other correctly and the cut
     edges foreshorten as it turns. */
  .relief-model {
    position: relative;
    width: min(100%, 38rem);
    aspect-ratio: 1;
    transform-style: preserve-3d;
    /* Resting pose. Steep enough to see the lamination, shallow enough that
       the footprint is still legible as a map. */
    transform: rotateX(var(--tilt)) rotateZ(var(--spin));
    will-change: transform;
  }

  .plate,
  .relief-surface {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .plate svg,
  .relief-surface svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .plate {
    transform: translateZ(calc(var(--z) * 1px));
  }

  /* WALL. The four copies that build the riser between two contours. Darker
     than the tread above them and unstroked, so the stack reads as one solid
     mass with steps cut into it rather than as 45 separate outlines. */
  .plate path {
    fill: color-mix(in oklab, #2b3340 calc(var(--t) * 70%), #0b0e13);
    stroke: none;
  }

  /* TREAD. The last copy of each contour is the surface you would stand on,
     so it is lighter and carries the cut line that makes the lamination
     legible. */
  .plate[data-face] path {
    fill: color-mix(in oklab, #46525f calc(var(--t) * 88%), #141921);
    stroke: color-mix(in oklab, var(--color-prime-400) calc(22% + var(--t) * 50%), transparent);
    stroke-width: 1.1;
    vector-effect: non-scaling-stroke;
  }

  /* The summit catches the warm light directly. */
  .plate:last-of-type path {
    fill: color-mix(in oklab, var(--color-prime-500) 20%, #4d596a);
  }

  .relief-surface {
    transform: translateZ(calc(var(--road-level) * var(--lift) + 1px));
  }

  .route-bed {
    fill: none;
    stroke: rgb(255 214 184 / 0.28);
    stroke-width: 5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .route-lit {
    fill: none;
    stroke: url(#relief-route);
    stroke-width: 3;
    stroke-linecap: round;
    filter: url(#relief-glow);
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .node-ring {
    fill: none;
    stroke: var(--color-prime-400);
    stroke-opacity: 0.55;
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }
  .node-core {
    fill: var(--color-prime-400);
  }

  .rover {
    offset-path: path('M 52 300 C 118 286, 146 246, 196 232 S 286 206, 306 150 S 288 86, 236 66');
    offset-distance: 100%;
    offset-rotate: 0deg;
  }
  .rover-halo { fill: var(--color-prime-500); fill-opacity: 0.22; }
  .rover-core { fill: #fff; filter: url(#relief-glow); }

  /* A beam stands UP out of the model, so it is a child of the 3D context
     with its own rotateX cancelling the model's tilt. Drawn flat it would
     just be a line lying on the map. */
  .beam {
    position: absolute;
    left: var(--bx);
    top: var(--by);
    width: 2px;
    height: 0;
    transform: translate(-50%, 0)
               translateZ(calc(var(--road-level) * var(--lift)))
               rotateZ(calc(-1 * var(--spin)))
               rotateX(calc(-1 * var(--tilt)));
    transform-origin: 50% 100%;
  }
  .beam-shaft {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 2px;
    height: calc(var(--mast, 5.5) * 1rem * var(--mast-k, 1));
    background-image: linear-gradient(to top, var(--color-prime-400), transparent);
    opacity: 0.5;
  }
  .beam-cap {
    position: absolute;
    bottom: calc(var(--mast, 5.5) * 1rem * var(--mast-k, 1));
    left: 50%;
    width: 0.45rem;
    height: 0.45rem;
    margin-left: -0.225rem;
    border-radius: 999px;
    background-color: var(--color-prime-400);
    box-shadow: 0 0 10px 2px rgb(243 93 1 / 0.55);
  }

  /* THE CHECKPOINT CARD.

     Sits at the head of its beam, inside the beam's counter-rotated space,
     so it faces the viewer however the model is turned. It pops when the
     rover reaches the stop and then stays: by the end of the hero all four
     are standing, which is the record of the trip rather than a caption that
     flashes past.

     `translate(-50%)` cannot go in the same transform as the counter-rotation
     on the beam, or it would be rotated too, so the card does its own
     centring in its own space. */
  .beam-label {
    position: absolute;
    /* Each mast is a different height, so four cards cannot pile up on one
       another when they are all standing at the end of the trip. */
    bottom: calc(var(--mast, 5.5) * 1rem * var(--mast-k, 1) + 0.9rem);
    left: 50%;
    display: block;
    width: max-content;
    max-width: 8.5rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 0.5rem;
    background-color: rgb(12 15 20 / 0.86);
    box-shadow: 0 10px 28px -14px rgb(0 0 0 / 0.9);
    text-align: left;
    transform: translate(-50%, 0) scale(var(--pop, 1));
    transform-origin: 50% 100%;
    backdrop-filter: blur(6px);
  }
  .beam-label-name {
    display: block;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-prime-400);
  }
  .beam-label-line {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.25;
    color: #fff;
    text-wrap: balance;
  }

  .relief-shadow {
    position: absolute;
    left: 50%;
    top: 68%;
    width: min(74%, 27rem);
    height: 7rem;
    transform: translate(-50%, 0);
    border-radius: 999px;
    background-image: radial-gradient(closest-side, rgb(243 93 1 / 0.16), transparent 72%);
    filter: blur(14px);
  }

  /* ---- Driven. The model turns, lifts and lights with the journey -------
     `--p` is the same number that drives the report strip, so the hills and
     the reports cannot fall out of step. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.hero-journey[data-journey-live]) .relief {
      --tilt: calc(58deg - var(--p, 0) * 13deg);
      --spin: calc(-26deg + var(--p, 0) * 30deg);
    }
    :global(.hero-journey[data-journey-live]) .relief-model {
      transform: rotateX(var(--tilt)) rotateZ(var(--spin))
                 translateZ(calc(var(--p, 0) * 40px));
    }
    :global(.hero-journey[data-journey-live]) .route-lit {
      stroke-dashoffset: calc(1 - var(--p, 0));
    }
    :global(.hero-journey[data-journey-live]) .rover {
      offset-distance: calc(var(--p, 0) * 100%);
    }
    /* Two different behaviours, deliberately.

       A NODE lights as the rover reaches it and stays lit, so the route
       accumulates a record of the trip. Nodes are small and sit on the road,
       so they cannot collide.

       A CARD is only up while the rover is AT its stop. Four cards standing
       at once needs roughly 560px of model to lay out, and the model is
       292px wide on a 320px phone: no stagger survives that, which is why
       raising masts and then scaling them both made it worse rather than
       better. One card at a time removes the collision by construction, is
       calmer to read, and still answers "what happens when the dot arrives".
       The full record is in the report strip below in any case. */
    :global(.hero-journey[data-journey-live]) .node {
      --lit: clamp(0, (var(--p, 0) - var(--at) + 0.07) * 13, 1);
      opacity: var(--lit);
    }
    :global(.hero-journey[data-journey-live]) .beam {
      --dist: max(calc(var(--p, 0) - var(--at)), calc(var(--at) - var(--p, 0)));
      /* 7, not 8. The stops are 0.28 of the journey apart, so a falloff that
         reaches zero at 0.143 hands one card straight to the next: no gap
         where nothing is showing, and no moment where two are up at once.
         It is the same constant the report strip uses, for the same reason. */
      --lit: clamp(0, 1 - var(--dist) * 7, 1);
      opacity: var(--lit);
    }
    :global(.hero-journey[data-journey-live]) .beam-shaft,
    :global(.hero-journey[data-journey-live]) .beam-cap {
      transform-origin: 50% 100%;
      transform: scaleY(var(--lit));
    }
    /* Overshoots very slightly on the way in, which is what makes it read as
       arriving rather than as switching on. Nothing elastic: it settles. */
    :global(.hero-journey[data-journey-live]) .beam-label {
      --pop: calc(0.86 + var(--lit) * 0.14);
    }
  }

  /* Static fallback: everything already arrived. The composition is finished
     at rest, so no-JS and reduced-motion both get the whole scene. */
  .node,
  .beam {
    opacity: 1;
  }

  @media (width < 64rem) {
    /* Not hidden, recomposed. The model flattens toward a map and shrinks,
       because at this width it sits behind the copy rather than beside it. */
    .relief {
      --tilt: 62deg;
      --spin: -20deg;
    }
    .relief-model {
      width: min(78%, 22rem);
    }
    /* The stagger is kept and scaled, not flattened. */
    .relief { --mast-k: 0.68; }
    .beam-label {
      max-width: 6.75rem;
      padding: 0.3rem 0.5rem;
    }
    .beam-label-line { font-size: 0.6875rem; }
    .beam-label-name { font-size: 0.5625rem; }
    .relief { opacity: 0.85; }
  }
</style>
