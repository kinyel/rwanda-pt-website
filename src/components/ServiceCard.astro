---
/**
 * Service card.
 *
 * Deliberately unlike ProductCard: no photograph, a numbered index, and an
 * orange rule down the left edge instead of a full border. A service is work
 * we do rather than an object you receive, so it should not be presented as
 * a thing in a box.
 */
import { localizePath, interpolate, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  index: number;
  name: string;
  tagline: string;
  summary: string;
  href: string;
  class?: string;
  /** Passed through so a parent can set `--n` for staggered reveals. */
  style?: string;
}

const { locale, index, name, tagline, summary, href, class: className = '', style } = Astro.props as Props;
const t = useTranslations(locale);
const url = localizePath(href, locale);
---

<article
  class={`group relative flex flex-col border-l-2 border-ink-100 py-1 pl-6
          transition-colors duration-[--duration-base] ease-[--ease-prime] hover:border-prime-500 sm:pl-8 ${className}`}
  style={style}
>
  <span class="text-label uppercase text-ink-400">{String(index).padStart(2, '0')}</span>

  <h3 class="mt-3 text-h3">
    <a href={url} class="after:absolute after:inset-0 after:content-['']">{name}</a>
  </h3>
  <p class="mt-1.5 text-[0.9375rem] font-semibold text-prime-700">{tagline}</p>
  <p class="mt-3 measure text-ink-600">{summary}</p>

  <p
    class="mt-5 inline-flex items-center gap-1.5 text-[0.9375rem] font-bold text-ink-900
           transition-transform duration-[--duration-base] ease-[--ease-prime] motion-safe:group-hover:translate-x-0.5"
    aria-hidden="true"
  >
    {interpolate(t.common.cta.seeService, { service: name })}
    <svg class="h-4 w-4 text-prime-600" viewBox="0 0 16 16" fill="none">
      <path d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </p>
</article>
