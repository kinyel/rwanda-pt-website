---
/**
 * The helix: product cards arranged on a vertical spiral in CSS 3D.
 *
 * Ported from the PrimeTrack Nigeria PRODUCTS section. Same technique, same
 * class and token names, so the two sites stay maintainable together. Only the
 * PARAMETERS differ, and they are all custom properties, which is what makes
 * this liftable into a shared package later.
 *
 *   Nigeria   5 cards · 72deg step · radius 8/11.5/14.5rem · rise 4.75/7/8rem
 *             perspective 760/1000/1200px · origin 50%
 *   Rwanda    6 cards · 60deg step · radius 8.5/12/15rem   · rise 5.25/7.75/9rem
 *             perspective 820/1080/1320px · origin 50% 38%
 *
 * Six steps at 60 degrees with a taller rise gives a steeper, denser staircase
 * than Nigeria's, and the raised camera origin looks down it rather than at it.
 * Same mechanic, visibly not the same shot.
 *
 * HOW IT WORKS
 *   .spiral-item  places each card once, from its own `--i`: rotate around the
 *                 Y axis by `--i * --step-angle`, push out by `--radius`, rise
 *                 by `--i * --step-rise`. Adding a card is markup, not maths.
 *   .spiral-ring  counter-rotates and descends by `--k`, the fractional card
 *                 index, so scrolling walks the helix past the camera.
 *   --p           scroll progress 0..1, the single value JavaScript writes.
 *   --face        cos() of each card's angle from the camera, used to fade the
 *                 cards facing away. Pure CSS, no per-card JS.
 *
 * DARK GROUND. The section runs on ink-950, the same ground as the hero, the
 * CTA block and the footer. The helix was always a lit object — a spine of
 * light with cards turning around it — and it only reads as one against a dark
 * field: the orange edge on the card facing the camera is the whole signature,
 * and on a light ground that edge had nothing to be brighter than.
 *
 * The card at the read head is the only one wearing that edge. Its border and
 * its glow are driven by `--facing`, the same cosine that drives the fade, so
 * the light tracks the turn instead of switching on at a threshold.
 *
 * PROGRESSIVE ENHANCEMENT
 * The base state is a plain responsive grid. The helix only exists under
 * `[data-on]`, which the script adds unless the visitor has asked for reduced
 * motion. With JS off or with reduced motion, the section is a readable card
 * grid and nothing is missing.
 *
 * The helix now runs at EVERY width, phones included. It used to be gated at
 * 48rem on the assumption that the geometry could not survive a narrow screen.
 * It can: the card, the radius and the rise are all custom properties, so the
 * phone gets its own smaller staircase rather than no staircase. What a phone
 * genuinely cannot afford is the height, so the pinned index beside the stage
 * is replaced there by a two-line progress readout — the six cards are already
 * six links, and a second copy of them was the one thing that did not fit.
 */
import Icon from './Icon.astro';
import { resolveKey } from '../data/navigation';
import { useTranslations, localizePath, type Locale } from '../i18n';

export interface SpiralItem {
  /** Locale-free route. */
  href: string;
  /** Dotted key into the dictionary, for the card and menu label. */
  titleKey: string;
  descriptorKey: string;
  icon: string;
}

interface Props {
  locale: Locale;
  eyebrow: string;
  title: string;
  menuTitle: string;
  items: SpiralItem[];
  cta: string;
}

const { locale, eyebrow, title, menuTitle, items, cta } = Astro.props;
const t = useTranslations(locale);
const count = items.length;

/* THE STAR FIELD.
   A golden-angle walk rather than Math.random: it never clumps, it needs no
   seed, and it is identical on every render, so the markup is stable across
   builds and nothing shifts between the server's HTML and the client's. The
   depths are spread over 340px, which is wider than the helix's own radius,
   so the field reads as behind the staircase rather than level with it. */
const STARS = Array.from({ length: 26 }, (_, i) => {
  const a = i * 2.39996;
  const r = Math.sqrt((i + 0.5) / 26);
  return {
    x: +(50 + Math.cos(a) * r * 54).toFixed(2),
    y: +(50 + Math.sin(a) * r * 46).toFixed(2),
    z: -130 - Math.round((((i * 37) % 26) / 26) * 340),
    o: +(0.16 + (((i * 17) % 26) / 26) * 0.46).toFixed(2),
  };
});
---

<section class="spiral on-dark" data-nav="dark" data-nav-section="products" data-spiral style={`--count:${count}`}>
  <span class="spiral-lead-probe" aria-hidden="true" data-spiral-lead></span>
  <div class="spiral-track" data-spiral-track>
    <div class="spiral-viewport">
      <div class="container-prime spiral-layout">
        <!-- ============ Pinned index. Doubles as navigation. ============ -->
        <div class="spiral-menu">
          <p class="eyebrow">{eyebrow}</p>
          <h2 class="mt-4 text-h2 text-white">{title}</h2>

          <!--
            The narrow-screen stand-in for the index list.

            Same information, one line instead of six: which card the camera is
            on, out of how many, plus a rail that fills with the descent. It is
            driven entirely by `--p` and each span's own `--i`, so there is no
            extra JavaScript and it cannot fall out of step with the helix.
            Hidden from assistive technology because the cards it counts are
            right there, in order, as links.
          -->
          <p class="spiral-counter" aria-hidden="true">
            <span class="spiral-counter-slot">
              {items.map((_item, i) => <span class="spiral-counter-n" style={`--i:${i}`}>{String(i + 1).padStart(2, '0')}</span>)}
            </span>
            <span class="spiral-counter-total">/ {String(count).padStart(2, '0')}</span>
            <span class="spiral-counter-rail"><span class="spiral-counter-fill"></span></span>
          </p>

          <p class="spiral-menu-title">{menuTitle}</p>
          <ul class="spiral-list" role="list">
            {
              items.map((item, i) => (
                <li style={`--i:${i}`}>
                  <a href={localizePath(item.href, locale)} class="spiral-link" data-spiral-link style={`--i:${i}`}>
                    <span class="spiral-link-index">{String(i + 1).padStart(2, '0')}</span>
                    <span class="spiral-link-label">{resolveKey(t, item.titleKey)}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- ============ Stage ============ -->
        <div class="spiral-stage">
          <!-- The space the helix is in, which it did not have. Three
               layers at three real depths behind the staircase: see the
               block comment on `.spiral-aurora` below. -->
          <div class="spiral-spine" aria-hidden="true">
            <span class="spiral-stars">
              {STARS.map((star) => (
                <i style={`--x:${star.x}%; --y:${star.y}%; --z:${star.z}px; --o:${star.o}`} />
              ))}
            </span>
            <span class="spiral-ground"></span>
            <span class="spiral-spine-line"></span>
            <span class="spiral-spine-node"></span>
            <span class="spiral-glow"></span>
          </div>

          <div class="spiral-ring" data-spiral-ring>
            {
              items.map((item, i) => (
                <a href={localizePath(item.href, locale)} class="spiral-item" style={`--i:${i}`} data-spiral-item>
                  <span class="spiral-card">
                    {/* A header row rather than a stack. The icon had been
                        sitting on its own line with nothing to balance it,
                        which left the top of every card lopsided; the index
                        gives it a counterweight and ties the card to the
                        numbered list on the left. Hidden from assistive
                        technology because that list is the real one. */}
                    <span class="spiral-card-top" aria-hidden="true">
                      <span class="spiral-card-icon">
                        <Icon name={item.icon} size={20} />
                      </span>
                      <span class="spiral-card-n" data-n={String(i + 1).padStart(2, '0')} />
                    </span>
                    <span class="spiral-card-label">{resolveKey(t, item.titleKey)}</span>
                    <span class="spiral-card-desc">{resolveKey(t, item.descriptorKey)}</span>
                    <span class="spiral-card-cta">
                      {cta}
                      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Geometry. Every value here is a knob. ---------------------- */
  .spiral {
    --step-angle: calc(360deg / var(--count));   /* 60deg at six cards */

    /* The phone tier. These values used to exist and never ran: the helix was
       gated at 48rem, so the smallest set was dead code. They are now the
       geometry a phone actually gets, and they are tuned for one — a shorter
       radius so the neighbouring cards stay on screen, a shorter rise so the
       staircase fits a 500px stage, and a cheaper scroll cost so the section
       does not eat three screens of a phone's page. */
    /* Smaller again, on review: at 12.5rem a card plus its perspective was
       two-thirds of a phone's width, and the neighbours either side were
       pressed up against it and half off the screen.

       AND THE RATIO MATTERS MORE THAN THE SIZE. A neighbour sits 60deg
       round the helix, and its inner edge only stays BEHIND the card being
       read while the card is narrower than about 1.15 x the radius; any
       wider and that edge physically stands in front of the front card and
       is drawn over its words. 9.5rem on an 8.75rem radius keeps it behind,
       with the front card's scale-up allowed for, and the whole staircase
       inside a 360px screen. */
    --radius: 8.75rem;
    --step-rise: 4rem;
    --card-w: 9.5rem;
    /* Scroll cost per card. Six cards means the section costs
       100svh + 5 x this, so it is the main lever on how much of the page the
       helix consumes. */
    --scroll-per-item: 30vh;
    /* Flatter than before, so the card being read is not magnified to
       two-thirds of the screen by its own nearness. */
    --perspective: 900px;
    --camera: 50% 42%;

    /* The single value the script writes. It lives on the section rather than
       on the ring so that the ring AND the progress readout can both read it;
       two elements reading one number is what keeps them in step. */
    --p: 0;
    /* The fractional card index the camera is currently looking at. */
    --k: calc(var(--p) * (var(--count) - 1));

    position: relative;
    /* Dark ground, warm rather than neutral — and it ARRIVES rather than
       starts.

       This section butts straight onto the hero, and both are built on
       ink-950, so in principle there is no seam. In practice there was one:
       the section used to carry a wide white lift across its top edge, put
       there to separate it from the pale section that used to sit above it.
       Against the hero that lift was a hard horizontal line of a lighter black
       — two shades of black meeting at a ruled edge, which is worse than an
       honest change of colour because the eye reads it as a rendering fault
       rather than as a design.

       So the top of this section is now the hero's ground exactly, to the
       byte, and the section's own warmer black resolves in over the first
       450px. By the time the helix is doing anything the ground is its own;
       at the join it is the hero's. The lift is gone: there is nothing above
       to separate from any more.

       The orange wash is held off the join for the same reason — its centre
       moved down far enough that its upper falloff cannot reach the seam. */
    background-color: var(--color-ink-950);
    background-image:
      radial-gradient(52% 42% at 62% 50%, rgb(243 93 1 / 0.05), transparent 70%),
      linear-gradient(
        to bottom,
        #08090b 0,
        #08090b 90px,
        #0e0b09 450px,
        #120d0a 100%
      );
  }

  /* A short phone: the stage is barely taller than a card, so the steps
     rise less and the next card up stays clear of the counter above it. */
  @media (width < 48rem) and (height < 40rem) {
    .spiral {
      --step-rise: 2.75rem;
    }
  }

  @media (width >= 48rem) {
    .spiral {
      --radius: 12rem;
      --step-rise: 7.75rem;
      --card-w: 15rem;
      --scroll-per-item: 40vh;
      --perspective: 1080px;
      --camera: 50% 38%;
    }
  }

  @media (width >= 64rem) {
    .spiral {
      --radius: 15rem;
      --step-rise: 9rem;
      --card-w: 16.5rem;
      --scroll-per-item: 44vh;
      --perspective: 1320px;
    }
  }

  /* ---------- Base state: a plain card grid ------------------------------
     This is what ships to phones, to reduced-motion visitors, and to anyone
     with JavaScript off. It is the fallback and it is also perfectly fine. */
  .spiral-track {
    padding-block: 4rem 4.5rem;
  }

  .spiral-layout {
    display: grid;
    gap: 2.5rem;
  }

  .spiral-menu-title {
    margin-top: 2.25rem;
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    /* ink-400 is 5.8:1 on ink-950. It is the floor on this ground: ink-500 is
       3.3:1 and fails AA for text this size, so nothing darker is used here. */
    color: var(--color-ink-400);
  }

  /* THE INDEX IS AN INSTRUMENT, NOT A LIST OF LINKS.

     It was six rows of text with the current one turned white, which is a
     perfectly good menu and says nothing about the thing it is attached
     to. It now runs down a rail: hairline rules between the rows, a track
     down the left, and — once the helix is driving — a lit segment on that
     track that slides with the descent.

     The segment's position is `--k`, the fractional card index the camera
     is on, which is the same number the staircase turns by. It is not
     synchronised with the stage; it is the stage's own number, read twice.
     No JavaScript, no second source of truth, and nothing to fall out of
     step. */
  .spiral-list {
    position: relative;
    margin-top: 1rem;
    padding-left: 1.6rem;
    display: flex;
    flex-direction: column;
  }
  /* The track, faded at both ends so it reads as a run rather than a box
     edge. */
  .spiral-list::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 1px;
    background-image: linear-gradient(
      to bottom,
      transparent,
      rgb(255 255 255 / 0.16) 7%,
      rgb(255 255 255 / 0.16) 93%,
      transparent
    );
  }
  /* THE RULES BUILD.

     A list of six evenly ruled rows beside a staircase is two different
     rhythms in one column. The rules step instead: the first is the
     shortest and each one below it is longer, the last running the full
     width of the list, so the index builds as you read down it rather than
     tailing away.

     Width comes from the row's own index and the section's `--count`, so
     adding a seventh product is still one line of markup and the last rule
     is still the full width. */
  .spiral-list > li {
    position: relative;
  }
  .spiral-list > li + li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    height: 1px;
    width: calc(100% - (var(--count) - 1 - var(--i)) * 15%);
    background-image: linear-gradient(
      to right,
      rgb(255 255 255 / 0.14),
      rgb(255 255 255 / 0.03)
    );
  }

  .spiral-link {
    position: relative;
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) 1.1rem;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.7rem;
    color: var(--color-ink-400);
    transition:
      color var(--duration-base) var(--ease-prime),
      transform var(--duration-base) var(--ease-prime);
  }
  /* A short rule pointing at the stage, on the row being looked at and on
     whatever the pointer is over. It is the only ornament in the column and
     it earns its place by saying which way the eye should go next. */
  .spiral-link::after {
    content: '';
    justify-self: end;
    width: 1.1rem;
    height: 1px;
    background-color: currentColor;
    opacity: 0;
    transform: translateX(-0.4rem);
    transition:
      opacity var(--duration-base) var(--ease-prime),
      transform var(--duration-base) var(--ease-prime);
  }
  .spiral-link:hover::after,
  .spiral-link[data-current]::after {
    opacity: 0.75;
    transform: none;
  }
  .spiral-link-index {
    font-size: var(--text-label);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    /* ink-400, not ink-500 or ink-600. The reference sits these numerals much
       darker, but they are the list's ordinals, not decoration: on ink-950,
       ink-500 is 3.3:1 and ink-600 is 2.2:1, both under the 4.5:1 AA floor for
       text this size. ink-400 clears it at 5.8:1, and the separation from the
       label beside it is carried by size and weight instead. */
    color: var(--color-ink-400);
    transition: color var(--duration-base) var(--ease-prime);
  }
  .spiral-link-label {
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1.25;
    text-wrap: balance;
  }
  .spiral-link:hover {
    color: var(--color-white);
    transform: translateX(3px);
  }
  .spiral-link:hover .spiral-link-index {
    color: var(--color-ink-200);
  }
  /* The synced active state, written by the scroll handler.
     White label, orange ordinal: the card at the read head wears the same
     pairing, so the index and the stage read as one instrument. */
  .spiral-link[data-current] {
    color: var(--color-white);
  }
  /* The lit segment. One row tall, parked at `--k` rows down, so it slides
     continuously rather than jumping between rows: during a turn it sits
     between the two it is handing over between, exactly as the helix
     does. */
  .spiral[data-on] .spiral-list::after {
    content: '';
    position: absolute;
    left: -1px;
    width: 3px;
    height: calc(100% / var(--count));
    top: calc(var(--k) / var(--count) * 100%);
    border-radius: 999px;
    background-image: linear-gradient(to bottom, var(--color-amber-500), var(--color-prime-500));
    box-shadow: 0 0 18px 1px rgb(243 93 1 / 0.45);
  }
  .spiral-link[data-current] .spiral-link-index {
    color: var(--color-prime-400);
  }

  /* ---------- The narrow-screen progress readout ------------------------
     Hidden entirely except in the driven state below 64rem, where it stands in
     for the index list. */
  .spiral-counter {
    display: none;
  }

  .spiral-spine {
    display: none;
  }

  .spiral-ring {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }

  .spiral-item {
    display: block;
    border-radius: var(--radius-panel);
  }

  .spiral-card {
    /* `--lit` is how strongly this card is facing the camera, 0 to 1. The
       border, the glow and the icon chip all read from this one number, which
       is what makes the light travel with the turn instead of switching on at
       a threshold.

       In the flat grid it is a flat 0.7 rather than 1. Every card in a grid is
       square on to the reader, so a literal 1 would put six full-strength
       orange edges on screen at once and the section would read as a warning
       panel. Held here, the fallback keeps the same material and stops short
       of the emphasis, which only the helix has a reason to spend. */
    --lit: 0.7;

    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    height: 100%;
    padding: 1.5rem;
    /* THE SIGNATURE. A hairline that is brand orange on the card facing the
       camera and ordinary paper edge on the ones turned away. */
    /* The resting edge is brighter than it was. A darker card leans on its
       border for the bottom two thirds of its outline, where the surface
       has run out of light to separate with. */
    border: 1px solid
      color-mix(in oklab, var(--color-prime-400) calc(var(--lit) * 90%), rgb(255 255 255 / 0.16));
    border-radius: var(--radius-panel);
    /* DARK GREY. Three passes to get here and the reasoning is worth
       keeping, because each failure explains the next move.

       Warm near-black on a warm near-black ground was the original: the
       only thing separating a card from the room was one pixel of orange
       edge, which is why the helix needed that edge to be visible at all.

       White fixed the separation and overcorrected — six sheets of pure
       paper in a dark room is a lightbox, and the brand orange on the
       facing card had nothing left to be brighter than.

       Dark grey is the answer to both. It is four or five stops above the
       section's ground, so a card separates on VALUE and needs no help; it
       is far enough below white that the lit edge and the icon are the
       brightest things on it; and it keeps the family dark, which is what
       the rest of this page is.

       THE GRADIENT IS THE LIGHTING, so it is steep rather than decorative.
       It runs from the top-left corner the room's light comes from down to
       a bottom-right that is nearly out of it — four stops over a range of
       about 0.16 to 0.02 in luminance, where the flat version only managed
       0.21 to 0.09 and read as a grey rectangle with a slight sheen.

       AND IT IS COOL, which is what lets it go this dark without
       disappearing. The section's ground is a warm near-black; a neutral
       card at this value would merge into it at the shaded corner. A card
       that is blue-grey separates by HUE where it can no longer separate
       by brightness, which is the same trick the relief uses to keep its
       valleys off the page colour. */
    background-image:
      /* The warm pass. Only the card at the read head is in the light, so
         only it takes the brand into its surface; the rest stay slate.
         This is what makes the facing card read as lit rather than as the
         same card with a brighter border. */
      linear-gradient(
        152deg,
        rgb(255 138 46 / calc(var(--lit) * 0.12)) 0%,
        rgb(243 93 1 / calc(var(--lit) * 0.04)) 34%,
        transparent 68%
      ),
      /* And the base, with the stops bunched toward the lit corner rather
         than spread evenly. An even ramp is a wash; a ramp that turns
         fast near the light and then holds is a surface catching it. */
      linear-gradient(
        152deg,
        #1f252d 0%,
        #151a21 22%,
        #0b0f14 58%,
        #050709 100%
      );
    box-shadow:
      /* NO CAST SHADOW. On a room this dark a black shadow does not read as
         a shadow, it reads as a dark patch standing behind the card, and with
         the slab's edges beside it the two together looked like a second
         shape. The card's depth is its edges and its bevel. */
      /* NO ORANGE SPILL. It was there to make a near-black card readable
         against a near-black room, and a grey card does that on its own.
         Kept, it put a halo round every object in the scene and the
         section read as lit by the cards rather than by the spine. */
      /* The bevel. A light top edge and a dark bottom one, both inside
         the card, which is how a solid object with a chamfer catches a
         light that is above and in front of it. Two lines, and the panel
         stops reading as a sticker. */
      inset 0 1.5px 0 rgb(255 255 255 / calc(0.16 + var(--lit) * 0.2)),
      inset 0 -2px 0 rgb(0 0 0 / 0.6),
      inset 1.5px 0 0 rgb(255 255 255 / 0.08),
      inset -1.5px 0 0 rgb(0 0 0 / 0.45);
    transition:
      border-color var(--duration-base) var(--ease-prime),
      box-shadow var(--duration-base) var(--ease-prime);
  }

  .spiral-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  /* Quiet: it is a marker, not a heading. ink-400 on paper is 3.4:1, which
     is under the text floor, and that is the point — it is the one thing on
     the card that is allowed to be furniture.

     DRAWN FROM AN ATTRIBUTE, NOT WRITTEN INTO THE MARKUP. These numerals
     already exist on this page, in the index list beside the stage, and
     putting a second set into the card text changed the body copy of the
     two busiest pages on the site for the sake of a design flourish. The
     page-text diff caught it. Generated content keeps the text exactly
     what it was. */
  .spiral-card-n::before {
    content: attr(data-n);
  }
  .spiral-card-n {
    font-size: 0.8125rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--color-ink-400);
  }
  /* The card went dark again, so its ink goes light again. ink-300 is
     8.4:1 on the card's mid tone and prime-300 is 6.1:1, both clear of
     the AA floor; prime-700, which is the colour for paper, would be
     2.0:1 here. */

  .spiral-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background-color: rgb(243 93 1 / calc(0.1 + var(--lit) * 0.16));
    border: 1px solid rgb(255 125 41 / calc(0.2 + var(--lit) * 0.4));
    color: var(--color-prime-300);
  }

  .spiral-card-label {
    font-size: var(--text-h4);
    font-weight: 700;
    color: var(--color-white);
  }

  .spiral-card-desc {
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--color-ink-300);
  }

  .spiral-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.4rem;
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-prime-300);
  }
  /* ON A PHONE, ONLY THE CARD BEING READ AND ITS TWO NEIGHBOURS. Six cards
     go once round the circle, so the card five steps up the staircase is
     only 60deg round from the one in front — it counts as facing the reader
     — while standing five steps higher, which put it just under the
     counter, poking out below the heading. Here a card also fades with its
     distance ALONG the staircase (`--near`): full within a step and a bit
     of the card being read, gone by two steps, smoothly in between, so the
     neighbours stay in view through a turn and nothing further away ever
     shows. Wider screens show the whole staircase beside its index. */
  @media (width < 64rem) {
    .spiral[data-on] .spiral-item {
      --step-d: max(calc(var(--i) - var(--k)), calc(var(--k) - var(--i)));
      --near: clamp(0, (1.9 - var(--step-d)) / 0.6, 1);
    }
    /* LIGHTER ON A PHONE. A card turned away used to go into shadow
       through `filter: brightness() blur()`, and a filtered card in 3D is
       redrawn offscreen on every frame it turns; with six of them, plus
       twenty-six stars and a masked floor all standing in 3D, a phone's
       graphics memory ran out mid-scroll and the tab crashed and reloaded.
       Here a card goes into shadow by fading instead, the stars and floor
       are left out, and a card two steps away is not just invisible but
       gone (`data-far`, from the script), so it cannot be tapped by
       accident while scrolling past and costs nothing to draw. */
    .spiral[data-on] .spiral-item .spiral-card {
      opacity: calc((0.3 + 0.7 * var(--lit)) * var(--near));
      filter: none;
    }
    .spiral[data-on] .spiral-item[data-far] {
      visibility: hidden;
    }
    .spiral[data-on] .spiral-stars,
    .spiral[data-on] .spiral-ground {
      display: none;
    }
    .spiral[data-on] .spiral-glow {
      filter: none;
    }
  }

  /* On a phone's narrower card the link stays on one line: a step smaller,
     and never broken. */
  @media (width < 64rem) {
    .spiral[data-on] .spiral-card-cta {
      gap: 0.3rem;
      font-size: 0.78rem;
      white-space: nowrap;
    }
  }

  .spiral-item:hover .spiral-card {
    border-color: var(--color-prime-400);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.55),
      0 34px 76px -24px rgb(0 0 0 / 0.95),
      inset 0 1px 0 rgb(255 255 255 / 0.2);
  }
  .spiral-item:focus-visible {
    /* prime-400 on dark, where prime-500 would be the light-mode ring. */
    outline: 2px solid var(--color-prime-400);
    outline-offset: 4px;
  }

  @media (width >= 64rem) {
    .spiral-layout {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 3.5rem;
      align-items: center;
    }
  }

  /* ---------- Enhanced state: the helix ----------------------------------
     Everything below is gated on [data-on], which the script only adds on a
     wide enough viewport with motion allowed. */
  .spiral[data-on] .spiral-track {
    padding-block: 0;
    /* One viewport to pin against, plus travel for each additional card,
       plus the lead-in (`--lead`, on the hand-over below): the stretch at the
       start, while the section fades in over the hero and then holds, in
       which the first card stands square to the reader before anything
       turns. */
    min-height: calc(100svh + var(--lead, 0px) + (var(--count) - 1) * var(--scroll-per-item));
  }

  .spiral[data-on] .spiral-viewport {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    height: 100svh;
    padding-top: var(--header-h);
    padding-bottom: 2rem;

    /* The helix rises as it turns, so the upper cards sit well above the stage
       (roughly 750px at six steps). Without a clip they escape the section
       entirely and float over whatever is above it.

       Clipping here rather than on the section is deliberate: `overflow` on an
       ancestor of a sticky element kills the stickiness, but on the sticky
       element itself it is harmless. And because this element is exactly the
       visible band, cards are cut at the edge of the screen, where the cut
       cannot be seen. `clip` rather than `hidden` so no scroll container is
       created. */
    overflow: clip;
  }

  /* FADES IN WHERE IT STANDS. When it is live the section begins one screen
     early, lying under the last screen of the hero, with a transparent ground
     of its own: its pinned stage carries the ground instead, and the stage is
     invisible until the hero has dissolved. So at the hero's last frame this
     stage is already in place, and it simply fades up — the page changes
     section without anything scrolling past. Opacity sits on the sticky frame,
     which is only a frame: the helix's 3D lives further down, inside the
     stage, so this cannot flatten it. Hidden outright before it starts, so
     its links cannot be tabbed into while they cannot be seen. */
  :global(.hero-journey[data-journey-live]) ~ .spiral[data-on] {
    margin-top: -100svh;
    /* See-through only for the first screen — the stretch lying under the
       end of the hero — and the room's own black from there down. Fully
       transparent, the page's white ground showed through the bottom of the
       screen for as long as the stage was still fading up over it. */
    background: linear-gradient(to bottom, transparent 0, transparent 100svh, #050608 100svh);
  }

  /* ITS ENTRANCE: THE STAIRCASE FANS OUT FROM ITS FIRST CARD. While it
     fades in over the end of the hero, the first card stands where it will
     be read, square on, from the very first frame; the other five start
     folded in behind it, close to the axis, and swing out round the helix
     to their places. It used to spin the whole staircase into place, which
     meant the first card was turned away for the whole of its own
     entrance. One eased number, from the same hand-over the fade reads.
     Only here, where the hand-over exists; anywhere else `--wind` is absent
     and reads as 1. */
  :global(.hero-journey[data-journey-live]) ~ .spiral[data-on] {
    --wind: calc(var(--enter, 0) * var(--enter, 0) * (3 - 2 * var(--enter, 0)));
    /* The lead-in (see `.spiral-track`). In `svh`, which a phone's toolbar
       collapsing and coming back does not change: measured off the window's
       height instead, the track grew and shrank by the height of the
       toolbar mid-scroll, and everything below it jumped. */
    --lead: 55svh;
  }

  /* The script reads the lead-in's height in pixels off this, so CSS stays
     the one place it is defined. */
  .spiral-lead-probe {
    position: absolute;
    width: 0;
    height: var(--lead, 0px);
    visibility: hidden;
    pointer-events: none;
  }

  :global(.hero-journey[data-journey-live]) ~ .spiral[data-on] .spiral-viewport {
    opacity: var(--enter, 0);
    background-color: #050608;
    background-image: radial-gradient(52% 42% at 62% 50%, rgb(243 93 1 / 0.05), transparent 70%);
  }

  :global(.hero-journey[data-journey-live]) ~ .spiral[data-on]:not([data-entered]) .spiral-viewport {
    visibility: hidden;
  }

  :global(.hero-journey[data-journey-live]) ~ .spiral[data-on] .spiral-menu {
    translate: 0 calc((1 - var(--enter, 0)) * 24px);
  }

  .spiral[data-on] .spiral-stage {
    position: relative;
    flex: auto;
    min-height: 0;
    align-self: stretch;
    perspective: var(--perspective);
    perspective-origin: var(--camera);
  }

  .spiral[data-on] .spiral-spine {
    display: grid;
    place-items: center;
    position: absolute;
    inset: 0;
    /* Was flat, which made everything in it a backdrop painted at the
       camera's own plane. The layers below are at genuine depths and have
       to be projected with the cards, not behind a picture of them. */
    transform-style: preserve-3d;
  }
  .spiral-spine > * {
    grid-area: 1 / 1;
  }
  /* The axis the staircase turns around. On a dark ground it can be an actual
     line of light rather than the hint of one it had to be on white. */
  .spiral-spine-line {
    width: 1px;
    height: 100%;
    background-image: linear-gradient(transparent, rgb(255 125 41 / 0.55) 20% 80%, transparent);
  }
  /* The read head of the whole mechanism. The card the camera is square to
     is always at the centre of the stage, so this never has to move: it is
     simply the point the staircase turns past, lit. */
  .spiral-spine-node {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background-color: var(--color-amber-500);
    box-shadow: 0 0 20px 4px rgb(243 93 1 / 0.55);
  }
  .spiral-glow {
    width: 26rem;
    height: 26rem;
    max-width: 90vw;
    max-height: 90vw;
    border-radius: 999px;
    background-image: radial-gradient(circle, rgb(255 140 0 / 0.07), transparent 64%);
    filter: blur(10px);
  }

  /* THE SPACE THE HELIX IS IN.

     The staircase was a lit object turning in nothing. It read as a lit
     object turning in nothing, which is a different thing from turning in
     the dark: there was no floor under it, no air behind it and no scale
     to judge the descent against, so six cards at six depths looked like
     six cards at one depth with different opacities.

     Three layers fix that, and all three are depth cues rather than
     decoration:

     There was a third, a cool wash far at the back, on the theory that
     distance desaturates and cools. It does — but a blue at 30% over
     near-black is grey, and a 760px-wide blurred grey sitting between the
     index column and the staircase read as a smudge on the screen rather
     than as air. Atmospheric perspective needs something to be atmospheric
     ABOUT, and this room is too dark for it. Gone, and the section is
     cleaner without it.

     STARS, scattered through the middle distance at 26 different depths.
     The perspective sizes them for free, so the near ones are visibly
     nearer. They are what gives the volume a texture to be measured
     against.

     GROUND, tilted almost flat and marked with the same contour rings the
     rest of the site is built from. It is the single biggest change: a
     staircase standing ON something reads as a descent, and the rings
     converging toward the horizon say how far down it goes.

     None of it animates. It is a room, and rooms hold still. */
  .spiral-stars {
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    position: relative;
  }
  .spiral-stars i {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 2px;
    height: 2px;
    border-radius: 999px;
    background-color: #fff;
    opacity: var(--o);
    transform: translateZ(var(--z));
  }

  .spiral-ground {
    width: 122%;
    height: 150%;
    max-width: none;
    max-height: none;
    /* Down first, then laid flat: translate happens in the stage's frame,
       so doing it after the tilt would send the plane away from the camera
       rather than below it.

       14%, not 40%. At 40% the whole floor sat below the fold of a 760px
       screen and the only thing it changed was the paint cost. */
    transform: translateY(4%) rotateX(68deg);
    /* TWO LAYERS, AND THE ORDER MATTERS.

       A ring 2px wide lying at 68deg is 0.75px of screen where it runs
       across the view, so the rings are drawn at an alpha that would be
       crass on a wall and is barely a suggestion here. Two earlier passes
       at 0.055 and 0.11 were, respectively, invisible and nearly so.

       Under them is a pool of warm light. It does more work than the rings
       do: a staircase standing in a pool reads as standing on something
       even where no line is resolvable, and it is the cue that survives
       being scaled down to a phone. */
    background-image:
      repeating-radial-gradient(
        ellipse 100% 100% at 50% 50%,
        rgb(255 196 148 / 0.22) 0 2px,
        transparent 2px 58px
      ),
      radial-gradient(ellipse 38% 40% at 50% 50%, rgb(243 93 1 / 0.22), transparent 72%);
    /* Fades out well before its own edge, so the floor has a horizon
       instead of a rectangle's corner, and never reaches the index list
       in the left column. */
    mask-image: radial-gradient(ellipse 40% 46% at 50% 50%, #000 0%, transparent 70%);
  }

  .spiral[data-on] .spiral-ring {
    display: block;
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: translateY(calc(var(--k) * var(--step-rise)))
               rotateY(calc(var(--k) * var(--step-angle) * -1));
  }

  .spiral[data-on] .spiral-item {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--card-w);
    transform-origin: 0 0;
    /* `--fold` is 0 for the first card and 1 for the rest: the first never
       moves on the entrance, the rest fan out from behind it. */
    --fold: calc(min(var(--i), 1) * (1 - var(--wind, 1)));
    transform: rotateY(calc(var(--i) * var(--step-angle) * (1 - 0.8 * var(--fold))))
               translateZ(calc(var(--radius) * (1 - 0.6 * var(--fold))))
               translateY(calc(var(--i) * var(--step-rise) * -1))
               translate(-50%, -50%);
    backface-visibility: hidden;
    /* So the light pool below can be laid flat, and so the slab behind the
       card can sit at a real depth rather than being a drawn shadow. */
    transform-style: preserve-3d;
    /* Hoisted off the card: the pool reads the same facing number the
       card's border and glow do, and two elements reading one number is
       what keeps them from disagreeing. */
    --face: cos(calc((var(--i) - var(--k)) * var(--step-angle)));
    --facing: max(0, var(--face));
    --lit: calc(var(--facing) * var(--facing));
  }
  /* NO BACK FACE. There was one here: a second panel 18px behind each
     card, so a turning card showed its thickness the way a real slab
     would. It is correct and it reads as a bug — at six cards on a
     spiral the offset panels look like a second staircase standing
     behind the first, and the eye counts twelve objects where there are
     six. Depth on these comes from the bevel and the gradient below
     instead, which cost nothing and cannot be mistaken for another card.


     NO SLAB. The cards had edge walls for a while, folded back from the
     outline to give them thickness. Against this room they read as a grey
     shadow standing behind every card, so they are gone: each card is one
     lit panel turning in real 3D, with its bevel for an edge. */

  .spiral[data-on] .spiral-card {
    height: auto;
    gap: 0.5rem;
    padding: 0.95rem;
    /* Fade cards as they turn away from the camera. cos() of the angle between
       this card and the one being looked at, squared so the falloff is gentle
       near the front and quick around the back.

       A CARD RECEDES BY GOING INTO SHADOW, NOT BY GOING SEE-THROUGH.
       Fading one toward the ground turns it translucent, and a translucent
       card reads as a rendering state rather than as a card further away.
       `brightness` keeps it solid and takes the light off it, which is what
       happens to an object at the back of a lit room.

       The floor is higher now the card is dark grey: 0.3 of a grey card is
       indistinguishable from the room, so the falloff runs to 0.46 and the
       separation at the back is carried by the lit edge instead.

       Opacity still runs, but only over the last of the turn, so a card
       does not have to pop out of existence as it goes edge-on. */
    opacity: min(1, 0.32 + 1.1 * var(--facing));
    filter:
      brightness(calc(0.46 + 0.54 * var(--lit)))
      blur(calc((1 - var(--facing)) * 2.2px));
    /* The card at the head of the turn is nearer the reader as well as
       brighter. Small: it is the subject, not a pop-up. */
    scale: calc(1 + var(--lit) * 0.04);
  }

  .spiral[data-on] .spiral-card-icon {
    width: 2.25rem;
    height: 2.25rem;
  }
  .spiral[data-on] .spiral-card-desc {
    font-size: 0.8125rem;
  }
  .spiral[data-on] .spiral-link {
    padding-block: 0.4rem;
  }
  .spiral[data-on] .spiral-link-label {
    font-size: var(--text-body);
  }

  @media (width >= 64rem) {
    .spiral[data-on] .spiral-card {
      gap: 0.65rem;
      padding: 1.5rem;
    }
    .spiral[data-on] .spiral-card-icon {
      width: 2.5rem;
      height: 2.5rem;
    }
    .spiral[data-on] .spiral-card-desc {
      font-size: var(--text-small);
    }
    .spiral[data-on] .spiral-link {
      padding-block: 0.55rem;
    }
    .spiral[data-on] .spiral-link-label {
      font-size: var(--text-h3);
    }
  }

  /* ---------- The helix on a phone --------------------------------------
     Below 64rem the layout is one column, and one column has to hold the
     heading AND the stage inside a single pinned screen. The index list is
     what gives: it is a second copy of six links that are already on screen as
     six cards, and it is the only thing here that a phone cannot afford. The
     progress readout takes its place at a twelfth of the height and says the
     one thing the list was saying that the cards do not — where you are in the
     descent, and how much of it is left. */
  @media (width < 64rem) {
    .spiral[data-on] .spiral-viewport {
      align-items: stretch;
      padding-bottom: 1.25rem;
    }
    .spiral[data-on] .spiral-layout {
      grid-template-rows: auto minmax(0, 1fr);
      gap: 1rem;
      height: 100%;
    }
    /* The heading has to outrank the staircase.

       The helix RISES as it turns, so the cards above the camera travel up out
       of the stage and, in a single column, straight across the heading — the
       last card was legible over the middle of the h2. On the two-column
       layout this never came up, because the heading was beside the stage
       rather than above it.

       The fix is depth, not a clip: the heading is lifted onto its own layer
       with the section's ground carried up behind it, so a card climbing past
       goes UNDER the text instead of over it. The ground is opaque across the
       type and fades out below, which keeps every line at full contrast while
       letting the card reappear from behind the block rather than snapping
       into view at a hard edge. */
    .spiral[data-on] .spiral-menu {
      display: flex;
      flex-direction: column;
      position: relative;
      z-index: 1;
    }
    .spiral[data-on] .spiral-menu::before {
      content: "";
      position: absolute;
      z-index: -1;
      /* Bleeds past the gutters so a card cannot slip up the side of it, and
         all the way up to the header so the band between the two is clean.
         Above that line the cards disappear behind the header itself, which
         has its own opaque surface. */
      inset: calc(-1 * var(--header-h) - 1rem) calc(-1 * clamp(1.25rem, 4vw, 4.5rem)) -1.5rem;
      background-image: linear-gradient(
        to bottom,
        var(--color-ink-950) 0 76%,
        color-mix(in oklab, var(--color-ink-950) 72%, transparent) 90%,
        transparent 100%
      );
    }
    .spiral[data-on] .spiral-menu h2 {
      margin-top: 0.75rem;
      /* One step down from the section scale. The heading still leads, but on
         a 500px stage every line it wraps to is a line the staircase loses. */
      font-size: clamp(1.6rem, 1.15rem + 2vw, 2.1rem);
    }
    .spiral[data-on] .spiral-menu-title,
    .spiral[data-on] .spiral-list {
      display: none;
    }
    .spiral[data-on] .spiral-counter {
      display: grid;
      grid-template-columns: auto auto minmax(0, 1fr);
      align-items: center;
      gap: 0 0.4rem;
      margin-top: 1rem;
      font-size: 0.8125rem;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.08em;
      color: var(--color-prime-400);
    }
    .spiral-counter-slot {
      display: grid;
    }
    /* All six numerals share one grid cell and cross-fade, so the slot is as
       wide as the widest and never reflows as the count changes. The same
       trick the hero's report counter uses. */
    .spiral-counter-n {
      grid-area: 1 / 1;
      opacity: clamp(0, calc(1 - max(calc(var(--i) - var(--k)), calc(var(--k) - var(--i)))), 1);
    }
    .spiral-counter-total {
      color: var(--color-ink-400);
    }
    .spiral-counter-rail {
      display: block;
      height: 2px;
      margin-left: 0.6rem;
      border-radius: 2px;
      background-color: rgb(255 255 255 / 0.12);
      overflow: clip;
    }
    .spiral-counter-fill {
      display: block;
      height: 100%;
      transform: scaleX(var(--p));
      transform-origin: left;
      background-image: linear-gradient(to right, var(--color-amber-500), var(--color-prime-500));
    }
  }

  /* Belt and braces: even if [data-on] were set, reduced motion wins. */
  @media (prefers-reduced-motion: reduce) {
    .spiral[data-on] .spiral-track { min-height: 0; padding-block: 4rem 4.5rem; }
    .spiral[data-on] .spiral-viewport { position: static; height: auto; padding-top: 0; }
    .spiral[data-on] .spiral-stage { perspective: none; }
    .spiral[data-on] .spiral-spine { display: none; }
    .spiral[data-on] .spiral-ring {
      display: grid;
      position: static;
      transform: none;
      transform-style: flat;
    }
    .spiral[data-on] .spiral-item { position: static; width: auto; transform: none; }
    .spiral[data-on] .spiral-card { opacity: 1; filter: none; height: 100%; --lit: 1; }
    /* The list comes back and the readout goes away: with nothing moving there
       is no progress to report, and the index is the better control. */
    .spiral[data-on] .spiral-counter { display: none; }
    .spiral[data-on] .spiral-menu-title,
    .spiral[data-on] .spiral-list { display: revert; }
    .spiral[data-on] .spiral-layout { grid-template-rows: none; height: auto; }
  }
</style>

<script>
  /**
   * Drives the helix.
   *
   * Writes exactly one value, `--p`, and one attribute, `data-current`. All the
   * geometry is CSS, so this stays small and there is nothing to keep in sync.
   *
   * Reads are batched into a requestAnimationFrame, so a scroll burst produces
   * at most one layout read per frame, and `update()` exits early when the
   * section is nowhere near the viewport. That is cheaper and far more
   * predictable than gating the listener behind an IntersectionObserver, which
   * also left the helix stuck at step 0 whenever a page loaded already scrolled
   * into the section (a refresh mid-page, or an anchor link).
   */
  function initSpiral(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-spiral-track]');
    const links = [...root.querySelectorAll<HTMLElement>('[data-spiral-link]')];
    /* No track or no ring means no helix to drive, and `--p` would be a number
       nothing reads. */
    if (!track || !root.querySelector('[data-spiral-ring]')) return;

    /* Reduced motion is the ONLY gate. There used to be a width gate here as
       well — the helix ran from 48rem up and phones got the flat grid — but the
       geometry is all custom properties and a phone simply gets a smaller
       staircase. What a phone does not get is the pinned index beside it; see
       the `width < 64rem` block in the stylesheet. */
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    let frame = 0;
    let enabled = false;
    let current = -1;
    const holdQuery = window.matchMedia('(width < 64rem)');
    const items = [...root.querySelectorAll<HTMLElement>('[data-spiral-item]')];
    /* The lead-in's height, defined in CSS (`--lead`) and read off a probe,
       so it is whatever the stylesheet says: nothing where there is no
       hand-over from the hero, and a fixed share of the screen where there
       is. */
    const probe = root.querySelector<HTMLElement>('[data-spiral-lead]');

    const setCurrent = (index: number) => {
      if (index === current) return;
      current = index;
      for (let i = 0; i < links.length; i++) {
        if (i === index) links[i].setAttribute('data-current', '');
        else links[i].removeAttribute('data-current');
      }
    };

    const update = () => {
      frame = 0;
      if (!enabled) return;

      const rect = track.getBoundingClientRect();
      const travel = rect.height - window.innerHeight;
      if (travel <= 0) return;

      /* Nowhere near the viewport: nothing to draw, and no reason to write. */
      if (rect.bottom < -200 || rect.top > window.innerHeight * 2 + 200) return;

      /* THE LEAD-IN. Where the section fades in over the hero, the turn does
         not start until the fade has finished and the first card has been
         held square on for a moment: otherwise the staircase is already a
         step round by the time it is fully visible, and the first card is
         never seen. The track is made longer by the same distance (see
         `--lead`), so every card keeps its full share of the scroll. */
      const lead = probe ? probe.offsetHeight : 0;
      const p = Math.min(1, Math.max(0, (-rect.top - lead) / (travel - lead)));
      /* How far the section has risen into the screen, for its entrance: 0
         with its top at the foot of the viewport, 1 once it is two-thirds of
         the way up. The hero above fades to black over its last stretch, and
         this picks up from the same black, so the two read as one dissolve
         rather than a fade-out followed by a section scrolling in. */
      /* The section starts one screen early, under the end of the hero (see
         `.spiral[data-on]` in the styles), so its stage is already pinned in
         place when the hero has finished dissolving. It fades in from that
         moment — its top reaching the top of the screen — over the next
         third of a screen, and not a pixel before, so the two never share
         the screen. */
      const enter = Math.min(1, Math.max(0, -rect.top / (window.innerHeight * 0.3)));
      root.style.setProperty('--enter', enter.toFixed(3));
      root.toggleAttribute('data-entered', enter > 0.01);
      /* Written on the section, not on the ring: the ring turns by it and the
         progress readout fills by it, and one number feeding both is what
         stops them drifting apart. */
      root.style.setProperty('--p', p.toFixed(4));
      /* ON A PHONE EACH CARD HOLDS. The camera's position along the
         staircase, `--k`, normally turns continuously with the scroll, so a
         card is square on for a single instant on its way past. A phone has
         no index list beside the staircase to read instead, so there each
         card is held square on for the middle part of its own stretch of
         scroll and the turn to the next happens in between, eased at both
         ends. Wider screens keep the continuous turn. */
      const steps = links.length - 1;
      let k = p * steps;
      if (holdQuery.matches && steps > 0) {
        const base = Math.min(Math.floor(k), steps - 1);
        const t = Math.min(1, Math.max(0, (k - base - 0.28) / 0.44));
        k = base + t * t * (3 - 2 * t);
      }
      root.style.setProperty('--k', k.toFixed(4));
      setCurrent(Math.round(k));
      /* On a phone only the card being read and its neighbours are drawn;
         one two steps or more along is taken out entirely (see LIGHTER ON A
         PHONE), so it cannot catch a tap meant for the page. */
      for (let i = 0; i < items.length; i++) {
        items[i].toggleAttribute('data-far', holdQuery.matches && Math.abs(i - k) >= 1.9);
      }
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    const apply = () => {
      enabled = !still.matches;
      root.toggleAttribute('data-on', enabled);

      if (enabled) {
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        /* Seed from the current scroll position rather than waiting for the
           first scroll event, so a mid-page load renders the right step. */
        update();
      } else {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
        root.style.removeProperty('--p');
        root.style.removeProperty('--k');
        for (const item of items) item.removeAttribute('data-far');
        root.style.removeProperty('--enter');
        root.removeAttribute('data-entered');
        for (const link of links) link.removeAttribute('data-current');
        current = -1;
      }
    };

    still.addEventListener('change', apply);
    apply();
  }

  document.querySelectorAll<HTMLElement>('[data-spiral]').forEach((el) => initSpiral(el));
</script>
