---
/**
 * Homepage version of the fleet-challenge block: eight static links.
 *
 * Static rather than interactive on purpose. Each card is a real crawlable
 * link into the page that solves that problem, it needs no JavaScript, and it
 * gives the homepage eight strong internal links to commercial pages. The
 * interactive multi-select version lives on /analyze-your-fleet/.
 */
import { challenges } from '../data/challenges';
import { useTranslations, localizePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const items = t.home.challenges.items as Record<string, { label: string; body: string }>;
---

<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
  {
    challenges.map((challenge, i) => {
      const copy = items[challenge.key];
      /* Row index, not card index: cards in the same row resolve together.
         Four across on lg, two on sm, so the offset is expressed per card and
         the CSS divides it down at narrower breakpoints. */
      return (
        <li class="reveal-soft" style={`--n:${i % 4}`}>
          <a
            href={localizePath(challenge.href, locale)}
            class="group relative flex h-full flex-col rounded-[--radius-card] border border-ink-100 bg-white p-5
                   transition-[border-color,box-shadow,transform] duration-[--duration-base] ease-[--ease-prime]
                   hover:border-prime-300 hover:shadow-[--shadow-card] motion-safe:hover:-translate-y-0.5"
          >
            <span
              class="mb-3 inline-flex h-8 w-8 items-center justify-center rounded-full bg-prime-50 text-prime-700
                     transition-colors duration-[--duration-base] group-hover:bg-prime-500 group-hover:text-white"
              aria-hidden="true"
            >
              <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="text-h4 text-ink-950">{copy.label}</span>
            <span class="mt-2 text-[0.875rem] leading-snug text-ink-600">{copy.body}</span>
          </a>
        </li>
      );
    })
  }
</ul>
