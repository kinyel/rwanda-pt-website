---
/**
 * The hero journey: a vehicle travelling a route, driven entirely by scroll.
 *
 * THE IDEA. Formspree's hero flies their product, a form, into place. The
 * equivalent here is not a card: PrimeTrack's product is following a vehicle
 * along a route, so the scroll itself becomes the trip. A vehicle travels a
 * route down the right of the screen as you read, and each waypoint it reaches
 * reveals one of the things the unit actually reports. It is the only animation
 * on this site that is not decoration. It is the product, drawn.
 *
 * TWO COLUMNS, ONE EVENT. The right of the section is the trip: a vehicle on a
 * route, reaching four waypoints. The left of the section is what the unit on
 * board is reporting, and it is a pinned presentation rather than a list. The
 * four reports are panels on a drum turning in real CSS perspective past a
 * fixed read head, and the drum turns by exactly one report each time the
 * vehicle reaches a waypoint, because both are read off the same `--p`. They
 * cannot drift apart, which is the whole reason it works: it reads as one
 * instrument, not as two animations that happen to be side by side.
 *
 * DARK GROUND, REAL DEPTH. This section runs on ink-950, the same ground as
 * PageHero, the CTA block and the footer, and the rail on the right was drawn
 * against it: the white waypoint discs read as lit nodes and the orange trace
 * and its glow only resolve on a dark field.
 *
 * It used to carry a drawn terrain backdrop of stacked ridgelines as well.
 * Each ridge was a full-width band with a translucent orange fill and a
 * hairline edge, and they read as bumps striping the screen behind the two
 * things worth looking at. The component is gone, not disabled. What replaced
 * it is not another picture of depth: the reports genuinely sit at different
 * distances from the camera, so the section has depth because it has geometry.
 *
 * THE RAIL IS UNCHANGED. Its markup, classes, styles, path, waypoint values,
 * aspect ratio, sticky behaviour and driving script are all exactly as they
 * were. What did change is the section's HEIGHT: the report sequence needs
 * scroll to be pinned through, so the section went from about two screens to
 * about 3.6, and the same drive is therefore spread over more scroll. The
 * vehicle still starts at 0%, still finishes at 100%, and still reaches its
 * four waypoints at 8, 36, 64 and 92% of the section. It travels the same route
 * at a calmer pace. `--report-track` below is the single number that sets it.
 *
 * THE HANDOFF. The rail is `position: sticky` across the whole journey section.
 * The headline scrolls away beneath it, the report sequence pins alongside it,
 * and the rail stays put through both before releasing into the next section.
 * That is the point of the extra height: the element is not parked in the hero
 * and abandoned at its edge, it carries the reader across the seam.
 *
 * THE TECHNIQUE. One number, `--p`, is the journey's progress from 0 to 1.
 * Everything else is derived from it in CSS: the vehicle's position on the
 * route, how much of the route is lit, which stops have been reached, and which
 * one is currently being passed. Nothing can drift out of step with anything
 * else because there is only one source of truth.
 *
 * `--p` is written by a rAF-throttled scroll handler, the same mechanism the
 * product helix uses, rather than by `animation-timeline: view()`. That was the
 * first implementation and it is the more elegant one, but it ships only in
 * Chromium: Safari and Firefox would have had a static rail indefinitely. Since
 * the helix already needs a scroll handler, using it here too means one
 * mechanism in the codebase instead of two, and a journey that actually moves
 * for every visitor. The handler writes a single custom property and touches
 * nothing else; all the animation remains declarative CSS.
 *
 * The vehicle, the waypoint markers and the waypoint labels all sit on the SAME
 * `offset-path`, so the geometry is declared once and nothing needs manual
 * coordinates. Moving the route means editing one path string.
 *
 * DEGRADATION, in the order it is checked:
 *   - no `is-loaded` class (JS off)                     -> static, fully revealed
 *   - `prefers-reduced-motion: reduce`                  -> static, fully revealed
 *   - no `animation-timeline` support (Safari, Firefox) -> static, fully revealed
 *   - viewport under 1024px                             -> rail hidden, list stacks
 * In every one of those the copy is complete and the section reads as finished.
 * The animation adds emphasis; it never carries meaning on its own.
 *
 * Only transform, opacity, filter and offset-distance are animated, all of them
 * compositor-friendly. Nothing here can move layout.
 */
import Icon from './Icon.astro';
import Button from './Button.astro';
import { routes } from '../data/navigation';
import { useTranslations, localizePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);
const j = t.home.journey;

const specs = [j.specs.accuracy, j.specs.interval];


/* Waypoints in travel order.
   `at` is the position along the route as a percentage of its length; `x`/`y`
   are that same point in the SVG's 360x1000 user units, measured once with
   getPointAtLength rather than eyeballed. `side` puts the label on whichever
   side of the route has room at that point.

   Keeping both means the marker can be a plain SVG circle at a fixed
   coordinate, which renders correctly everywhere, while only the moving
   vehicle needs offset-path. */
const waypoints = [
  { key: 'position', icon: 'truck', at: 8, x: 152.8, y: 94.5, side: 'right' },
  { key: 'fuel', icon: 'fuel', at: 36, x: 220.6, y: 392.5, side: 'left' },
  { key: 'driver', icon: 'shield', at: 64, x: 64, y: 655.2, side: 'right' },
  { key: 'video', icon: 'video', at: 92, x: 189.2, y: 925.3, side: 'left' },
] as const;

/* THE CAR, in the route's own units, centred on its own middle with the nose
   pointing up the page. It is drawn as planes stacked straight up the screen
   (see `.journey-car-l`), so these outlines are a footprint, a glasshouse and
   a roof, not a picture of a car. One outline for the body is enough: at the
   size it is drawn, the silhouette is what reads as a car. */
const CAR_BODY =
  'M-7.5 -16 C-7.5 -19.4 -4.4 -21 0 -21 C4.4 -21 7.5 -19.4 7.5 -16 ' +
  'L8.6 -3 L8.6 15.4 C8.6 19.2 5.6 21 0 21 C-5.6 21 -8.6 19.2 -8.6 15.4 L-8.6 -3 Z';
const CAR_GLASS = 'M-7 -11.6 C-2.6 -13.6 2.6 -13.6 7 -11.6 L7.4 9.6 C3 11.2 -3 11.2 -7.4 9.6 Z';
const CAR_ROOF = 'M-5.6 -6.2 L5.6 -6.2 L5.8 6.6 L-5.8 6.6 Z';

/* The route. Declared once; the SVG normalises its own length via pathLength. */
const ROUTE = 'M 196 18 C 40 190, 336 320, 168 494 S 26 772, 252 988';
---

<section class="hero-journey on-dark relative bg-ink-950" data-nav="dark">
  <div class="journey-wash pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <!-- Rows of short dashes across the ground, pinned with the stage. -->
  <div class="journey-dashes" aria-hidden="true"><span></span></div>

  <div class="container-wide relative">
    <div class="journey-grid">
      <!-- ============ Left: the reading column ============ -->
      <div class="journey-column">
        <!-- Screen one: the hero proper. -->
        <div class="journey-panel">
          <p class="journey-eyebrow eyebrow mb-6 enter" style="--d:0">{t.home.hero.eyebrow}</p>
          <h1 class="journey-title text-display-xl text-white enter" style="--d:1">{t.home.hero.title}</h1>
          <p class="journey-lead mt-7 measure text-lead text-ink-300 enter" style="--d:2">{t.home.hero.lead}</p>

          <div class="journey-ctas mt-10 flex flex-wrap gap-3 enter" style="--d:3">
            <Button href={localizePath(routes.contact, locale)} variant="primary" size="lg">
              {t.home.hero.primaryCta}
            </Button>
            <Button href={localizePath(routes.solutions, locale)} variant="secondaryOnDark" size="lg">
              {t.home.hero.secondaryCta}
            </Button>
          </div>
        </div>

        <!-- Screen two: the report sequence the journey is travelling toward.

             This is a presentation, not a list. Once the drive is running it
             pins beside the rail and plays as an instrument: a meter fills
             with the trip, a read head holds one report at the focus line, and
             the strip of four reports glides up by exactly one row each time
             the vehicle on the right reaches a waypoint. Left and right are the
             same event, told twice.

             Everything below is ordinary readable markup first. The pinning,
             the clipping and the glide are added only under
             `[data-journey-live]` at lg and above, so a narrow screen, reduced
             motion or no JavaScript all get a plain, complete, stacked list. -->
        <div class="journey-panel journey-panel-payoff journey-report">
          <div class="journey-report-stage">
            <div class="journey-report-head">
              <div class="journey-report-meta">
                <p class="eyebrow">{j.eyebrow}</p>

                <!-- Decorative chrome for the sequence: the counter tells you
                     which report is being delivered. Hidden from the
                     accessibility tree because the reports themselves are
                     right there, numbered, in reading order. -->
                <p class="journey-counter" aria-hidden="true">
                  <span class="journey-counter-slot">
                    {waypoints.map((_point, i) => <span class="journey-counter-n" style={`--i:${i}`}>0{i + 1}</span>)}
                  </span>
                  <span class="journey-counter-total">/ 0{waypoints.length}</span>
                </p>
              </div>

              <div class="journey-meter" aria-hidden="true"><span class="journey-meter-fill"></span></div>

              <h2 class="journey-report-title text-h2 text-white">{j.title}</h2>

              <!-- Two lines in one slot. The lead holds until the last report
                   lands, then the closing line takes its place, so the
                   sequence finishes on a sentence instead of trailing off.
                   Both are always in the DOM and both are readable when the
                   sequence is not running. -->
              <div class="journey-report-say measure">
                <p class="journey-say journey-say-lead text-lead text-ink-300">{j.lead}</p>
                <p class="journey-say journey-say-closing text-lead text-ink-300">{j.closing}</p>
              </div>

              <dl class="journey-specs">
                {
                  specs.map((spec) => (
                    <div class="journey-spec">
                      <dt class="journey-spec-label">{spec.label}</dt>
                      <dd class="journey-spec-value">
                        {spec.value}
                        <span class="journey-spec-unit">{spec.unit}</span>
                      </dd>
                    </div>
                  ))
                }
              </dl>
            </div>

            <div class="journey-window">
              <div class="journey-window-clip">
                <!-- The camera, and nothing else. Perspective has to sit on the
                     strip's direct parent, and that parent must not clip or
                     mask: `overflow` and `mask-image` each force an element to
                     flatten, which would collapse the drum back into a flat
                     list. So the clip and the fade stay one level out. Same
                     split as the product helix. -->
                <div class="journey-window-cam">
                  <ol class="journey-strip">
                    {
                      waypoints.map((point, i) => (
                        <li class="journey-row" style={`--i:${i}; --at:${point.at / 100}`}>
                          <span class="journey-row-index" aria-hidden="true">
                            <span class="journey-row-n">0{i + 1}</span>
                            <span class="journey-row-spine"></span>
                          </span>
                          <span class="journey-row-text">
                            <span class="journey-row-label">
                              <span class="journey-row-icon"><Icon name={point.icon} size={14} /></span>
                              {j.waypoints[point.key].label}
                            </span>
                            <span class="journey-row-refrain">{j.waypoints[point.key].refrain}</span>
                            <span class="journey-row-body">{j.waypoints[point.key].body}</span>
                          </span>
                        </li>
                      ))
                    }
                  </ol>
                </div>
              </div>

              <!-- The read head. It never moves: the strip moves past it. The
                   hairline runs out into the gutter toward the rail, so the
                   report being delivered and the waypoint being reached read as
                   one instrument rather than two columns. -->
              <span class="journey-readhead" aria-hidden="true"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- ============ Right: the route ============ -->
      <div class="journey-rail">
        <div class="journey-stage enter enter-stage" style="--d:1">
          <!--
            One coordinate system for everything.

            The stage carries `aspect-ratio: 360 / 1000`, the same as the
            viewBox, so the SVG fills it with no letterboxing and one user unit
            is always one stage unit. SVG parts sit at measured coordinates;
            the HTML labels are positioned as percentages of the same box.
            Both therefore stay locked to the route at any rail height, which
            an HTML `offset-path` in pixels could never do against a viewBox
            that scales.
          -->
          <svg
            class="journey-svg"
            viewBox="0 0 360 1000"
            fill="none"
            preserveAspectRatio="xMidYMid meet"
            role="img"
            aria-label={j.railLabel}
          >
            <defs>
              <linearGradient id="journey-fade" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#f35d01" stop-opacity="0" />
                <stop offset="10%" stop-color="#f35d01" stop-opacity="1" />
                <stop offset="90%" stop-color="#f35d01" stop-opacity="1" />
                <stop offset="100%" stop-color="#f35d01" stop-opacity="0" />
              </linearGradient>
              <filter id="journey-car-soft" x="-80%" y="-80%" width="260%" height="260%">
                <feGaussianBlur stdDeviation="3.2" />
              </filter>
              <linearGradient id="journey-car-beam" x1="0" y1="1" x2="0" y2="0">
                <stop offset="0%" stop-color="#ffe9c8" stop-opacity="0.5" />
                <stop offset="100%" stop-color="#ffe9c8" stop-opacity="0" />
              </linearGradient>
              <filter id="journey-glow" x="-60%" y="-60%" width="220%" height="220%">
                <feGaussianBlur stdDeviation="7" result="b" />
                <feMerge>
                  <feMergeNode in="b" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
            </defs>

            <!-- The road ahead. -->
            <path d={ROUTE} stroke="#1b1f26" stroke-opacity="0.13" stroke-width="3" stroke-linecap="round" />

            <!-- The road already travelled, drawn in behind the vehicle. -->
            <!--
              `pathLength="1"` re-scales this path's own length to 1 unit, so
              the dash maths below is just `1 - progress` and carries no
              measured constant. Edit the route and the draw still works.
            -->
            <path
              class="journey-trace"
              d={ROUTE}
              pathLength="1"
              stroke="url(#journey-fade)"
              stroke-width="3.5"
              stroke-linecap="round"
              filter="url(#journey-glow)"
            />

            <!-- Waypoint markers, at measured points on the route. -->
            {
              waypoints.map((point, i) => (
                <g class="journey-marker" style={`--at:${point.at / 100}`}>
                  <circle cx={point.x} cy={point.y} r="17" fill="#ffffff" />
                  <circle cx={point.x} cy={point.y} r="17" fill="none" stroke="#f35d01" stroke-opacity="0.45" stroke-width="1.5" />
                  <circle cx={point.x} cy={point.y} r="4.5" fill="#f35d01" />
                </g>
              ))
            }

            <!-- THE VEHICLE: a car built from planes stacked up out of the road.
                 Every plane rides the same path at the same distance and turns
                 with it, and each is lifted a few units straight UP THE SCREEN,
                 whichever way the car is facing — which is what makes a pile of
                 flat outlines read as one solid body seen from above and behind.
                 The shadow stays on the road, offset in a fixed light, and the
                 headlights throw a beam ahead of it down the route. -->
            <g class="journey-car" aria-hidden="true">
              <g class="journey-car-l journey-car-halo" style="--k:0; --sway:0">
                <circle r="30" />
              </g>
              <g class="journey-car-l journey-car-shadow" style="--k:0; --sway:0">
                <path d={CAR_BODY} filter="url(#journey-car-soft)" />
              </g>
              <g class="journey-car-l journey-car-beam" style="--k:1; --sway:0">
                <path d="M-6 -20 L-30 -104 L30 -104 L6 -20 Z" fill="url(#journey-car-beam)" />
              </g>
              <g class="journey-car-l journey-car-chassis" style="--k:1; --sway:0">
                <path d={CAR_BODY} />
              </g>
              <g class="journey-car-l journey-car-side" style="--k:3.2; --sway:0.5">
                <path d={CAR_BODY} />
              </g>
              <g class="journey-car-l journey-car-body" style="--k:5.4; --sway:1">
                <path d={CAR_BODY} />
                <circle class="journey-car-head" cx="-4.6" cy="-19.4" r="1.7" />
                <circle class="journey-car-head" cx="4.6" cy="-19.4" r="1.7" />
                <rect class="journey-car-brake" x="-7" y="18.6" width="4.4" height="1.9" rx="0.8" />
                <rect class="journey-car-brake" x="2.6" y="18.6" width="4.4" height="1.9" rx="0.8" />
              </g>
              <g class="journey-car-l journey-car-glass" style="--k:7.6; --sway:1.4">
                <path d={CAR_GLASS} />
              </g>
              <g class="journey-car-l journey-car-roof" style="--k:9.4; --sway:1.7">
                <path d={CAR_ROOF} />
              </g>
            </g>
          </svg>

          <!-- Labels stay HTML so they wrap, translate and inherit type. -->
          {
            waypoints.map((point, i) => (
              <span
                class:list={['journey-label', `journey-label-${point.side}`]}
                style={`--x:${(point.x / 360) * 100}%; --y:${(point.y / 1000) * 100}%; --at:${point.at / 100}; --i:${i}`}
              >
                {j.waypoints[point.key].label}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>

</section>

<style>
  /* The route, declared once. Every element that rides it references this same
     string, so the geometry has exactly one definition. */
  @property --journey-progress {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 0%;
  }

  /* ---------------------------------------------------------------------
     THE HERO ARRIVES.

     The site's reveal system deliberately never touches anything above the
     fold — it only hides what starts below it, so nothing can be left
     invisible by an observer callback that never comes. That is the right
     rule and it leaves the one screen everybody sees with no entrance at
     all, so the hero gets its own: a plain CSS animation on load, no
     observer, no script, nothing that can fail to fire.

     WHY THE ORDER IS THIS ORDER. Four beats at 110ms, which is slow enough
     to read as a sequence and short enough that the whole thing is over in
     under a second: kicker, headline, lead, buttons. The model comes in on
     the headline's beat rather than after the buttons, because it is the
     other half of the first impression and arriving last would make it
     read as an afterthought loading in.

     AND THE DELAYS ARE SMALL ON PURPOSE. Largest Contentful Paint ignores
     an element while its opacity is zero, so a long start delay on the
     headline would push LCP back by exactly that delay. 110ms is inside
     the noise; a fashionable 600ms stagger would not be. */
  .enter {
    animation: hero-enter var(--duration-enter) var(--ease-out) both;
    animation-delay: calc(var(--d, 0) * 110ms);
  }
  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  /* The model does not rise, it settles: it is an object in space, and an
     object that slides up from below is a card. */
  .enter-stage {
    animation-name: hero-enter-stage;
    animation-duration: 1100ms;
  }
  @keyframes hero-enter-stage {
    from {
      opacity: 0;
      transform: scale(0.88) translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .enter {
      animation: none;
    }
  }

  .journey-wash {
    /* One soft field where the route runs, plus the contour motif at section
       scale, and nothing else.

       The contour is `bg-contour-prime` re-pitched for a box this tall: the
       utility's own 34px repeat is tuned for a one-screen hero and would band
       three and a half screens into stripes. Same motif, same lighting, one
       number different.

       This hero used to carry a drawn terrain backdrop as well: stacked
       ridgelines, each a full-width band with a translucent orange fill and a
       hairline edge. They read as bumps banding the whole screen, and they
       competed with the route on the right and the report sequence on the
       left, which are the two things actually worth looking at. They are gone.
       The depth in this section is now real depth: the reports are a drum
       turning in perspective, not a picture of a landscape. */
    background-image: radial-gradient(44% 38% at 77% 44%, rgb(243 93 1 / 0.20), transparent 72%);
  }

  .hero-journey {
    position: relative;
    /* The shared camera. Every depth in the terrain is derived from it, so
       the focal length is one number rather than a constant repeated in each
       layer's counter-scale. */
    --lens: 1600;

    /* How much scroll the pinned report sequence is given, and therefore the
       section's total height: one screen of headline plus this. It is the one
       number that sets the pace of everything here, the drive on the right
       included, so it is declared once, at the top, rather than buried in the
       rule that uses it. Only applied in the driven state. */
    --report-track: 360svh;

    /* The report drum.
       The four reports are not a list that slides, they are panels on a drum
       that turns past a fixed read head. `--drum-radius` is how far a report
       one step from the head sits back from the screen, `--drum-step` is how
       far it has turned by then, and `--drum-lens` is the camera. Together
       they are the whole of the 3D: everything else is the same two numbers,
       `--p` and `--adv`, that drive the flat version. */
    --drum-lens: 1180px;
    --drum-radius: 104px;
    --drum-step: 10deg;

    /* `clip`, never `hidden`.
    
       `overflow: hidden` turns this into a scroll container, and a scroll
       container becomes the scrollport its sticky descendants position
       against. The rail would then be sticky relative to a box that never
       scrolls, so it just rides the page instead of pinning, and the whole
       journey stops tracking scroll. `clip` keeps the report drum inside the
       section without creating a scrollport. */
    overflow: clip;
  }

  /* =====================================================================
     ONE CLOCK, READ BY BOTH COLUMNS.

     `--adv` is how many reports have been delivered, 0 to 3, as a
     continuous number. It is the only thing that says which report is the
     current one, and it now lives on the SECTION rather than inside the
     left column, because the route's labels on the right have to answer
     the same question and there must not be two answers to it.

     One ramp per advance, each 9.1% of the section long and CENTRED on its
     waypoint, so the strip is exactly half way through its glide at the
     moment the vehicle reaches the stop. Smoothstepped (x²(3-2x)) so the
     glide eases in and out instead of sliding at a constant rate.

     The glide was 6.25% and is now 9.1%, about 220px of scroll rather than
     150. A handover has three things to do in that window -- let the old
     report go, change the pin on the model, bring the new report in -- and
     at 150px they were all happening at once, which is what made the
     change read as a jump rather than as a move.

     Every consumer derives the same two numbers from it: `--dist`, how far
     a given index is from the current one, and `--cur`, 1 at the read head
     and 0 a full step away. The report row, the counter digit and the pin
     standing on the model all use that identical expression, so a pin
     cannot appear before, after or without its report. It is not that they
     are kept in step; there is only one thing to be in step with. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-journey[data-journey-live] {
      --a1: clamp(0, (var(--p, 0) - 0.4545) * 11, 1);
      --a2: clamp(0, (var(--p, 0) - 0.6245) * 11, 1);
      --a3: clamp(0, (var(--p, 0) - 0.7945) * 11, 1);
      --adv: calc(
        var(--a1) * var(--a1) * (3 - 2 * var(--a1)) + var(--a2) * var(--a2) * (3 - 2 * var(--a2)) +
          var(--a3) * var(--a3) * (3 - 2 * var(--a3))
      );
    }
  }

  /* ---------- Base: one column, everything static and readable ---------- */
  .journey-grid {
    display: grid;
    gap: 3rem;
  }

  .journey-panel {
    padding-block: 4.5rem;
  }

  .journey-panel-payoff {
    padding-top: 0;
  }

  /* THE TWO BUTTONS STAY SIDE BY SIDE ON A PHONE. At full size the pair is
     364px wide and wraps to two rows on anything narrower than about 404px,
     which is most phones. Below 40rem they share the row in equal halves,
     with the type and padding stepped down just enough for both labels to
     fit whole down to a 320px screen, and capped so that on a large phone
     they do not stretch into two slabs. `min-width: max-content` is the
     guard: a label longer than its half (a translation, say) sends the pair
     back onto two rows rather than clipping or wrapping a label. */
  @media (width < 40rem) {
    .journey-ctas :global(.btn) {
      flex: 1 1 0;
      min-width: max-content;
      max-width: 14rem;
      padding-inline: 1rem;
      font-size: 1rem;
    }
  }
  /* THE OPENING, TIGHTER ON A PHONE. Each piece a step smaller and the
     gaps between them closed up, so the four read as one block rather than
     four things spaced down a tall screen. The heading stays the loudest
     thing by a distance; it just stops wrapping to three lines at 320px. */
  @media (width < 40rem) {
    .journey-eyebrow {
      margin-bottom: 0.875rem;
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
    }
    .journey-title {
      font-size: clamp(2.25rem, 10vw, 2.5rem);
      line-height: 1.06;
    }
    .journey-lead {
      margin-top: 1rem;
      font-size: 1rem;
      line-height: 1.6;
    }
    .journey-ctas {
      margin-top: 1.5rem;
      gap: 0.625rem;
    }
    .journey-ctas :global(.btn) {
      min-height: 2.875rem;
      padding-block: 0.625rem;
    }
  }

  @media (width < 22.5rem) {
    .journey-ctas {
      gap: 0.5rem;
    }
    .journey-ctas :global(.btn) {
      padding-inline: 0.75rem;
      font-size: 0.9375rem;
    }
  }

  /* On a narrow screen the route stands ABOVE the copy as its own band — a
     tall strip, centred, with its stops' names either side of it — so the car
     and its route are on screen at every width. See THE ROUTE AND THE CAR. */
  .journey-rail {
    order: -1;
    display: flex;
    justify-content: center;
    height: var(--rail-h);
    padding-block: 0.75rem;
  }


  /* ---------- The report sequence, static ------------------------------
     This is the whole of it on a phone, under reduced motion, and with no
     JavaScript: a heading, two sentences, two figures and four numbered
     reports, stacked and complete. The presentation in the lg block adds
     pinning, clipping and movement on top of exactly this markup, and adds
     nothing that carries meaning on its own. */
  .journey-report-head {
    display: flex;
    flex-direction: column;
  }
  .journey-report-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* Chrome for the scroll sequence, and meaningless without it. */
  .journey-counter,
  .journey-meter,
  .journey-readhead {
    display: none;
  }

  .journey-report-title {
    margin-top: 1.25rem;
  }

  .journey-report-say {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.85rem;
  }

  .journey-specs {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 3rem;
  }
  .journey-spec {
    display: flex;
    flex-direction: column;
  }
  /* DOM order is dt then dd, which is the only order a definition list may
     have. `order` puts the figure above its label without inverting it. */
  .journey-spec-value {
    order: 0;
    display: flex;
    align-items: baseline;
    gap: 0.04em;
    margin: 0;
    font-size: var(--text-stat);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--color-white);
  }
  .journey-spec-unit {
    font-size: 0.45em;
    font-weight: 700;
    color: var(--color-prime-400);
  }
  .journey-spec-label {
    order: 1;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-ink-400);
  }

  .journey-window {
    position: relative;
    margin-top: 2.5rem;
  }
  .journey-strip {
    display: grid;
    gap: 1.75rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    padding-top: 2rem;
  }
  /* ONE REPORT, AS A SPREAD.

     The four were a numbered list: a small grey figure, a tracked label
     with the icon sitting in the middle of it like a word, and two lines of
     text. Three sizes and no structure, so nothing led and the eye had to
     start at the top of each one and work out what it was looking at.

     They are set as an editorial spread instead. An index column on the
     left carries the figure and a hairline that runs down beside the report
     it numbers; the text column carries a kicker, a statement and a note,
     in that order, each clearly a different kind of thing.

     THE HAIRLINE IS THE TIE TO THE ROUTE. It is the same object as the tick
     beside each stop's label on the right: same orange, same hairline, and
     it lights for the report being delivered exactly as the label comes up
     for the stop being reached. The left column and the right column are
     one instrument, and now they look like it. */
  .journey-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 1.15rem;
    align-items: start;
  }
  .journey-row-index {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    justify-items: center;
    gap: 0.55rem;
    /* Stretches so the hairline can run the height of its own report rather
       than a fixed length that is wrong for every other row. */
    align-self: stretch;
  }
  .journey-row-n {
    font-size: 1rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    /* Matched to the icon chip opposite it, so the figure and the kicker
       sit on one line without either being nudged by hand. */
    line-height: 1.5rem;
    color: var(--color-ink-500);
  }
  .journey-row-spine {
    width: 1px;
    min-height: 1.25rem;
    background-image: linear-gradient(to bottom, rgb(255 255 255 / 0.14), transparent);
  }
  .journey-row-text {
    display: grid;
    gap: 0.5rem;
  }
  .journey-row-label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    line-height: 1.5rem;
    text-transform: uppercase;
    color: var(--color-prime-400);
  }
  /* The icon gets a chip of its own. Inline, it read as a picture dropped
     into the middle of a phrase; boxed, the kicker reads as an instrument
     label. Same hairline and radius as the card standing on the model. */
  .journey-row-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid rgb(255 125 41 / 0.3);
    border-radius: 0.45rem;
    background-color: rgb(255 125 41 / 0.07);
  }
  .journey-row-refrain {
    font-size: var(--text-h4);
    font-weight: 700;
    line-height: 1.26;
    letter-spacing: -0.012em;
    color: var(--color-white);
    text-wrap: balance;
  }
  .journey-row-body {
    max-width: 44ch;
    font-size: var(--text-small);
    line-height: 1.62;
    color: var(--color-ink-300);
  }

  /* TWO ACROSS ON A PHONE.

     Four full-width reports is four screenfuls for a set the reader is
     meant to take in as a group — they are one instrument's four outputs,
     and reading them as a 2x2 is how you see that. The index column stays
     (the numerals are what pair the strip to the model) but loses its
     hairline and most of its width, because at 160px a column of furniture
     is a column of text not written. */
  @media (width < 64rem) {
    .journey-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.6rem 1.15rem;
    }
    .journey-row {
      column-gap: 0.6rem;
    }
    .journey-row-spine {
      display: none;
    }
    .journey-row-index {
      align-self: start;
    }
    .journey-row-n {
      font-size: 0.875rem;
      line-height: 1.25rem;
    }
    .journey-row-text {
      gap: 0.4rem;
    }
    .journey-row-label {
      gap: 0.4rem;
      font-size: 0.625rem;
      letter-spacing: 0.13em;
      line-height: 1.25rem;
    }
    .journey-row-icon {
      width: 1.25rem;
      height: 1.25rem;
      border-radius: 0.35rem;
    }
    .journey-row-refrain {
      font-size: 1rem;
      line-height: 1.26;
    }
    .journey-row-body {
      font-size: 0.8125rem;
      line-height: 1.5;
    }
  }

  @media (width >= 40rem) {
    .journey-panel {
      padding-block: 6rem;
    }
    .journey-panel-payoff {
      padding-top: 0;
    }
  }

  /* ---------- From lg: two columns, the rail pinned beside them --------- */
  @media (width >= 64rem) {
    .journey-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
      gap: 3rem;
      align-items: start;
    }

    /* Each panel holds roughly a screen, which is what gives the pinned rail
       something to be pinned through. */
    .journey-panel {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: calc(100svh - var(--header-h));
      padding-block: 3rem;
    }

    .journey-rail {
      order: 0;
      position: sticky;
      top: var(--header-h);
      height: calc(100svh - var(--header-h));
      padding-block: 2rem;
    }

    /* ---------- Driven state -------------------------------------------
       Everything above is the finished, static composition. The rules below
       only apply once the handler has taken over (`data-journey-live`), so a
       failed script, a blocked module or JavaScript off all leave the section
       complete rather than blank. Reduced motion opts out too. */
    @media (prefers-reduced-motion: no-preference) {
      /* ================================================================
         THE REPORT SEQUENCE
         ================================================================
         The left column stops being a list and becomes an instrument. It
         pins beside the rail, a meter fills with the trip, and a strip of
         four reports glides up by exactly one row each time the vehicle
         reaches a waypoint. Both columns are driven by the same `--p`, so
         the report being delivered and the waypoint being reached are the
         same event: they cannot drift.

         Waypoint one, at 8% of the section, is deliberately not an advance.
         Eight percent of the section is always inside the first screen, so
         it fires while the headline still fills the view and this stage is
         below the fold. The stage therefore arrives with report one already
         standing, which is the correct reading: the unit was reporting
         before you scrolled to look at it. The three advances the reader
         can actually see are locked to waypoints two, three and four. */

      /* Track length. The stage is one screen tall and sticky; this is the
         scroll it is pinned for. Raise it and every beat gets more room and
         the drive on the right plays more slowly; lower it and the reverse.
         It is the only number that governs the section's total height. */
      .hero-journey[data-journey-live] .journey-report {
        min-height: 0;
        height: var(--report-track);
        padding-block: 0;
        /* `.journey-panel` centres its content, which is right for the
           headline screen and wrong here: a sticky element starts pinning from
           its static position, so centring it inside a track this tall parks it
           half a track down and it does not pin until most of the drive is
           already over. The stage must start at the top of its own track. */
        justify-content: flex-start;
      }

      .hero-journey[data-journey-live] .journey-report-stage {
        position: sticky;
        top: var(--header-h);
        height: calc(100svh - var(--header-h));
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-block: 1.25rem;

        /* A floor under the row pitch, and where in the window the report
           being delivered sits. The pitch itself is not fixed: see the strip.

           The read head sits a little over half a report down rather than at
           the top of the window. That half report of clearance above it is
           what makes the drum legible AS a drum: the report just delivered
           turns up and away over the top edge at the same moment the next one
           turns up into the light from below. With the head at the top you
           only ever see one side of the rotation, which reads as a list
           fading rather than as an object turning. */
        --row-h: clamp(5.5rem, 12.5svh, 7.5rem);
        /* 0.62 of a row, not 0.55. Everything below the read head is empty
           once the last report has reached it, so every pixel the head
           sits further down is a pixel of dead space removed from the end
           of the section — and the clearance it gives up at the top is
           filled by the reports still to come. */
        --focus: calc(var(--row-h) * 0.62);
      }

      /* `--cur` is 1 for the report currently at the read head and falls to 0
         one step away, so consecutive reports cross-fade and the emphasis is
         never in two places. `--ahead` marks the ones not yet delivered.

         `--off` is the same distance kept SIGNED: negative for reports already
         delivered, positive for the ones still to come. The sign is what makes
         a drum rather than a stack. Reports above the head tip their top away,
         reports below tip their bottom away, and the one at the head is the
         only panel square to the camera. `--dist` is its magnitude, used for
         depth and focus, which have no direction.

         `abs()` is deliberately not used here: it is recent enough that Safari
         and Firefox versions still in real use would drop the whole
         declaration. `max(x, -x)` is the same value everywhere. */
      .hero-journey[data-journey-live] .journey-row,
      .hero-journey[data-journey-live] .journey-counter-n {
        --off: calc(var(--i) - var(--adv));
        --dist: max(calc(var(--adv) - var(--i)), calc(var(--i) - var(--adv)));
        --cur: clamp(0, 1 - var(--dist), 1);
        --ahead: clamp(0, calc(var(--i) - var(--adv)), 1);
      }

      /* ---- Header chrome ---- */
      .hero-journey[data-journey-live] .journey-meter {
        display: block;
        height: 2px;
        margin-top: 0.7rem;
        border-radius: 2px;
        background-color: rgb(255 255 255 / 0.12);
        overflow: clip;
      }
      .hero-journey[data-journey-live] .journey-meter-fill {
        display: block;
        height: 100%;
        transform: scaleX(var(--p));
        transform-origin: left;
        background-image: linear-gradient(to right, var(--color-amber-500), var(--color-prime-500));
      }

      .hero-journey[data-journey-live] .journey-counter {
        display: flex;
        align-items: baseline;
        gap: 0.3rem;
        font-size: 0.8125rem;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.08em;
        color: var(--color-prime-400);
      }
      .hero-journey[data-journey-live] .journey-counter-slot {
        display: grid;
      }
      .hero-journey[data-journey-live] .journey-counter-n {
        grid-area: 1 / 1;
        opacity: var(--cur);
      }
      .hero-journey[data-journey-live] .journey-counter-total {
        color: var(--color-ink-400);
      }

      .hero-journey[data-journey-live] .journey-report-title {
        margin-top: 0.85rem;
      }

      /* Two sentences sharing one slot. The lead holds until the last report
         lands and the closing line takes over, so the sequence finishes on a
         sentence. Sharing a grid cell means the slot is as tall as the taller
         of the two and never resizes mid-transition. */
      .hero-journey[data-journey-live] .journey-report-say {
        display: grid;
        margin-top: 0.75rem;
        gap: 0;
      }
      .hero-journey[data-journey-live] .journey-say {
        grid-area: 1 / 1;
        font-size: var(--text-body);
      }
      .hero-journey[data-journey-live] .journey-say-lead {
        opacity: calc(1 - var(--a3));
      }
      .hero-journey[data-journey-live] .journey-say-closing {
        opacity: var(--a3);
      }

      /* The two figures shrink to a caption line: at this size they annotate
         the sequence rather than competing with the heading for the eye. */
      .hero-journey[data-journey-live] .journey-specs {
        margin-top: 0.85rem;
        gap: 0 1.75rem;
      }
      .hero-journey[data-journey-live] .journey-spec {
        flex-direction: row;
        align-items: baseline;
        gap: 0.4rem;
      }
      .hero-journey[data-journey-live] .journey-spec-value {
        font-size: 1.375rem;
        letter-spacing: -0.02em;
      }
      .hero-journey[data-journey-live] .journey-spec-label {
        margin-top: 0;
        font-size: 0.75rem;
      }

      /* ---- The strip ---- */
      /* The window is capped at roughly three rows rather than taking all the
         space the stage has. Uncapped, a tall screen shows all four rows at
         once, which both gives the ending away and leaves the strip standing
         empty under the read head once the last report has landed. Capped, the
         composition is the same shape on every screen and the spare height
         goes to the heading instead. */
      .hero-journey[data-journey-live] .journey-window {
        position: relative;
        flex: 1;
        min-height: 0;
        /* 2.5 rows, not 3. The window has to be tall enough to show the
           turn either side of the head and no taller: the half row this
           gives up was only ever visible at the END of the sequence, as a
           blank below the final report, which read as the section having
           stopped half a screen before it ended. */
        max-height: calc(var(--row-h) * 2.5 + 0.75rem);
        margin-top: 1.75rem;
      }

      /* `clip`, not `hidden`, for the same reason the section uses it. The
         fade at both ends is what lets the drum turn out of view instead of
         being cut off at a hard edge. */
      .hero-journey[data-journey-live] .journey-window-clip {
        height: 100%;
        overflow: clip;
        mask-image: linear-gradient(to bottom, transparent 0, #000 14%, #000 80%, transparent 100%);
      }

      /* The camera. It holds the perspective and nothing else, because both
         `overflow` and `mask-image` force an element to flatten and either one
         on this element would render the drum as a flat list. Keeping the clip
         and the fade one level out is the same split the product helix uses.

         The vanishing point sits on the read head, not in the middle of the
         window: the report being delivered is the one the camera is square to,
         so it is the one that stays undistorted. */
      .hero-journey[data-journey-live] .journey-window-cam {
        height: 100%;
        perspective: var(--drum-lens);
        perspective-origin: 24% calc(var(--focus) + var(--row-h) * 0.5);
      }

      /* `1fr` rows, not a fixed height. Every row is then exactly as tall as
         the tallest one, whatever the column width or the language does to the
         line count, and one row is always exactly 25% of the strip. That is
         what the glide translates by, so the read head lands on a row boundary
         at every width instead of only the one this was designed at. A fixed
         pitch collides the moment a body wraps to a third line. */
      .hero-journey[data-journey-live] .journey-strip {
        display: grid;
        grid-auto-rows: 1fr;
        gap: 0;
        border-top: 0;
        padding-top: 0;
        /* The strip moves; the read head does not. The rows carry their own
           depth and rotation, so this stays a 3D context rather than
           flattening them into it. */
        transform-style: preserve-3d;
        transform: translateY(calc(var(--focus) - var(--adv) * 25%));
      }

      /* One report, as a panel on the drum.

         Depth is `--dist`, so a report is equally far back whether it has been
         delivered or is still coming. Rotation is `--off`, so the two sides
         turn opposite ways. The small sideways push is `--ahead` only: the
         reports still to come sit a little further into the gutter, which
         opens the diagonal the read head runs along, while the delivered ones
         stay in the left margin where the eye last read them.

         The blur is depth of field, not decoration: it comes from the same
         distance that sets the Z, so the plane in focus is exactly the plane
         the camera is square to. */
      .hero-journey[data-journey-live] .journey-row {
        align-content: start;
        min-height: var(--row-h);
        padding-block: 0.15rem 0.75rem;
        /* Presence falls off with distance, not with a flag: the report next
           in line is visibly next, and the two behind it are further back
           still. A flat "everything not current" dim made the lower half of
           the drum read as one grey mass. */
        opacity: calc((0.34 + 0.66 * var(--cur)) * clamp(0, 1 - var(--dist) * 0.3, 1));
        filter: blur(calc(var(--dist) * 0.6px));

        /* The panel itself. Text alone tilting in space reads as text that has
           been skewed; a surface tilting reads as an object, because the eye
           gets an edge and a fill to judge the angle against. This is the
           faintest surface that does that job: a warm wash that only the
           report at the read head carries, no border and no shadow, so it
           lights the current panel rather than boxing it. */
        border-radius: 0.85rem;
        background-image: linear-gradient(
          100deg,
          color-mix(in oklab, var(--color-prime-500) calc(var(--cur) * 15%), transparent),
          transparent 54%
        );
        transform:
          translate3d(
            calc(var(--ahead) * 0.7rem),
            0,
            calc(var(--dist) * var(--drum-radius) * -1)
          )
          rotateX(calc(var(--off) * var(--drum-step) * -1));
      }

      /* The index column lights as a unit: figure, hairline and chip all
         come up together for the report at the read head, and all three are
         the same orange as the pin standing on the stop being reached. */
      .hero-journey[data-journey-live] .journey-row-n {
        font-size: 1.5rem;
        letter-spacing: -0.012em;
        transform: scale(calc(1 + var(--cur) * 0.2));
        transform-origin: 50% 0;
        color: color-mix(in oklab, var(--color-prime-400) calc(var(--cur) * 100%), var(--color-ink-600));
      }
      .hero-journey[data-journey-live] .journey-row-spine {
        background-image: linear-gradient(
          to bottom,
          color-mix(in oklab, var(--color-prime-400) calc(14% + var(--cur) * 72%), transparent),
          transparent
        );
      }
      .hero-journey[data-journey-live] .journey-row-icon {
        border-color: color-mix(in oklab, var(--color-prime-400) calc(20% + var(--cur) * 58%), transparent);
        background-color: color-mix(in oklab, var(--color-prime-500) calc(3% + var(--cur) * 15%), transparent);
      }

      .hero-journey[data-journey-live] .journey-row-refrain {
        font-size: var(--text-h3);
        line-height: 1.2;
      }

      .hero-journey[data-journey-live] .journey-row-body {
        /* Only the report at the read head spells itself out. The others stay
           readable as a label and a statement, which is what makes room for
           the type to be this large without the column turning into a wall. */
        opacity: calc(0.22 + 0.78 * var(--cur));
      }

      /* The read head. Fixed to the focus line, running out into the gutter
         toward the rail, so the report being delivered and the waypoint being
         reached read as one instrument instead of two columns. */
      .hero-journey[data-journey-live] .journey-readhead {
        display: block;
        position: absolute;
        left: -1.5rem;
        right: -2.5rem;
        top: var(--focus);
        height: 1px;
        background-image: linear-gradient(
          to right,
          var(--color-prime-500) 0 1.75rem,
          color-mix(in oklab, var(--color-prime-500) 42%, transparent) 1.75rem 58%,
          color-mix(in oklab, var(--color-prime-500) 10%, transparent) 100%
        );
      }
      .hero-journey[data-journey-live] .journey-readhead::before {
        content: '';
        position: absolute;
        left: -1px;
        top: -4.5px;
        width: 3px;
        height: 10px;
        background-color: var(--color-prime-500);
        animation: journey-live var(--duration-pulse) ease-in-out infinite;
      }
      @keyframes journey-live {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
      }
    }
  }


  /* =====================================================================
     THE ROUTE AND THE CAR — at every width
     ===================================================================== */

  .hero-journey {
    /* How tall the route stands above the copy on a narrow screen. */
    --rail-h: 38svh;
    /* The car's size in route units. The route is drawn in a 360 x 1000 box
       that shrinks with the screen, so the car is scaled up where the route
       is smallest, to stay a car rather than a speck. */
    --car-scale: 1.35;
  }

  /* The static (no-script) band on a phone is short, so the car is scaled up
     there to stay a car rather than a speck. When the hero is live the route
     stands the full height of the screen behind the copy and needs no help. */
  @media (width < 64rem) {
    .hero-journey:not([data-journey-live]) {
      --car-scale: 1.9;
    }
  }

  /* The car's suspension: a registered number so the body planes can read the
     current value of a running animation in their own `translate`. */
  @property --car-bob {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  /* Same ratio as the viewBox, so SVG user units and percentage positions
     describe the same points. */
  .journey-stage {
    position: relative;
    height: 100%;
    aspect-ratio: 360 / 1000;
  }

  .journey-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    position: relative;
    z-index: 1;
  }

  /* The lit road. `pathLength="1"` means one dash covers the whole route, so
     offsetting by `1 - distance` reveals it from the start. The static state
     is fully drawn, which is the finished composition. */
  .journey-trace {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  /* Each label stands beside ITS OWN STOP, a short tick away from the dot,
     on the side of the line that is clear there (`side` in the waypoint
     data, checked against the route at each stop). They used to be pinned
     to the edges of the whole route box, which put some of them well over a
     hundred pixels from the stop they name. */
  .journey-label {
    position: absolute;
    z-index: 1;
    left: var(--x);
    top: var(--y);
    max-width: 9.5rem;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-ink-100);
    text-wrap: balance;
  }
  .journey-label-right {
    transform: translate(2.1rem, -50%);
  }
  .journey-label-left {
    transform: translate(calc(-100% - 2.1rem), -50%);
    text-align: right;
  }
  /* The tick runs from the label to just outside the stop's disc. */
  .journey-label::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0.75rem;
    height: 1px;
    background-color: var(--color-prime-300);
  }
  .journey-label-right::after {
    right: 100%;
    margin-right: 0.35rem;
  }
  .journey-label-left::after {
    left: 100%;
    margin-left: 0.35rem;
  }

  /* ---------- the car ----------
     Every plane rides the route at the car's distance and turns with it
     (`offset-rotate: auto` plus a quarter turn, because the outline is drawn
     nose-up). `translate` is applied OUTSIDE the path transform, so `--k`
     lifts each plane straight up the screen whatever way the car is
     heading: the planes stack into a body seen from above and behind, the
     way an isometric drawing stacks them. `--sway` is how much a plane rides
     the suspension — the roof most, the chassis not at all. */
  .journey-car-l {
    offset-path: path('M 196 18 C 40 190, 336 320, 168 494 S 26 772, 252 988');
    offset-distance: calc(var(--trip, 0) * 100%);
    offset-rotate: auto 90deg;
    /* `transform` is applied innermost — before the path moves the plane —
       so this scales the car about its own middle; the lift is scaled with
       it so the body keeps its proportions. */
    transform: scale(var(--car-scale));
    translate: 0 calc((var(--k) + var(--car-bob) * var(--sway)) * var(--car-scale) * -1px);
  }

  /* The road's shadow of the car: fixed light from the upper left, so it
     falls down and to the right whichever way the car is pointing. */
  .journey-car-shadow {
    translate: calc(4px * var(--car-scale)) calc(6px * var(--car-scale));
  }
  .journey-car-shadow path {
    fill: #000;
    fill-opacity: 0.7;
  }

  /* The signal it is sending, on the road around it. */
  .journey-car-halo circle {
    fill: #f35d01;
    fill-opacity: 0.14;
    stroke: #f35d01;
    stroke-opacity: 0.35;
    stroke-width: 1;
  }

  .journey-car-beam {
    opacity: 0.55;
  }

  /* Lit from above: the planes brighten as they rise. */
  .journey-car-chassis path {
    fill: #160a03;
  }
  .journey-car-side path {
    fill: #7a3409;
  }
  .journey-car-body path {
    fill: #ff7d29;
  }
  .journey-car-glass path {
    fill: #120c08;
  }
  .journey-car-roof path {
    fill: #ffb27a;
  }
  .journey-car-head {
    fill: #fff6e6;
  }
  .journey-car-brake {
    fill: #ff2d14;
    opacity: 0.35;
  }

  /* ---------- the dash field ----------
     The same field as synovika.com, built the same way: one
     `repeating-radial-gradient` of 1px rings, 34px apart, in a 120vw x 18.4vw
     ellipse centred at 78% 8% of a full-screen box. The rings are so flat
     that a 1px hard-edged line breaks up into short dashes when the browser
     rasterises it — that breaking-up IS the dash pattern, which is why it is
     reproduced with the identical gradient on an identical box rather than
     with an imitation tile: anything else would be a different pattern.
     Pinned to the screen, like theirs, so it holds still while the stage
     plays over it. The box starts at the top of the screen (under the bar),
     as theirs does, so the rings fall in the same place. */
  .journey-dashes {
    position: sticky;
    top: 0;
    height: 100svh;
    margin-top: calc(-1 * var(--header-h));
    margin-bottom: calc(var(--header-h) - 100svh);
    pointer-events: none;
  }

  .journey-dashes span {
    position: absolute;
    inset: 0;
    /* Quieter than Synovika's own, on request, by fading the layer rather than
       touching the gradient: the pattern stays exactly theirs, it is just
       about 5% white instead of 9%. */
    opacity: 0.55;
    background-image: repeating-radial-gradient(
      120vw 18.4vw at 78% 8%,
      rgb(255 255 255 / 0.09) 0px,
      rgb(255 255 255 / 0.09) 1px,
      transparent 1px,
      transparent 34px
    );
  }

  /* ---------- narrow screens: the route above, the copy below ---------- */

  @media (width < 64rem) {
    .journey-label {
      max-width: 7rem;
      font-size: 0.8125rem;
    }
    .journey-label-right {
      transform: translate(1.6rem, -50%);
    }
    .journey-label-left {
      transform: translate(calc(-100% - 1.6rem), -50%);
    }
    .journey-label::after {
      width: 0.6rem;
    }
    .journey-label-right::after {
      margin-right: 0.25rem;
    }
    .journey-label-left::after {
      margin-left: 0.25rem;
    }
  }

  /* =====================================================================
     DRIVEN STATE
     Everything above is the finished, static composition. Nothing below runs
     until the script has taken over, and reduced motion opts out entirely.
     ===================================================================== */
  @media (prefers-reduced-motion: no-preference) {
    .hero-journey[data-journey-live] {
      /* THE CAR'S DISTANCE along the route, 0 to 1. (Not `--d`: that name is
         the entrance stagger, and the stage carries `--d:1` inline, which
         would park the car at the end of the road.) Piecewise, so it reaches
         each stop on exactly the frame its report becomes the current one:
         stop one (8% of the route) as the reports arrive at 0.33, then 36%,
         64% and 92% at 0.50, 0.67 and 0.84 — the centres of the three
         advances in the report clock. Between stops it drives at an even
         pace, so it never looks like it is being yanked to a mark. */
      --trip: calc(
        0.08 * clamp(0, var(--p, 0) / 0.33, 1) + 0.28 * clamp(0, (var(--p, 0) - 0.33) / 0.17, 1) +
          0.28 * clamp(0, (var(--p, 0) - 0.5) / 0.17, 1) + 0.28 * clamp(0, (var(--p, 0) - 0.67) / 0.17, 1) +
          0.08 * clamp(0, (var(--p, 0) - 0.84) / 0.08, 1)
      );
      /* THE HAND-OVER TO THE SPIRAL. Over the last stretch of the run the
         whole stage — copy, route, car and the dash field — fades out where
         it stands. The product spiral below starts one screen early, under
         this, and only fades in once this has gone (see ProductSpiral), so
         the page dissolves from one section into the next with nothing
         scrolling past and no two texts on screen at once. */
      --end: clamp(0, (var(--p, 0) - 0.93) * 16.5, 1);
      /* 1 while the car is pulling up at a stop, 0 between them. */
      --brake: clamp(
        0,
        1 -
          min(
            max(calc(var(--trip) - 0.08), calc(0.08 - var(--trip))),
            max(calc(var(--trip) - 0.36), calc(0.36 - var(--trip))),
            max(calc(var(--trip) - 0.64), calc(0.64 - var(--trip))),
            max(calc(var(--trip) - 0.92), calc(0.92 - var(--trip)))
          ) * 26,
        1
      );
    }

    .hero-journey[data-journey-live] :is(.journey-grid, .journey-dashes, .journey-wash) {
      opacity: calc(1 - var(--end));
    }

    /* How much of the route is lit behind the car. */
    .hero-journey[data-journey-live] .journey-trace {
      stroke-dashoffset: calc(1 - var(--trip));
    }

    /* Each marker on the road resolves in as the car arrives, and stays. */
    .hero-journey[data-journey-live] .journey-marker {
      --lit: clamp(0, (var(--trip) - var(--at) + 0.09) * 11, 1);
      --dist: max(calc(var(--trip) - var(--at)), calc(var(--at) - var(--trip)));
      --near: clamp(0, 1 - var(--dist) * 7, 1);
      opacity: var(--lit);
      filter: blur(calc((1 - var(--lit)) * 10px));
      transform: translateY(calc((1 - var(--lit)) * 14px));
    }

    .hero-journey[data-journey-live] .journey-marker circle:nth-child(3) {
      r: calc(4.5px + var(--near) * 3.5px);
    }

    /* THE LABELS FOLLOW THE REPORTS: a relay on the same `--adv` the report
       column reads. A label comes up only once its report is the current
       one, and the distances to two neighbouring reports always add up to
       one, so two labels can never be up together. `--open` holds the first
       back until the car has actually reached its stop. */
    .hero-journey[data-journey-live] .journey-label {
      --open: clamp(0, (var(--p, 0) - 0.33) * 14, 1);
      --dist: max(calc(var(--i) - var(--adv, 0)), calc(var(--adv, 0) - var(--i)));
      --lit: calc(clamp(0, (0.42 - var(--dist)) * 3.33, 1) * var(--open));
      opacity: var(--lit);
      filter: blur(calc((1 - var(--lit)) * 10px));
      /* `translate`, not `transform`: transform stands the label beside the
         line. */
      translate: 0 calc((1 - var(--lit)) * 14px);
      color: var(--color-white);
    }

    /* The car: brake lights as it pulls up, the beam dimming as it stops,
       the halo answering on each arrival, and the body riding on its
       springs the whole time. */
    .hero-journey[data-journey-live] .journey-car {
      animation: journey-car-bob 1.1s ease-in-out infinite alternate;
    }

    @keyframes journey-car-bob {
      from {
        --car-bob: -0.35;
      }
      to {
        --car-bob: 0.55;
      }
    }

    .hero-journey[data-journey-live] .journey-car-brake {
      opacity: calc(0.3 + var(--brake) * 0.7);
      filter: drop-shadow(0 0 calc(var(--brake) * 3px) #ff2d14);
    }

    .hero-journey[data-journey-live] .journey-car-beam {
      opacity: calc(0.6 - var(--brake) * 0.35);
    }

    .hero-journey[data-journey-live] .journey-car-halo circle {
      transform: scale(calc(0.75 + var(--brake) * 0.6));
      fill-opacity: calc(0.1 + var(--brake) * 0.14);
    }

  }

  /* =====================================================================
     THE HAND-OVER
     The opening and the report presentation share one pinned cell. The
     opening fades out completely, and only then does the report fade in:
     at no scroll position are any two of these texts on screen together.
     Both are driven by the scroll position itself, so scrolling back up
     runs it backwards just as smoothly.

     Skipped on a narrow screen that is also very short (a phone on its
     side): there is no room to pin anything, so the two read one after the
     other as a page, with the route above them still driving.
     ===================================================================== */
  @media (prefers-reduced-motion: no-preference) and (width >= 64rem),
    (prefers-reduced-motion: no-preference) and (height >= 34rem) {
    .hero-journey[data-journey-live] .journey-column {
      display: grid;
    }

    .hero-journey[data-journey-live] .journey-column > .journey-panel {
      grid-area: 1 / 1;
    }

    /* The opening: pinned, and out by 13% of the way through. */
    .hero-journey[data-journey-live] .journey-panel:not(.journey-report) {
      position: sticky;
      top: var(--header-h);
      align-self: start;
      height: calc(100svh - var(--header-h));
      min-height: 0;
      display: flex;
      flex-direction: column;
      /* Centred in the screen under the bar. */
      justify-content: center;
      padding-block: 2rem;
      --o: clamp(0, (var(--p, 0) - 0.05) * 12.5, 1);
      opacity: calc(1 - var(--o));
      transform: translateY(calc(var(--o) * -28px));
    }

    /* Gone means gone: its links leave the tab order and stop taking clicks. */
    .hero-journey[data-journey-live] .journey-panel[data-gone] {
      visibility: hidden;
    }

    /* The report: in from 15%, two points after the opening has gone. It has
       nothing to click, and it sits on top of the opening in the stack. */
    .hero-journey[data-journey-live] .journey-report {
      --in: clamp(0, (var(--p, 0) - 0.15) * 12.5, 1);
      min-height: 0;
      height: var(--report-track);
      padding-block: 0;
      justify-content: flex-start;
      opacity: var(--in);
      pointer-events: none;
    }

    .hero-journey[data-journey-live] .journey-report-stage {
      position: sticky;
      top: var(--header-h);
      height: calc(100svh - var(--header-h));
      translate: 0 calc((1 - var(--in)) * 28px);
    }
  }

  /* ---------- narrow screens: route pinned above, copy pinned below ---------- */
  @media (prefers-reduced-motion: no-preference) and (width < 64rem) and (height >= 34rem) {
    .hero-journey[data-journey-live] .journey-column,
    .hero-journey[data-journey-live] .journey-rail {
      grid-area: 1 / 1;
    }

    /* THE ROUTE STANDS BEHIND THE COPY, pinned, set to the right so the line
       runs down the side the copy is lightest on, and under everything else
       in the stack. Two-thirds of the screen tall rather than all of it, so
       all four stops — and the name that comes up beside each — stand above
       the one report the copy is showing at the time. */
    .hero-journey[data-journey-live] .journey-rail {
      position: sticky;
      top: var(--header-h);
      align-self: start;
      height: 66svh;
      justify-content: flex-end;
      padding: 1.25rem 0.25rem 1.25rem 0;
      z-index: 0;
      pointer-events: none;
    }

    /* THE STOPS' NAMES, on a phone too. All on the left of the line — the
       open side, since the line stands to the right — with the tick turned to
       point back at it. They come up one at a time with their reports, as on
       a wide screen. */
    .hero-journey[data-journey-live] .journey-label {
      text-shadow: 0 1px 10px rgb(8 9 11 / 0.95);
    }
    .hero-journey[data-journey-live] .journey-label-right {
      transform: translate(calc(-100% - 1.6rem), -50%);
      text-align: right;
    }
    .hero-journey[data-journey-live] .journey-label-right::after {
      right: auto;
      left: 100%;
      margin-right: 0;
      margin-left: 0.3rem;
    }

    .hero-journey[data-journey-live] .journey-column {
      position: relative;
      z-index: 1;
    }

    /* TEXT ON TOP, ROUTE VISIBLE THROUGH IT. Each pinned block carries a soft
       ground that rises behind its copy only — dark enough under the words
       that they always read, light enough that the route and the car are
       still plainly there behind them — and the type gets a faint shadow of
       the same ground for the moments the car passes right under a line. */
    .hero-journey[data-journey-live] .journey-panel:not(.journey-report),
    .hero-journey[data-journey-live] .journey-report-stage {
      padding-block: 1.5rem;
      text-shadow: 0 1px 14px rgb(8 9 11 / 0.95);
    }

    .hero-journey[data-journey-live] .journey-panel:not(.journey-report) {
      justify-content: center;
    }

    /* The opening's copy sits in the middle of the screen, so its ground is
       a band through the middle, fading out above and below it — the car at
       the top of its road stays in the clear. */
    .hero-journey[data-journey-live] .journey-panel:not(.journey-report)::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background: linear-gradient(
        to bottom,
        transparent 6%,
        rgb(8 9 11 / 0.55) 20%,
        rgb(8 9 11 / 0.78) 34%,
        rgb(8 9 11 / 0.78) 74%,
        rgb(8 9 11 / 0.55) 88%,
        transparent 100%
      );
    }

    /* A single report is short, so its ground is too: only as high as the
       report, which leaves the stops and their names above it in the clear. */
    .hero-journey[data-journey-live] .journey-report-stage::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background: linear-gradient(
        to top,
        rgb(8 9 11 / 0.88) 0%,
        rgb(8 9 11 / 0.74) 18%,
        rgb(8 9 11 / 0.3) 26%,
        transparent 32%
      );
    }

    /* The heading before the reports is taller, and carries its own ground,
       which fades out with it. */
    .hero-journey[data-journey-live] .journey-report-head {
      position: relative;
    }
    .hero-journey[data-journey-live] .journey-report-head::before {
      content: '';
      position: absolute;
      inset: -2.5rem -1.25rem -1.5rem;
      z-index: -1;
      pointer-events: none;
      background: linear-gradient(
        to top,
        rgb(8 9 11 / 0.82) 0%,
        rgb(8 9 11 / 0.7) 65%,
        transparent 100%
      );
    }

    .hero-journey[data-journey-live] .journey-report-stage {
      display: grid;
      align-content: end;
    }

    /* On a phone the heading and the reports cannot share the space under
       the route, so they take turns as well: the heading, then one report at
       a time. Same rule as everywhere else here — each one is out before the
       next is in. */
    .hero-journey[data-journey-live] .journey-report-head,
    .hero-journey[data-journey-live] .journey-window {
      grid-area: 1 / 1;
      align-self: end;
    }

    .hero-journey[data-journey-live] .journey-report-head {
      opacity: calc(1 - clamp(0, (var(--p, 0) - 0.3) * 25, 1));
    }

    .hero-journey[data-journey-live] .journey-window {
      opacity: clamp(0, (var(--p, 0) - 0.345) * 25, 1);
    }

    .hero-journey[data-journey-live] .journey-strip {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-journey[data-journey-live] .journey-row {
      grid-area: 1 / 1;
      align-self: end;
      --dist: max(calc(var(--i) - var(--adv, 0)), calc(var(--adv, 0) - var(--i)));
      --lit: clamp(0, (0.42 - var(--dist)) * 3.33, 1);
      opacity: var(--lit);
      translate: 0 calc((1 - var(--lit)) * 14px);
    }

    .hero-journey[data-journey-live] .journey-row-refrain {
      font-size: 1.375rem;
    }

    .hero-journey[data-journey-live] .journey-row-body {
      font-size: 0.9375rem;
    }

    /* The phone's labels: the stop names, one at a time, as above. */
    .hero-journey[data-journey-live] .journey-label {
      --open: clamp(0, (var(--p, 0) - 0.345) * 14, 1);
    }
  }
</style>

<script>
  /**
   * Drives the journey.
   *
   * Writes one custom property, `--p`, the section's scroll progress from 0 to
   * 1. Every visual consequence of that number lives in CSS: where the vehicle
   * sits on the route, how much of the route is lit, which stops have been
   * reached and which one is being passed. Nothing here knows about any of it.
   *
   * Reads are batched into a requestAnimationFrame so a scroll burst costs at
   * most one layout read per frame, and the whole thing exits early when the
   * section is off screen.
   *
   * `data-journey-live` is only set once this runs, and the CSS that hides
   * unreached stops is scoped to that attribute. If this script never executes,
   * the section renders complete and static rather than blank.
   */
  function initJourney(root: HTMLElement) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    let frame = 0;
    let live = false;
    const opening = root.querySelector<HTMLElement>('.journey-panel:not(.journey-report)');

    const update = () => {
      frame = 0;
      if (!live) return;

      const rect = root.getBoundingClientRect();
      const vh = window.innerHeight;

      /* Off screen: leave the last value alone rather than writing every frame. */
      if (rect.bottom < 0 || rect.top > vh) return;

      /* Progress across the section, measured from the moment its top reaches
         the top of the viewport to the moment its bottom does. That is exactly
         the stretch where the rail is pinned, so the drive lines up with what
         the reader sees rather than starting before the section arrives. */
      const travel = rect.height - vh;
      const p = travel > 0 ? Math.min(1, Math.max(0, -rect.top / travel)) : 0;

      root.style.setProperty('--p', p.toFixed(4));
      /* The opening has faded out by 0.13: its two links leave the tab order
         and stop taking clicks once it is gone. */
      opening?.toggleAttribute('data-gone', p > 0.135);
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    const apply = () => {
      live = !still.matches;
      root.toggleAttribute('data-journey-live', live);

      if (live) {
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        update();
      } else {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
        root.style.removeProperty('--p');
        opening?.removeAttribute('data-gone');
      }
    };

    still.addEventListener('change', apply);
    apply();
  }

  document.querySelectorAll<HTMLElement>('.hero-journey').forEach((el) => initJourney(el));
</script>

