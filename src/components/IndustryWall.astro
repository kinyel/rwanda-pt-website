---
/**
 * The industry wall: the eight verticals, directly under the hero.
 *
 * THE IDEA. Not eight cards, one wall. The tiles share a single bordered panel
 * and are separated by hairlines rather than by gaps, so the block reads as one
 * object with eight compartments instead of eight things that happen to be near
 * each other. A wall of separate cards on a white page is mostly the white
 * page; this is a surface.
 *
 * The earlier version staggered alternate columns down by 2.25rem to avoid
 * looking like a table. It did avoid that, but it also made the section
 * restless and gave every tile a different baseline to read from. The lattice
 * gets the same "not a list" quality out of construction rather than out of
 * displacement, and it holds still.
 *
 * The attention is in one move, not several: the compartment under the pointer
 * lights, an orange rule draws across the top of it in the direction of travel,
 * and its icon fills. Nothing lifts, because a tile lifting out of a lattice
 * breaks the very lines that make it a lattice. Nothing bounces, nothing spins,
 * and nothing hijacks the scroll. The page already has two pinned sections; a
 * third would be exhausting.
 *
 * Entrance is a stagger by column, so the wall lights up left to right as it
 * arrives. It fades only. Anything that MOVES on entrance would slide out from
 * under the panel's clip and show the hairline colour behind it.
 *
 * Every tile is a real link to its industry page, so this section carries eight
 * internal links to sector pages rather than being decorative.
 */
import Icon from './Icon.astro';
import { industries, industryPath } from '../data/industries';
import { useTranslations, localizePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const t = useTranslations(locale);
const items = t.industries.items as Record<string, { name: string; summary: string }>;
---

<ul class="industry-wall">
  {
    industries.map((industry, i) => {
      const copy = items[industry.key];
      return (
        <li class="industry-cell" style={`--n:${i % 4}`}>
          <a href={localizePath(industryPath(industry.slug), locale)} class="industry-tile">
            <span class="industry-rule" aria-hidden="true" />
            <span class="industry-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>

            <span class="industry-icon" aria-hidden="true">
              <Icon name={industry.icon} size={18} />
            </span>

            <span class="industry-name">{copy.name}</span>
            <span class="industry-summary">{copy.summary}</span>

            <span class="industry-go" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  /* The lattice. `gap: 1px` over a hairline-coloured panel is what draws the
     dividers: every cell paints white on top, and the 1px the grid leaves
     between them is the only place the panel shows through. One declaration
     instead of eight borders that would double up wherever two tiles meet. */
  .industry-wall {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background-color: var(--color-ink-100);
    border: 1px solid var(--color-ink-100);
    border-radius: var(--radius-panel);
    /* `clip`, never `hidden`. `hidden` would make this a scroll container, and
       the tiles' entrance is timed against the nearest scrollport. */
    overflow: clip;
  }

  @media (width >= 40rem) {
    .industry-wall { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (width >= 64rem) {
    .industry-wall { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .industry-cell {
    display: flex;
  }

  .industry-tile {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.75rem 1.5rem 1.5rem;
    background-color: var(--color-white);
    transition: background-color var(--duration-base) var(--ease-prime);
  }

  .industry-tile:hover,
  .industry-tile:focus-visible {
    background-color: var(--color-prime-50);
  }

  /* The focus ring is drawn inside, because the panel clips anything outside. */
  .industry-tile:focus-visible {
    outline-offset: -3px;
  }

  /* The one move: a rule that draws across the top, in the direction of travel. */
  .industry-rule {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 2px;
    background-image: linear-gradient(90deg, var(--color-prime-500), var(--color-amber-500));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-slow) var(--ease-prime);
  }
  .industry-tile:hover .industry-rule,
  .industry-tile:focus-visible .industry-rule {
    transform: scaleX(1);
  }

  /* Ghosted numeral, behind everything. */
  .industry-index {
    position: absolute;
    top: 0.5rem;
    right: 0.9rem;
    font-size: 3.25rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-ink-50);
    transition: color var(--duration-base) var(--ease-prime);
  }
  .industry-tile:hover .industry-index,
  .industry-tile:focus-visible .industry-index {
    color: var(--color-prime-100);
  }

  .industry-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.375rem;
    height: 2.375rem;
    border-radius: 0.55rem;
    background-color: var(--color-prime-50);
    border: 1px solid rgb(243 93 1 / 0.16);
    color: var(--color-prime-700);
    transition:
      background-color var(--duration-base) var(--ease-prime),
      border-color var(--duration-base) var(--ease-prime),
      color var(--duration-base) var(--ease-prime);
  }
  .industry-tile:hover .industry-icon,
  .industry-tile:focus-visible .industry-icon {
    background-color: var(--color-prime-500);
    border-color: var(--color-prime-500);
    color: var(--color-white);
  }

  .industry-name {
    position: relative;
    margin-top: 1.1rem;
    font-size: var(--text-h4);
    font-weight: 700;
    color: var(--color-ink-950);
    text-wrap: balance;
  }

  .industry-summary {
    position: relative;
    margin-top: 0.55rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-600);
  }

  .industry-go {
    position: relative;
    display: inline-flex;
    align-items: center;
    margin-top: auto;
    padding-top: 1.1rem;
    color: var(--color-prime-700);
    transition: transform var(--duration-base) var(--ease-prime);
  }
  @media (prefers-reduced-motion: no-preference) {
    .industry-tile:hover .industry-go,
    .industry-tile:focus-visible .industry-go {
      transform: translateX(4px);
    }
  }

  /* Entrance. Opacity only: see the note at the top of this file. The shared
     `.reveal-soft` cannot be used because it also translates. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .industry-tile {
        animation: industry-tile-in linear both;
        animation-timeline: view();
        animation-range: entry 2% cover calc(22% + var(--n, 0) * 5%);
      }
      @keyframes industry-tile-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }
    }
  }
</style>
