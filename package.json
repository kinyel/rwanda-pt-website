{
  "name": "primetrack-rwanda",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "PrimeTrack Telematics Rwanda — vehicle tracking and fleet management website",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:content && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:content": "node scripts/check-content.mjs",
    "images:placeholders": "node scripts/generate-placeholders.mjs",
    "images:readme": "node scripts/images-readme.mjs",
    "i18n:status": "node scripts/translation-status.mjs",
    "qa": "node scripts/qa-report.mjs",
    "verify": "npm run build && npm run i18n:status && npm run qa"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
